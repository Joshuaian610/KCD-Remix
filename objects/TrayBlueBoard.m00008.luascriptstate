be, v, total = nil, nil, nil\nif mv ~= 0 or need > 0 then\ncube, v, total = NF.moveCube()\nif not cube then NF.say(why .. \"no movement cube found - nothing happens\", false) return \"short\" end\nif total < need then\nNF.say(why .. need .. \" movement needed, \" .. total .. \" left - nothing happens\", false)\nreturn \"short\"\nend\nend\nlocal said = {}\nif mv ~= 0 then\nlocal nv = math.max(0, v + mv)\nlocal ok = pcall(function() cube.call(\"setValue\", {value = nv, announce = false}) end)\nsaid[#said + 1] = ok and (\"Movement \" .. total .. \" → \" .. (total - v + nv)) or (\"Movement \" .. mv .. \" (set it by hand)\")\nend\nlocal dirt = math.floor(tonumber(p.dirtChar or 0) or 0)\nif dirt > 0 then\nlocal put = 0\nfor _ = 1, dirt do if NF.dirtOnChar(board) then put = put + 1 end end\nsaid[#said + 1] = \"Dirt +\" .. dirt .. \" (character card\" .. (put < dirt and \": put it on by hand\" or \"\") .. \")\"\nend\nfor _, e in ipairs({{\"good\", \"Good Cards\", \"Good card\"}, {\"bad\", \"Bad Cards\", \"Bad card\"}}) do\nfor _ = 1, math.floor(tonumber(p[e[1]] or 0) or 0) do\nsaid[#said + 1] = e[3] .. \" → discard pile\" .. (NF.topToDiscard(e[2]) and \"\" or \" (no \" .. e[2] .. \" deck: by hand)\")\nend\nend\nlocal xp = type(p.xp) == \"table\" and p.xp or {}\nfor _, s in ipairs({\"Strength\", \"Perception\", \"Dexterity\", \"Speech\", \"Universal\"}) do\nlocal n = math.floor(tonumber(xp[s] or 0) or 0)\nif n > 0 then\nNF.xpGain(s, n)                            -- (each XP cube says its own \"Perception 2 → 3\")\nsaid[#said + 1] = s .. \" +\" .. n\nend\nend\nif #said > 0 then NF.say(why .. table.concat(said, \", \")) end\nreturn \"ok\"\nend\nfunction encItem(p)\nif CFG.name ~= \"BOARD\" then return \"not the board\" end\np = type(p) == \"table\" and p or {}\nlocal card = getObjectFromGUID(p.guid or \"\")\nif not card then return \"no card\" end\nlocal color, spots = p.color, type(p.spots) == \"table\" and p.spots or {}\nlocal why = (type(p.why) == \"string\" and p.why ~= \"