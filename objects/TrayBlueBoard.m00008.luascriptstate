the laid out ones)\nend\nfunction NF.potionsHide()\nlocal o = NF.potBoard()\nNF.potGuid = nil\nNF.potTick = NF.potTick + 1                    -- (its watch ends)\nif o then o.destruct() end\nend\nfunction NF.potionsAll()\nlocal o = NF.potBoard()\nif not o then return end\nNF.potAll = not NF.potAll\nNF.potDress(o)\nend\nfunction NF.potionsToggle()\nif NF.potBoard() then NF.potionsHide() else NF.potionsShow() end\nend\nfunction NF.potionsRestore()\nlocal keep = NF.potBoard()\nfor _, o in ipairs(getObjects()) do\nif NF.isPotBoard(o) and not (keep and o.getGUID() == keep.getGUID()) then\nif keep then o.destruct() else keep = o end\nend\nend\nNF.potGuid = keep and keep.getGUID() or nil\nif keep then NF.potDress(keep) NF.potWatch() end\nend\nfunction NF.potionsFollow()\nlocal o = NF.potBoard()\nif not o then return end\nlocal pos, yaw = NF.potSpot()\no.setPosition(pos)\no.setRotation({0, yaw, 0})\nend\nfunction nfPotions() NF.potionsToggle() end\nfunction nfPotionsBoard() NF.potionsHide() end\nfunction nfPotionsAll() NF.potionsAll() end\nfunction nfPotionsClose() pcall(function() Global.UI.setAttribute(\"kcdPotions\", \"active\", \"false\") end) end\nNF.TEST_X, NF.TEST_Z0, NF.TEST_Z1 = 2.9, 1.0, 17.0\nNF.TUCK = {x0 = -2.94, x1 = 2.97, z0 = -1.93, z1 = 5.67, ymax = 0.35}\nfunction NF.onModule(m, o)\nlocal w, d = dims(m)\nlocal q = m.positionToLocal(o.getPosition())\nreturn math.abs(q.x) < w * U / 2 and math.abs(q.z) < d * U / 2 and q.y > -0.5 and q.y < 6\nend\nfunction NF.inHand(o)\nlocal ok, z = pcall(function() return o.getZones() end)\nif ok and z then\nfor _, zz in ipairs(z) do if zz.type == \"Hand\" then return true end end\nend\nreturn false\nend\nfunction NF.tellTucked(fn, text)\nlocal tc = nil\npcall(function() tc = NF.tuckedCard() end)\nif tc and tc.type == \"Card\" and tc.hasTag(\"CardFrames\") then\npcall(function() tc.call(fn, {text = tostring(text or \"\"), seat = CFG.seat}) end)\nend\nend\nfunction nfDrawHand(p)\nlocal n = math.floor(tonumber(type(p) == \"table\" and p.n or 1) or 1)\nlocal color = (type(p) == \"table\" and type(p.color) == \"string\" and p.color ~= \"\") and p.color or CFG.seat\nfor _ = 1, math.max(0, math.min(10, n)) do NF.drawOne(color) end\nreturn true\nend\nfunction nfReadBook(p)\nlocal color = (type(p) == \"table\" and type(p.color) == \"string\" and p.color ~= \"\") and p.color or CFG.seat\nlocal board = NF.invBoard()\nlocal ks = {}\nif board then\nfor k, g in pairs((NF.INV and NF.INV.cube) or {}) do\nlocal card = getObjectFromGUID(g or \"\")\nlocal spec = card and NF.CUBES[card.getName()] or nil\nif spec and spec.book and #NF.cubesOn(card, board) > 0 then ks[#ks + 1] = k end\nend\nend\nif type(p) == \"table\" and p.count then return #ks end\nif #ks == 0 then return \"none\" end\nif #ks > 1 then return \"choose\" end\nlocal k1 = ks[1]\nWait.frames(function() NF.cubeAct(k1, \"use\", color) end, 1)\nreturn \"read\"\nend\nfunction NF.tuckedCard()\nlocal b = NF.module(\"BOARD\")\nif not b then return nil end\nlocal t = NF.anchor(\"tuck_slide_target\", b ~= self and \"BOARD\" or nil) or {x = -4.265, z = -7.01}\nlocal best, by = nil, nil\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Card\" and not isHeld(o) then\nlocal q = b.positionToLocal(o.getPosition())\nlocal dx, dz = q.x - t.x, q.z - t.z\nif dx > NF.TUCK.x0 and dx < NF.TUCK.x1 and dz > NF.TUCK.z0 and dz < NF.TUCK.z1 and q.y < NF.TUCK.ymax and q.y > -0.6\nand (not by or q.y < by) then best, by = o, q.y end\nend\nend\nreturn best, b\nend\nfunction NF.testCards()\nlocal f = NF.anchor(\"snap_black_focus_tile\") or {x = 0.2877, z = -1.692}\nlocal tucked = NF.tuckedCard()\nlocal skip = {}\nfor _, n in ipairs({\"DECK\", \"DISCARD\"}) do\nfor _, o in ipairs(seatModules()) do\nif NF.modName(o):match(\"^\" .. n) then skip[#skip + 1] = o end\nend\nend\nlocal list = {}\nfor _, o in ipairs(getObjects()) do\nif NF.isPile(o) and o ~= tucked then\nlocal q = self.positionToLocal(o.getPosition())\nlocal below = f.z - q.z\nif math.abs(q.x - f.x) < NF.TEST_X and below > NF.TEST_Z0 and below < NF.TEST_Z1 and q.y > -1 and q.y < 4 then\nlocal ok = not NF.inHand(o)\nfor _, m in ipairs(skip) do if ok and NF.onModule(m, o) then ok = false end end\nif ok then list[#list + 1] = o end\nend\nend\nend\nreturn list\nend\nfunction NF.toDiscard(cards, first)\nlocal m, a = NF.discardSpot()\nif not m then return false end\nlocal yaw = NF.cardYaw(m)\nfor i, o in ipairs(cards) do\no.setPositionSmooth(m.positionToWorld({a.x, NF.top() + 1.0 + 0.25 * ((first or 0) + i), a.z}), false, true)\no.setRotationSmooth({0, yaw, 0}, false, true)\nend\nreturn true\nend\nfunction NF.discardTest(color)\nlocal cards = NF.testCards()\nif #cards == 0 then NF.tell(color, \"No test cards under \" .. CFG.seat .. \"'s focus tile.\") return end\ntable.sort(cards, function(a, b) return self.positionToLocal(a.getPosition()).z > self.positionToLocal(b.getPosition()).z end)\nlocal rest = {}\nfor _, o in ipairs(cards) do\nlocal took = false\nif o.type == \"Card\" and o.hasTag(\"CardFrames\") then\npcall(function() took = o.call(\"cfTestDiscard\", {}) == true end)\nend\nif not took then rest[#rest + 1] = o end\nend\nif #rest == 0 then return end\nlocal n = 0\nfor _, o in ipairs(rest) do n = n + NF.count(o) end\nif not NF.toDiscard(rest) then NF.tell(color, \"No DISCARD module on \" .. CFG.seat .. \"'s tray.\") return end\nNF.say(\"discarded \" .. n .. \" test card\" .. (n == 1 and \"\" or \"s\"))\nend\nfunction NF.discardAction(color)\nlocal card, b = NF.tuckedCard()\nif not card then NF.tell(color, \"No main action card tucked under \" .. CFG.seat .. \"'s board.\") return end\nlocal snap = NF.dirtSnapshot()\ncard.sticky = false\nlocal q = b.positionToLocal(card.getPosition())\ncard.setPositionSmooth(b.positionToWorld({q.x, q.y, q.z - 6.5}), false, true)\nWait.time(function()\nif card.isDestroyed() then return end\nNF.toDiscard({card})\nWait.time(function() if not card.isDestroyed() then card.sticky = true end NF.dirtRestore(snap) end, 1.2)\nend, 0.6)\nNF.say(\"discarded the main action card\")\nend\nfunction nfDiscardTest(_, color) NF.discardTest(color) end\nfunction nfDiscardAction(_, color) NF.discardAction(color) end\nNF.unstuck = {}                                 -- card guid -> true (made non-sticky by us; sticky again when it leaves)\nNF.watch = nil                                  -- {card = guid, snap = {...}} while a tucked card is in the air\nfunction NF.dirtSpot()\nlocal board = NF.playerBoard(CFG.seat)\nif not board then return nil end\nlocal dl = NF.dirtLocal()\nreturn board.positionToWorld(dl), board\nend\nfunction NF.dirtSnapshot()\nlocal w, board = NF.dirtSpot()\nif not w then return nil end\nlocal list = {}\nfor _, o in ipairs(getObjectsWithTag(\"DirtToken\")) do\nlocal p = o.getPosition()\nif NF.flat2(p, w) < 1.44 then list[#list + 1] = {g = o.getGUID(), p = {x = p.x, y = p.y, z = p.z}} end\nend\nreturn {w = w, list = list, yaw = board.getRotation().y, board = board.getGUID()}\nend\nfunction NF.dirtRestore(snap)\nif not snap or #snap.list == 0 then return 0 end\nlocal board = getObjectFromGUID(snap.board)\nif not board then return 0 end\nlocal dl = NF.dirtLocal()\nlocal stay = NF.dirtCount(board)\nlocal back = 0\nfor _, e in ipairs(snap.list) do\nlocal o = getObjectFromGUID(e.g)\nif o and not isHeld(o) then\nlocal p = o.getPosition()\nif NF.flat2(p, snap.w) > 0.81 or p.y > e.p.y + 0.8 then\nlocal at = board.positionToWorld({dl[1], NF.DIRT_REST_Y + 0.05 + 0.085 * (stay + back), dl[3]})\no.setVelocity({0, 0, 0})\no.setPosition({at.x, at.y + 0.05, at.z})\no.setRotation({0, snap.yaw, 0})\nback = back + 1\nend\nend\nend\nif back > 0 then NF.say(back .. \" dirt back on the dirt spot\") end\nreturn back\nend\nfunction NF.isTucked(o)\nif o.type ~= \"Card\" and o.type ~= \"Deck\" then return false end\nlocal b = NF.module(\"BOARD\")\nif not b then return false end\nlocal t = NF.anchor(\"tuck_slide_target\", b ~= self and \"BOARD\" or nil) or {x = -4.265, z = -7.01}\nlocal q = b.positionToLocal(o.getPosition())\nlocal dx, dz = q.x - t.x, q.z - t.z\nreturn dx > NF.TUCK.x0 and dx < NF.TUCK.x1 and dz > NF.TUCK.z0 and dz < NF.TUCK.z1 and q.y < NF.TUCK.ymax + 0.6\nend\nfunction NF.scanTuck()\nfor _, o in ipairs(getObjects()) do\nif not isHeld(o) and NF.isTucked(o) and o.sticky ~= false then\no.sticky = false\nNF.unstuck[o.getGUID()] = true\nend\nend\nend\nfunction NF.boardPickUp(color, obj)\nif obj.type ~= \"Card\" and obj.type ~= \"Deck\" then return end\nlocal g = obj.getGUID()\nif not (NF.unstuck[g] or NF.isTucked(obj)) then return end\nobj.sticky = false\nlocal snap = NF.dirtSnapshot()\nNF.watch = {card = g, snap = snap}\nfor _, t in ipairs({0.4, 1.0, 2.0}) do\nWait.time(function() if NF.watch and NF.watch.card == g then NF.dirtRestore(snap) end end, t)\nend\nend\nfunction NF.boardDrop(color, obj)\nif obj.type ~= \"Card\" and obj.type ~= \"Deck\" then return end\nlocal g = obj.getGUID()\nif NF.watch and NF.watch.card == g then\nlocal snap = NF.watch.snap\nNF.watch = nil\nWait.time(function() NF.dirtRestore(snap) end, 0.6)\nend\nlocal function check()\nif NF.dead or obj.isDestroyed() or isHeld(obj) then return end\nif NF.isTucked(obj) then\nif obj.sticky ~= false then obj.sticky = false NF.unstuck[g] = true end\nelseif NF.unstuck[g] then\nobj.sticky = true\nNF.unstuck[g] = nil\nend\nend\nWait.time(check, 1.0)\nWait.time(check, 2.5)\nend\nFEATURES[#FEATURES + 1] = {\nonLoad = function()\nif CFG.name == \"BOARD\" then Wait.time(NF.scanTuck, 2) end\nif CFG.name == \"BOARD\" and not IS_COPY then Wait.time(NF.invTick, 3) end   -- (inventory buttons on hover)\nif CFG.name == \"QUESTS\" then Wait.time(NF.questButtons, 1.5) end\nif CFG.name == \"POTIONS\" then NF.potionsRestore() end\nif CFG.name == \"HISTORY\" then Wait.time(NF.histSetup, 1) end\nif CFG.name == NF.HIST_KEEPER then Wait.time(NF.histKeeperSetup, 2) end\nif CFG.name == \"ACTIONS\" and not IS_COPY then Wait.time(NF.actTick, 1.5, -1) end   -- (doable: colour, else grey)\nend,\nonButtons = function()\nlocal n = CFG.name\nif n == \"BOARD\" then NF.INV.sortN = 0 end     -- (a menu redraw: the SORT button is looked after on the next tick)\nif n == \"ACTIONS\" then NF.actButtons() end\nif n == \"GROSCHEN\" then\nlocal P = NF.SIZE.plate\nfor _, e in ipairs({{\"minus1\", \"nfMinus1\", \"-1 Groschen (change from the bowls if needed)\"},\n{\"plus1\", \"nfPlus1\", \"+1 Groschen from the bowls\"},\n{\"minus5\", \"nfMinus5\", \"-5 Groschen (change from the bowls if needed)\"},\n{\"plus5\", \"nfPlus5\", \"+5 Groschen from the bowls\"},\n{\"minus20\", \"nfMinus20\", \"-20 Groschen (change from the bowls if needed)\"},\n{\"plus20\", \"nfPlus20\", \"+20 Groschen from the bowls\"}}) do\nlocal a = NF.anchor(e[1])\nif a then NF.plate(e[2], a, P[1] - 0.04, P[2] - 0.04, e[3]) end\nend\nelseif n == \"DECK\" then\nlocal a = NF.anchor(\"draw\")\nif a then NF.plate(\"nfDraw\", a, NF.SIZE.draw[1], NF.SIZE.draw[2],\n\"Draw 1 card into \" .. CFG.seat .. \"'s hand (an empty deck: the discard pile is shuffled in first)\") end\nelseif n == \"DISCARD\" then\nlocal a = NF.anchor(\"shuffle\")\nif a then NF.plate(\"nfShuffle\", a, NF.SIZE.shuffle[1], NF.SIZE.shuffle[2],\n\"Shuffle the discard pile back into the deck\") end\nelseif n == \"QUESTS\" then\nlocal a = NF.anchor(\"draw2\")\nif a then NF.solid(\"nfQuestsDraw\", \"Draw 2\", a.x, NF.btnY(a), a.z, NF.SIZE.draw2[1], NF.SIZE.draw2[2],\n\"Two quests from the quest deck face down into \" .. CFG.seat .. \"'s hand (turn them over once your turn is over; keep one in a quest slot, discard the other)\", 150) end\nfor i, s in ipairs(NF.questSlots()) do\nif s then\nNF.solid(\"nfQuestDiscard\" .. i, \"\", s.x, NF.btnY(s) + 0.25, s.z - NF.SIZE.slot[2] / 2 + 0.6,\n0, 0, \"Discard this quest: face down onto the quest discard\", 140)\nend\nend\nWait.time(NF.questButtons, 0.5)\nelseif n == \"SUPPLIES\" then\nfor _, k in ipairs({\"meat\", \"mushroom\", \"dirt\"}) do\nlocal a = NF.anchor(k)\nlocal dia = NF.SIZE[k] - 0.1\nif a then NF.plate(\"nf\" .. k:sub(1, 1):upper() .. k:sub(2), a, dia, dia,\nk == \"dirt\" and \"+1 dirt onto \" .. CFG.seat .. \"'s dirt spot\"\nor (\"+1 \" .. k .. \" into \" .. CFG.seat .. \"'s next free inventory slot\")) end\nend\nelseif n == \"DAMAGE\" or n == \"GUARDS\" then    -- (user, 2026-11-04) one token onto the module per click\nlocal a = NF.anchor(\"token\")\nif a then NF.plate(\"nfOnto\", a, NF.SIZE.token, NF.SIZE.token,\n\"+1 \" .. NF.ONTO[n].what .. \" onto this module (from \" .. NF.ONTO[n].bowl .. \")\") end\nelseif n == \"FLOWERS\" then                    -- (user, 2026-11-04) one flower of that colour into the inventory\nfor _, k in ipairs({\"white\", \"yellow\", \"orange\", \"red\", \"blue\"}) do\nlocal a = NF.anchor(k)\nif a then NF.plate(\"nfFlower\" .. k:sub(1, 1):upper() .. k:sub(2), a, NF.SIZE.flower, NF.SIZE.flower,\n\"+1 \" .. k .. \" flower into \" .. CFG.seat .. \"'s next free inventory slot (right click: face down, the potion side)\") end\nend\nelseif n == \"HENRY\" then                     -- (his day cards: the predawn deals them, nfHenryDay; user, 2026-11-02)\nlocal a = NF.anchor(\"next\")                -- Next: a tall button, \"Next\" upright for the player\nif a then                                  -- (owner 11-13: a painted plate, NEXT written top to bottom)\nlocal aa = {x = a.x, y = (a.y or TOP) + (NF.HENRY_LIFT or 0), z = a.z}\nlocal tip = \"Henry's current card onto his discard pile; his next day card face up as the current one, his figure to its space\"\nif NF.endpSet(\"endp_next\", NF.ENDP_URL.next, aa, 0.97, 2.0) then NF.plate(\"nfHenryNext\", aa, 0.97, 2.0, tip)\nelse NF.solid(\"nfHenryNext\", \"Next\", a.x, NF.btnY(a) + NF.HENRY_LIFT, a.z, 0.97, 2.0, tip, 120) end\nend\nlocal f, b = NF.anchor(\"sheet_front\"), NF.anchor(\"sheet_back\")   -- (user, 2026-11-04) one button, both sides\nif f and b then\nlocal sa = {x = (f.x + b.x) / 2, y = f.y, z = (f.z + b.z) / 2}   -- (owner 11-13: a painted plate)\nlocal stip = \"Henry's Reference Sheet: both pages (Solo Overview, Henry's Actions) side by side over this module; click a page, or here again, to put them away\"\nif NF.endpSet(\"endp_ref\", NF.ENDP_URL.ref, sa, 6.6, 0.75) then NF.plate(\"nfHenrySheet\", sa, 6.6, 0.75, stip)\nelse NF.solid(\"nfHenrySheet\", \"REFERENCE SHEET\", (f.x + b.x) / 2, NF.btnY(f), (f.z + b.z) / 2, 6.6, 0.75, stip, 105) end\nend\nelseif n == \"POTIONS\" then                   -- (NAVIGATION: out with the navigation, user 2026-11-05)\nlocal a = NF.anchor(\"button\")\nif a then NF.plate(\"nfPotions\", a, NF.SIZE.potions[1], NF.SIZE.potions[2],\n\"All potions at a glance: a board over your tray (click it, or here again, to put it away)\") end\nelseif n == \"MEETING\" then\nlocal y = NF.top() + 0.02\nend\nend,\nonPlayerTurn = function(player)                -- (a new turn: the next healing is its first)\nNF.healedTurn = false\nif CFG.name == NF.HIST_KEEPER and player and player.color == CFG.seat and NF.histOn() then\nNF.HIST.turn = NF.HIST.turn + 1\nhistoryAdd({kind = \"turn\", t = \"turn\"})\nend\nend,\nonObjectLeaveContainer = function(container, obj)   -- (a card out of a deck or bag starts fresh: it gets its cubes again)\nif CFG.name == \"BOARD\" and obj and obj.hasTag(\"CubesGiven\") then obj.removeTag(\"CubesGiven\") end\nend,\nonObjectDrop = function(color, obj)\nif CFG.name == \"BOARD\" then pcall(NF.cubeDrop, obj) pcall(NF.woundDrop, obj) end\nif CFG.name == NF.HIST_KEEPER and NF.histOn() then pcall(NF.histFigureDrop, obj) end\nif CFG.name == \"BOARD\" then NF.boardDrop(color, obj)\nelseif CFG.name == \"QUESTS\" and (obj.type == \"Card\" or obj.type == \"Deck\") then Wait.time(NF.questButtons, 0.8) end\nend,\nonObjectPickUp = function(color, obj)\nif CFG.name == NF.HIST_KEEPER and NF.histOn() then pcall(NF.histFigurePickUp, obj) end\nif CFG.name == \"BOARD\" and obj.hasTag(\"Equipped\") then    -- (an equipped card taken out of its box: unequipped)\nlocal board = NF.invBoard()\nif board and NF.invInside(board, obj.getPosition()) then\nobj.removeTag(\"Equipped\")\nNF.say(\"unequipped \" .. obj.getName())\nNF.INV.sig = \"\"\nend\nend\nif CFG.name == \"BOARD\" then NF.boardPickUp(color, obj)\nelseif CFG.name == \"QUESTS\" and (obj.type == \"Card\" or obj.type == \"Deck\") then Wait.time(NF.questButtons, 0.3) end\nend,\nonMoved = function()\nif CFG.name == \"QUESTS\" then Wait.time(NF.questButtons, 1.0) end\nif CFG.name == \"POTIONS\" then NF.potionsFollow() end\nend,\nonDestroy = function()\nNF.dead = true                                -- (only one-shot timers here: their callbacks check this)\nNF.queue = {}\nif CFG.name == \"POTIONS\" then pcall(NF.potionsHide) end\nif CFG.name == \"HENRY\" then                  -- (the two sheets go with the module)\npcall(NF.henrySheetsAway)\nend\nend,\nonSave = function()\nif CFG.name == \"POTIONS\" then return {potBoard = NF.potGuid} end\nif CFG.name == \"HENRY\" then return {hsGuid = NF.hsGuid, hsGuid2 = NF.hsGuid2, hsSide = NF.hsSide} end\nif CFG.name == \"HISTORY\" then return {histBig = NF.HIST.big} end\nif CFG.name ~= \"BOARD\" then return nil end\nlocal t = {}\nfor g in pairs(NF.unstuck) do t[#t + 1] = g end\nreturn {unstuck = t, hist = NF.HIST.lines, histTurn = NF.HIST.turn, histSpace = NF.HIST.space, histSnaps = NF.HIST.snaps,\nhistSeqs = NF.HIST.seqs, histBase = NF.HIST.base}\nend,\nonRestore = function(s)\nif type(s) ~= \"table\" then return end\nif s.unstuck then\nfor _, g in ipairs(s.unstuck) do NF.unstuck[g] = true end\nend\nif CFG.name == \"POTIONS\" and type(s.potBoard) == \"string\" then NF.potGuid = s.potBoard end\nif CFG.name == \"HENRY\" and type(s.hsGuid) == \"string\" then NF.hsGuid, NF.hsSide = s.hsGuid, s.hsSide end\nif CFG.name == \"HENRY\" and type(s.hsGuid2) == \"string\" then NF.hsGuid2 = s.hsGuid2 end\nif CFG.name == NF.HIST_KEEPER and type(s.hist) == \"table\" then\nNF.HIST.lines, NF.HIST.space = s.hist, s.histSpace\nNF.HIST.turn = (type(s.histTurn) == \"number\") and s.histTurn or 0\nNF.HIST.snaps = (type(s.histSnaps) == \"table\") and s.histSnaps or {}\nNF.HIST.s