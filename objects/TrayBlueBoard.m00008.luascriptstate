= pcall(function()\nlocal plan = NF.invPlan(board)\nNF.invRun(plan)\nreturn #plan.toks\nend)\nif not ok then\nbroadcastToAll(NF.seatTag(CFG.seat) .. \" SORT failed: \" .. tostring(n), {1, 0.45, 0.35})\nreturn 0\nend\nreturn n\nend\nfunction NF.portraitSpot(board)\nlocal best, bd = nil, 14 * 14\nfor _, o in ipairs(getObjectsWithTag(\"PortraitTile\")) do\nif not isHeld(o) then\nlocal d = NF.flat2(o.getPosition(), board.getPosition())\nif d < bd then best, bd = o, d end\nend\nend\nif best then\nlocal b = best.getBounds()\nreturn {x = b.center.x, y = b.center.y + b.size.y / 2, z = b.center.z}\nend\nfor _, s in ipairs(board.getSnapPoints() or {}) do   -- (no portrait yet: the character card's place)\nfor _, t in ipairs(s.tags or {}) do\nif t == \"Character_\" .. CFG.seat then\nlocal w = board.positionToWorld(s.position)\nreturn {x = w.x, y = w.y + 0.3, z = w.z}\nend\nend\nend\nlocal p = board.getPosition()\nreturn {x = p.x, y = p.y + 1, z = p.z}\nend\nNF.KIND_NAME = {meat = \"fresh meat\", mushroom = \"mushroom\"}\nfunction rewardTake(p)\nif CFG.name ~= \"BOARD\" then return \"not the board\" end\np = type(p) == \"table\" and p or {}\nlocal board = NF.invBoard()\nif not board then return \"no player board\" end\nlocal tile = p.tile and getObjectFromGUID(p.tile) or nil\nlocal want = {tile = tile, tokens = {}}\nfor _ = 1, math.floor(tonumber(p.meat or 0) or 0) do want.tokens[#want.tokens + 1] = \"meat\" end\nfor _ = 1, math.floor(tonumber(p.mushroom or 0) or 0) do want.tokens[#want.tokens + 1] = \"mushroom\" end\nfor _, f in ipairs(p.flowers or {}) do want.tokens[#want.tokens + 1] = tostring(f):lower() end\nlocal plan = nil\nlocal noSort = SCRIPT_OPTS and SCRIPT_OPTS.autoSort == false   -- (scripting option: nothing placed: by the portrait)\nif noSort then\nplan = {over = {}}\nif tile then plan.over[#plan.over + 1] = {tile = tile} end\nfor _, kk in ipairs(want.tokens) do plan.over[#plan.over + 1] = {kind = kk} end\nelse\nplan = NF.invPlan(board, want)\nNF.invRun(plan)\nend