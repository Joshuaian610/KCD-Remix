eat switched them off\nlocal k = SO_MOD[CFG.name]\nif not k or SHARED then return true end\nif CFG.controller then return SCRIPT_OPTS[k] ~= false end\nlocal b = soBoardOf(CFG.seat)\nif not b then return true end\nlocal on = true\npcall(function() on = b.call(\"scriptOpt\", {name = k}) ~= false end)\nreturn on\nend\nfunction soRebuild()                             -- (a module of the seat)\nif IS_COPY then return end\nif CFG.controller then buildMenu() return end\nself.clearButtons()\nfeaturesButtons()\nend\nfunction featuresButtons() if soModOn() then dispatch(\"onButtons\") end end   -- (scripting options)\nfunction featuresDestroy() dispatch(\"onDestroy\") end\nlocal function featuresSave()\nlocal t = {}\nfor i, f in ipairs(FEATURES) do\nif f.onSave then\nlocal ok, r = pcall(f.onSave)\nif ok then t[tostring(i)] = r end\nend\nend\nreturn t\nend\nlocal function featuresStart(saved)\nif IS_COPY then return end\nfor i, f in ipairs(FEATURES) do\nif f.onRestore and saved and saved[tostring(i)] ~= nil then pcall(f.onRestore, saved[tostring(i)]) end\nend\ndispatch(\"onLoad\")\nif soModOn() then dispatch(\"onButtons\") end                              -- (the base tray rebuilds them again whenever its menu redraws)\nend\nEVENT_USERS = {onObjectDrop = {BOARD = true, QUESTS = true, BED = true}, onObjectPickUp = {BOARD = true, QUESTS = true},\nonObjectLeaveContainer = {BOARD = true, DECK = true, DISCARD = true}, onPlayerTurn = {BOARD = true}}\nif EVENT_USERS.onObjectDrop[CFG.name] then\nfunction onObjectDrop(color, obj) dispatch(\"onObjectDrop\", color, obj) end\nend\nif EVENT_USERS.onObjectLeaveContainer[CFG.name] then\nfunction onObjectLeaveContainer(container, obj) dispatch(\"onObjectLeaveContainer\", container, obj) end\nend\nif EVENT_USERS.onObjectPickUp[CFG.name] then\nfunction onObjectPickUp(color, obj) dispatch(\"onObjectPickUp\", color, obj) end\nend\nif EVENT_USERS.onPlayerTurn[CFG.name] then\nfunction onPlayerTurn(player, prev) dispatch(\"onPlayerTurn\", player, prev) end\nend\nIS_COPY = false     -- a copied module (Edit layout's copy icon): looks and snaps like the original, runs no game scripting\nfunction onSave()\nreturn JSON.encode({rails = railGuid, flat = FLAT, noRails = NO_RAILS, copy = IS_COPY, feat = featuresSave(),\ngrid = SHOW_GRID, locked = LOCKED, margin = (CFG.controller and SHARED) and MARGIN or nil,\nopts = CFG.controller and SCRIPT_OPTS or nil})\n.. (CFG.controller and removedPack() or \"\")\nend\nfunction onLoad(state)\nlocal feat = nil\nif state and state ~= \"\" then\nif CFG.controller then state = removedUnpack(state) end   -- (fills removed from the raw part)\nlocal s = JSON.decode(state) or {}\nfeat = s.feat\nrailGuid = s.rails or {}\nFLAT = s.flat or false\nNO_RAILS = s.noRails or false\nIS_COPY = s.copy or false\nif CFG.controller then\nfor n, r in pairs(s.removed or {}) do removed[n] = r end   -- (older saves: decoded data)\nif s.grid ~= nil then SHOW_GRID = s.grid end\nLOCKED = s.locked or false\nif type(s.opts) == \"table\" then\nfor k, v in pairs(s.opts) do if SCRIPT_OPTS[k] ~= nil then SCRIPT_OPTS[k] = (v ~= false) end end\nlocal anyOff = false\nfor _, v in pairs(SCRIPT_OPTS) do if v == false then anyOff = true end end\nif anyOff then Wait.time(function() pcall(soRebuildSeat) end, 6) end   -- (the seat's modules may have loaded first)\nend\nif SHARED and type(s.margin) == \"table\" then\nfor k, v in pairs(s.margin) do if MARGIN[k] then MARGIN[k] = tonumber(v) or MARGIN[k] end end\nend\nend\nend\nself.interactable = false\nif CFG.controller then makeGear() end              -- (only the base tray has the menu code)\nif CFG.controller and extendButtons then extendButtons() end   -- (the middle: Extend on the margin's edges)\nif CFG.controller and SHARED and marginSync then Wait.frames(marginSync, 60) end   -- (wood where it is missing)\nWait.frames(syncExtras, 40 + math.random(0, 40))\nif self.getLock() then\nif next(railGuid) == nil and #(self.getAttachments() or {}) == 0 then\nWait.frames(function() self.call(\"refreshRails\", {}) end, 30 + math.random(0, 30))\nend\nelse\nWait.condition(function() self.setLock(true) Wait.frames(function() self.call(\"refreshRails\", {}) end, 20) end,\nfunction() return self.resting end, 10, function() self.setLock(true) self.call(\"refreshRails\", {}) end)\nend\nWait.frames(function() featuresStart(feat) end, 45 + math.random(0, 60))\nend\nfunction onDestroy()\nif edit then hideModules() end\nremoveExtras()\nif featuresDestroy then featuresDestroy() end      -- features stop their timers\nend\nlocal NF = {}\nSO_NF = NF                                       -- (the scripting options above this line reach NF through it)\nNF.SETUP_GUID = \"dd652d\"                        -- the Setup Controller (only read: its global tables)\nNF.BTN_PX = 490                                 -- button width / height per world unit\nNF.GOLD = {1.0, 0.86, 0.52, 1}\nNF.NAVY = {0.10, 0.16, 0.30, 0.96}\nNF.DEF = {\nBOARD = {tuck_slide_target = {-4.265, 0.11, -7.01}},\nDECK = {snap_deck = {0.5, 0.62, 0}, draw = {-3.255, 0.76, 0}},\nDISCARD = {snap_discard = {0.5, 0.62, 0}, shuffle = {-3.255, 0.76, 0}},\nGROSCHEN = {coin_zone_centre = {0, 1.4, 0.75}, minus1 = {-4.75, 0.76, -1.975}, plus1 = {-3.05, 0.76, -1.975},\nminus5 = {-0.85, 0.76, -1.975}, plus5 = {0.85, 0.76, -1.975}, minus20 = {3.05, 0.76, -1.975},\nplus20 = {4.75, 0.76, -1.975}},\nQUESTS = {slot1 = {-6.5333, 0.62, 0.28}, slot2 = {0, 0.62, 0.28}, slot3 = {6.5333, 0.62, 0.28}, draw2 = {0, 0.75, -3.88}},\nSUPPLIES = {meat = {-2.8, 0.76, 0}, mushroom = {0, 0.76, 0}, dirt = {2.8, 0.76, 0}},\nHENRY = {deck = {-11.6, 0.65, -8.6}, next = {-6.5, 0.75, -2.75},   -- (v8, 12 x 9)\nsheet_front = {-13.75, 0.75, 9.65}, sheet_back = {-10.25, 0.75, 9.65}},   -- (under the \"Henry\" lettering)\nPOTIONS = {button = {0, 0.76, 0}},\nMEETING = {snap_black_focus_tile = {0.2877, 0.62, -1.692}},\nDAMAGE = {token = {0, 0.76, 0}},\nGUARDS = {token = {0, 0.76, 0}},\nFLOWERS = {white = {-3.36, 0.76, 0}, yellow = {-1.68, 0.76, 0}, orange = {0, 0.76, 0}, red = {1.68, 0.76, 0},\nblue = {3.36, 0.76, 0}},\n}\nNF.SIZE = {draw = {1.1, 4.6}, shuffle = {1.1, 4.6}, plate = {1.7, 1.0}, draw2 = {2.4, 0.56}, potions = {2.4, 0.8},\nmeat = 2.112, mushroom = 2.024, dirt = 2.112, slot = {5.42, 7.54}, groove = {2.6, 3.6},\nhenryDeck = {5.7, 4.1}, well = {5.89, 1.85}, token = 2.3, flower = 1.5, nav = 2.6}\nfunction NF.anchor(name, module)\nlocal m = module or CFG.name\nlocal a = (module == nil and CFG.anchors and CFG.anchors[name]) or (NF.DEF[m] and NF.DEF[m][name])\nif not a then return nil end\nreturn {x = a[1] or a.x or 0, y = a[2] or a.y or TOP, z = a[3] or a.z or 0}\nend\nfunction NF.btnY(a)\nlocal y = a.y or TOP\nreturn (FLAT and math.max(0.2, y - TOP + 0.2) or y) + 0.02\nend\nfunction NF.top() return FLAT and 0.2 or TOP end\nfunction NF.findButton(fn)\nfor _, b in ipairs(self.getButtons() or {}) do\nif b.click_function == fn then return b.index end\nend\nreturn nil\nend\nfunction NF.button(t)\nlocal i = NF.findButton(t.click_function)\nif i then\nt.index = i\nself.editButton(__sharpB(t, false))\nreturn i\nend\nt.function_owner = self\nself.createButton(__sharpB(t, true))\nreturn NF.findButton(t.click_function)\nend\nfunction NF.plate(fn, a, w, h, tip)\nreturn NF.button({click_function = fn, label = \"\", tooltip = tip or \"\",\nposition = {-a.x, NF.btnY(a), a.z}, rotation = {0, 180, 0},\nwidth = math.floor(w * NF.BTN_PX), height = math.floor(h * NF.BTN_PX),\ncolor = {1, 1, 1, 0}, hover_color = {1, 1, 1, 0.2}, press_color = {1, 1, 1, 0.4}, font_color = {0, 0, 0, 0}})\nend\nNF.ENDP_URL = {next = \"https://steamusercontent-a.akamaihd.net/ugc/17055427885855265342/9B30D58E6B3D79157DF4DAA044C493C1DA4932EC/\",\nref = \"https://steamusercontent-a.akamaihd.net/ugc/9505861573008160508/050C3CC6C7DA598B227297656F35C91D17416586/\"}\nfunction NF.endpSet(name, url, a, w, h)\nif not url or url == \"\" then return false end\nlocal y = NF.btnY(a) - 0.012\nlocal out, same = {}, false\nfor _, d in ipairs(self.getDecals() or {}) do\nif d.name == name then\nlocal p = d.position or {}\nlocal px, py, pz = p.x or p[1] or 0, p.y or p[2] or 0, p.z or p[3] or 0\nif d.url == url and math.abs(px - a.x) < 0.01 and math.abs(py - y) < 0.01 and math.abs(pz - a.z) < 0.01 then same = true end\nelse\nout[#out + 1] = d\nend\nend\nif same then return true end\nout[#out + 1] = {name = name, url = url, position = {a.x, y, a.z}, rotation = {90, 0, 0}, scale = {w, h, 1}}\nself.setDecals(out)\nreturn true\nend\nfunction NF.solid(fn, label, x, y, z, w, h, tip, fs)\nreturn NF.button({click_function = fn, label = label, tooltip = tip or \"\",\nposition = {-x, y, z}, rotation = {0, 180, 0}, width = math.floor(w * NF.BTN_PX), height = math.floor(h * NF.BTN_PX),\nfont_size = fs or 120, color = NF.NAVY, hover_color = {0.18, 0.26, 0.45, 1}, press_color = {0.28, 0.36, 0.55, 1},\nfont_color = NF.GOLD})\nend\nfunction NF.seatTag(seat)\nlocal ok, hex = pcall(function() return Color.fromString(seat):toHex(false) end)\nreturn ok and (\"[\" .. hex .. \"][\" .. seat:upper() .. \"][-]\") or (\"[\" .. seat:upper() .. \"]\")\nend\nNF.SAY_WAIT = 0.4\nNF.SAYQ, NF.SAYSEQ = {}, 0\nfunction NF.say(msg, hist)\nNF.stack(tostring(msg), false, nil)\nif hist ~= false and NF.hist then NF.hist(hist or msg) end\nend\nfunction NF.tell(color, msg)\nNF.stack(tostring(msg), true, color)\nend\nfunction NF.plural(w)                             -- \"Red flower\" -> \"Red flowers\"; \"meat\", \"Herbs (3 x 2)\" stay\nif w:match(\"meat$\") or not w:match(\"[a-rt-z]$\") then return w end\nreturn w .. \"s\"\nend\nfunction NF.sayNum(s)                             -- (MoonSharp: tonumber(nil) throws)\nif s == nil then return 0 end\nreturn tonumber(s) or 0\nend\nfunction NF.sayKind(msg)                          -- a line's stack key and its parts ({k = \"same\"}: the same line only)\nlocal what, a, b, rest = msg:match(\"^ate (.-): hunger (%d+) → (%d+)(.*)$\")\nlocal full, plus, g, n, lbl = nil, nil, nil, nil, nil\nif not what then what, full, rest = msg:match(\"^ate (.-): already full %((%d+) wasted%)(.*)$\") end\nif not what then what, plus, rest = msg:match(\"^ate (.-) %(hunger %+(%d+)%)(.*)$\") end\nif what then\nlocal w, r2 = rest:match(\"^ %((%d+) wasted%)(.*)$\")\nreturn \"eat|\" .. what, {k = \"eat\", what = what, a = a and NF.sayNum(a) or nil, b = b and NF.sayNum(b) or nil,\nw = NF.sayNum(w or full), p = NF.sayNum(plus), rest = r2 or rest}\nend\nwhat = msg:match(\"^drank a (.+)$\")\nif what then return \"drank|\" .. what, {k = \"drank\", what = what} end\nwhat, g, rest = msg:match(\"^sold (.-) for (%d+) Groschen(.*)$\")\nif what then return \"sold\", {k = \"sold\", items = {{what = what, n = 1}}, g = NF.sayNum(g), rest = rest} end\nn, what = msg:match(\"^%+(%d+) (.+)$\")\nif n then return \"plus|\" .. what, {k = \"plus\", what = what, n = NF.sayNum(n)} end\nif #msg <= 80 then\nlocal at = msg:find(\" %-?%d+ → %-?%d+$\")\nif at and at > 1 then\na, b = msg:sub(at):match(\"^ (%-?%d+) → (%-?%d+)$\")\nlbl = msg:sub(1, at - 1)\nif a and b then return \"chg|\" .. lbl, {k = \"chg\", lbl = lbl, a = a, b = b} end\nend\nend\nreturn \"same|\" .. msg, {k = \"same\"}\nend\nfunction NF.sayMerge(o, d)                        -- one more line of the kind into its stack\nif d.k == \"chg\" then\no.b = d.b\nelseif d.k == \"plus\" then\no.n = o.n + d.n\nelseif d.k == \"eat\" then\nif d.a then\no.a = o.a or d.a\no.b = d.b\nend\no.w, o.p, o.rest = o.w + d.w, o.p + d.p, d.rest\nelseif d.k == \"sold\" then\nlocal it = nil\nfor _, x in ipairs(o.items) do if x.what == d.items[1].what then it = x end end\nif it then it.n = it.n + 1 else o.items[#o.items + 1] = {what = d.items[1].what, n = 1} end\no.g = o.g + d.g\nif d.rest ~= \"\" and not o.rest:find(d.rest, 1, true) then o.rest = o.rest .. d.rest end\nend\nend\nfunction NF.sayText(q)                            -- a stack as one line (a line alone: as it was said)\nlocal d = q.d\nif q.n <= 1 then return q.msg end\nif d.k == \"chg\" then return d.lbl .. \" \" .. d.a .. \" → \" .. d.b end\nif d.k == \"plus\" then return \"+\" .. d.n .. \" \" .. d.what end\nif d.k == \"drank\" then return \"drank \" .. q.n .. \" \" .. NF.plural(d.what) end\nif d.k == \"eat\" then\nlocal t = d.what:match(\"^from \") or d.what:match(\"^all of \")\nt = \"ate \" .. (t and (d.what .. \" (x\" .. q.n .. \")\") or (q.n .. \" \" .. NF.plural(d.what)))\nif d.a then t = t .. \": hunger \" .. d.a .. \" → \" .. d.b\nelseif d.p > 0 then t = t .. \" (hunger +\" .. d.p .. \")\"\nelse t = t .. \": already full\" end\nreturn t .. (d.w > 0 and (\" (\" .. d.w .. \" wasted)\") or \"\") .. d.rest\nend\nif d.k == \"sold\" then\nlocal out = {}\nfor _, it in ipairs(d.items) do out[#out + 1] = it.n > 1 and (it.n .. \" \" .. NF.plural(it.what)) or it.what end\nreturn \"sold \" .. table.concat(out, \", \") .. \" for \" .. d.g .. \" Groschen\" .. d.rest\nend\nreturn q.msg .. \" (x\" .. q.n .. \")\"\nend\nfunction NF.stack(msg, tell, color)\nlocal key, d = \"tell|\" .. tostring(color) .. \"|\" .. msg, {k = \"same\"}\nif not tell then key, d = NF.sayKind(msg) end\nlocal q = nil\nfor _, x in ipairs(NF.SAYQ) do if x.key == key then q = x break end end\nif q then\nq.n = q.n + 1\nNF.sayMerge(q.d, d)\nelse\nq = {key = key, msg = msg, d = d, n = 1, tell = tell, color = color, gen = 0}\nNF.SAYQ[#NF.SAYQ + 1] = q\nend\nNF.SAYSEQ = NF.SAYSEQ + 1\nq.gen, q.seq = q.gen + 1, NF.SAYSEQ\nlocal my = q.gen\nWait.time(function() NF.sayDue(q, my) end, NF.SAY_WAIT)\nend\nfunction NF.sayDue(q, my)\nif q.out or q.gen ~= my then return end         -- (a newer line of its kind came: that one's wait counts)\nlocal due, keep = {}, {}                        -- out: this stack and every one whose last line came before its last\nfor _, x in ipairs(NF.SAYQ) do\nif x.seq <= q.seq then due[#due + 1] = x else keep[#keep + 1] = x end\nend\nNF.SAYQ = keep\nfor _, x in ipairs(due) do NF.sayOut(x) end\nend\nfunction NF.sayFlush()\nlocal due = NF.SAYQ\nNF.SAYQ = {}\nfor _, x in ipairs(due) do NF.sayOut(x) end\nend\nfunction NF.sayOut(q)\nq.out = true\nlocal ok, text = pcall(NF.sayText, q)\nif not ok or type(text) ~= \"string\" then text = q.msg end\npcall(function()\nif not q.tell then\nbroadcastToAll(NF.seatTag(CFG.seat) .. \" \" .. text, {1, 1, 1})\nelseif q.color and Player[q.color] then\nbroadcastToColor(text, q.color, {1, 0.6, 0.4})\nelse\nbroadcastToAll(text, {1, 0.6, 0.4})\nend\nend)\nend\nfunction NF.flat2(a, b) return (a.x - b.x) ^ 2 + (a.z - b.z) ^ 2 end\nfunction NF.controllerTable(name)\nlocal c = getObjectFromGUID(CFG.setupGuid or NF.SETUP_GUID)\nif not c then return nil end\nlocal ok, t = pcall(function() return c.getTable(name) end)\nreturn ok and type(t) == \"table\" and t or nil\nend\nfunction NF.modName(o) return (o.getGMNotes() or \"\"):match(\"^trayGrid:%d+:%d+:(.+)$\") or \"?\" end\nfunction NF.module(name)\nif CFG.name == name and not IS_COPY then return self end\nfor _, o in ipairs(seatModules()) do\nif NF.modName(o) == name and not o.getVar(\"IS_COPY\") then return o end\nend\nend\nfunction NF.cardYaw(m) return ((m or self).getRotation().y + 180) % 360 end\nfunction NF.isPile(o) return (o.type == \"Deck\" or o.type == \"Card\") and not isHeld(o) end\nfunction NF.pilesIn(m, cx, cz, hx, hz, ymax)\nlocal t = {}\nfor _, o in ipairs(getObjects()) do\nif NF.isPile(o) then\nlocal q = m.positionToLocal(o.getPosition())\nif math.abs(q.x - cx) < hx and math.abs(q.z - cz) < hz and q.y > -1 and q.y < (ymax or 6) then t[#t + 1] = o end\nend\nend\nreturn t\nend\nfunction NF.pileIn(m, cx, cz, hx, hz)\nlocal best = nil\nfor _, o in ipairs(NF.pilesIn(m, cx, cz, hx, hz)) do\nif not best or (o.type == \"Deck\" and best.type ~= \"Deck\") then best = o end\nend\nreturn best\nend\nfunction NF.pileAtWorld(x, z, r)\nlocal best = nil\nfor _, o in ipairs(getObjects()) do\nif NF.isPile(o) then\nlocal p = o.getPosition()\nif (p.x - x) ^ 2 + (p.z - z) ^ 2 < (r or 2) ^ 2 and p.y < 8 and (not best or o.type == \"Deck\") then best = o end\nend\nend\nreturn best\nend\nfunction NF.count(p) return p and (p.type == \"Card\" and 1 or p.getQuantity()) or 0 end\nfunction NF.nearestNamed(name, p)\nlocal best, bd = nil, nil\nfor _, o in ipairs(getObjects()) do\nif o.getName() == name then\nlocal d = NF.flat2(o.getPosition(), p)\nif not bd or d < bd then best, bd = o, d end\nend\nend\nreturn best\nend\nfunction NF.playerBoard(seat)\nlocal pb = NF.controllerTable(\"PLAYER_BOARD\")\nlocal b = pb and pb[seat] and getObjectFromGUID(pb[seat])\nif b then return b end\nfor _, o in ipairs(getObjects()) do\nif o.getName() == \"Player Board (\" .. seat .. \")\" then return o end\nend\nend\nNF.queue, NF.busy = {}, false\nfunction NF.serial(fn, hold)\nif NF.dead then return end\nif NF.busy then NF.queue[#NF.queue + 1] = fn return end\nNF.busy = true\nlocal ok, err = pcall(fn)\nif not ok then print(\"[tray \" .. tostring(CFG.name) .. \"] \" .. tostring(err)) NF.hold = false end\nlocal function release()\nif NF.dead then return end\nif NF.hold then Wait.time(release, 0.2) return end   -- an action still running (e.g. a reshuffle)\nNF.busy = false\nlocal nxt = #NF.queue > 0 and table.remove(NF.queue, 1) or nil   -- (TTS's Lua errors on remove from an empty list)\nif nxt then NF.serial(nxt, hold) end\nend\nWait.time(release, hold or 0.8)\nend\nNF.COIN_VALUES = {20, 5, 1}\nfunction NF.coinValue(o)\nif isHeld(o) then return 0 end\nlocal v = tonumber((o.getName() or \"\"):match(\"^(%d+) Groschen$\"))\nreturn v or 0\nend\nfunction NF.planPlus(n)\nlocal t, left = {[20] = 0, [5] = 0, [1] = 0}, n\nfor _, v in ipairs(NF.COIN_VALUES) do\nt[v] = math.floor(left / v)\nleft = left - t[v] * v\nend\nreturn t\nend\nfunction NF.planMinus(n, have)\nlocal h20, h5, h1 = have[20] or 0, have[5] or 0, have[1] or 0\nlocal total = h20 * 20 + h5 * 5 + h1\nif n <= 0 then return {take = {[20] = 0, [5] = 0, [1] = 0}, give = {[20] = 0, [5] = 0, [1] = 0}}, total end\nif total < n then return nil, total end\nlocal best, bestKey = nil, nil\nfor a = 0, h20 do\nfor b = 0, h5 do\nlocal s = a * 20 + b * 5\nlocal opts = {}\nlocal need = n - s\nif need > 0 and need <= h1 then opts[#opts + 1] = need end\nif need <= 0 then opts[#opts + 1] = 0 end\nif need > h1 then opts[#opts + 1] = -1 end        -- not enough with these: skip\nfor _, c in ipairs(opts) do\nif c >= 0 then\nlocal sum = s + c\nif sum >= n then\nlocal over = sum - n\nlocal g = NF.planPlus(over)\nlocal removed = a + b + c\nlocal moved = removed + g[20] + g[5] + g[1]\nlocal key = (over == 0 and 0 or 1) * 1e6 + (over == 0 and removed or moved) * 1e3 + over\nif not bestKey or key < bestKey then\nbestKey = key\nbest = {take = {[20] = a, [5] = b, [1] = c}, give = g}\nend\nend\nend\nend\nend\nend\nreturn best, total\nend\nfunction NF.wellBox()\nlocal ok, b = pcall(function() return coinWell and coinWell() end)\nif ok and type(b) == \"table\" and b.x then return b end\nlocal a = NF.anchor(\"coin_zone_centre\") or {x = 0, y = 1.4, z = 0.75}\nreturn {x = a.x, y = a.y, z = a.z, hx = NF.SIZE.well[1], hy = 1.1, hz = NF.SIZE.well[2]}\nend\nfunction NF.wellCoins()\nlocal box = NF.wellBox()\nlocal zone = getObjectsWithTag(\"CoinCountZone_\" .. CFG.seat)[1]\nlocal zw = self.positionToWorld({box.x, box.y, box.z})\nif zone and NF.flat2(zone.getPosition(), zw) > 2.25 then zone = nil end   -- left elsewhere: use the box\nlocal list = {}\nfor _, o in ipairs(getObjects()) do\nlocal v = NF.coinValue(o)\nif v > 0 then\nlocal inside = nil\nif zone then\nlocal q = zone.positionToLocal(o.getPosition())\ninside = math.abs(q.x) <= 0.5 and math.abs(q.y) <= 0.5 and math.abs(q.z) <= 0.5\nelse\nlocal q = self.positionToLocal(o.getPosition())\ninside = math.abs(q.x - box.x) <= box.hx and math.abs(q.z - box.z) <= box.hz and math.abs(q.y - box.y) <= box.hy + 0.6\nend\nif inside then list[#list + 1] = {o = o, v = v} end\nend\nend\nreturn list\nend\nfunction NF.coinBowl(v) return NF.nearestNamed(v .. \" Groschen Bowl\", self.getPosition()) end\nfunction NF.coinSpot(n, hx, hz)\nlocal function tri() return math.random() + math.random() - 1 end\nreturn tri() * math.min(hx, 1.6 + 0.7 * n), tri() * math.min(hz, 0.7 + 0.25 * n)   -- (user: a bit wider)\nend\nNF.fresh, NF.gone = {}, {}\nfunction NF.payIn(g)\nlocal a = NF.wellBox()\nlocal k = 0\nlocal n = #NF.wellCoins()                      -- (the middle first: the more coins lie there, the further out)\nfor _ in pairs(NF.fresh) do n = n + 1 end\nfor _, v in ipairs(NF.COIN_VALUES) do\nlocal bowl = NF.coinBowl(v)\nfor _ = 1, g[v] or 0 do\nif bowl then\nk = k + 1\nlocal dx, dz = NF.coinSpot(n + k - 1, a.hx - 0.6, a.hz - 0.55)\nlocal at = self.positionToWorld({a.x + dx, NF.top() + 0.5 + 0.1 * k, a.z + dz})\nlocal o = bowl.takeObject({position = at, rotation = {0, math.random(0, 359), 0}, smooth = false})\nif o then\nlocal gid = o.getGUID()\nNF.fresh[gid] = {o = o, v = v}\nWait.time(function() NF.fresh[gid] = nil end, 3)\nend\nend\nend\nend\nreturn k\nend\nfunction NF.alive(o)\nif o == nil then return false end\nlocal ok, gone = pcall(function() return o.isDestroyed() end)\nreturn ok and not gone\nend\nfunction NF.coinsNow()\nlocal list, seen = {}, {}\nfor _, c in ipairs(NF.wellCoins()) do\nlocal gid = c.o.getGUID()\nif not NF.gone[gid] then list[#list + 1] = c seen[gid] = true end\nend\nfor gid, f in pairs(NF.fresh) do\nif not seen[gid] and not NF.gone[gid] and NF.alive(f.o) then list[#list + 1] = {o = f.o, v = f.v} end\nend\nreturn list\nend\nfunction NF.groschen(n, color, why)            -- (why: \"Accident: \" before the line, user 2026-11-05)\nwhy = why or \"\"\nlocal ok, err = pcall(function()\nlocal coins = NF.coinsNow()\nlocal have, before = {[20] = 0, [5] = 0, [1] = 0}, 0\nfor _, c in ipairs(coins) do have[c.v] = (have[c.v] or 0) + 1 before = before + c.v end\nif n > 0 then\nNF.payIn(NF.planPlus(n))\nNF.say(why .. \"Groschen \" .. before .. \" → \" .. (before + n))\nreturn\nend\nif before <= 0 then\nNF.say(why .. \"no Groschen\", false)          -- (said to all, user 2026-11-05)\nreturn\nend\nif -n > before then n = -before end\nlocal plan = NF.planMinus(-n, have)\nif not plan then\nNF.tell(color, CFG.seat .. \" has only \" .. before .. \" Groschen.\")\nreturn\nend\nfor _, v in ipairs(NF.COIN_VALUES) do\nlocal k = plan.take[v] or 0\nfor _, c in ipairs(coins) do\nif k > 0 and c.v == v and not c.o.isDestroyed() then\nlocal gid = c.o.getGUID()\nNF.gone[gid], NF.fresh[gid] = true, nil\nWait.time(function() NF.gone[gid] = nil end, 3)\nc.o.destruct()\nk = k - 1\nend\nend\nend\nNF.payIn(plan.give)                          -- the change, from the bowls (they are infinite: removed coins vanish)\nNF.say(why .. \"Groschen \" .. before .. \" → \" .. (before + n))\nend)\nif not ok then print(\"[tray \" .. tostring(CFG.name) .. \"] \" .. tostring(err)) end\nend\nfunction groschenPay(p)\nlocal n = tonumber(p and p.n) or 0\nif n <= 0 or CFG.name ~= \"GROSCHEN\" then return 0 end\nreturn NF.payIn(NF.planPlus(n))\nend\nfunction groschenTake(p)                        -- (Calculate's repairs, user 2026-11-06) up to n out of the well, never below 0\nlocal n = tonumber(p and p.n) or 0\nif n <= 0 or CFG.name ~= \"GROSCHEN\" then return 0 end\nlocal have = 0\nfor _, c in ipairs(NF.coinsNow()) do have = have + (c.v or 0) end\nlocal take = math.min(n, have)\nif take > 0 then NF.groschen(-take, CFG.seat, (p and p.why) or \"\") end\nreturn take\nend\nfunction nfMinus1(_, c) NF.groschen(-1, c) end\nfunction nfPlus1(_, c) NF.groschen(1, c) end\nfunction nfMinus5(_, c) NF.groschen(-5, c) end\nfunction nfPlus5(_, c) NF.groschen(5, c) end\nfunction nfMinus20(_, c) NF.groschen(-20, c) end\nfunction nfPlus20(_, c) NF.groschen(20, c) end\nfunction NF.deckSpot()\nlocal m = NF.module(\"DECK\")\nif not m then return nil end\nlocal a = NF.anchor(\"snap_deck\", m ~= self and \"DECK\" or nil) or {x = 0.5, y = 0.62, z = 0}\nreturn m, a\nend\nfunction NF.discardSpot()\nlocal m = NF.module(\"DISCARD\")\nif not m then return nil end\nlocal a = NF.anchor(\"snap_discard\", m ~= self and \"DISCARD\" or nil) or {x = 0.5, y = 0.62, z = 0}\nreturn m, a\nend\nfunction NF.deckPil