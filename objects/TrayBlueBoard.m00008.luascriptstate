ment on what is left (major -> minor -> back under the Wound Tokens), 1 cube a heal. p.bonus (the\n-- player ticked \"First heal of the turn?\" on the Score Pad): the first Ointment heal heals once more for free\nfunction invHealForScore(p)\nif CFG.name ~= \"BOARD\" then return {} end\nlocal board = NF.invBoard()\nif not board then return {} end\nlocal majors, minors = {}, {}\nfor _, o in ipairs(getObjectsWithTag(\"WoundToken\")) do\nif o.type == \"Card\" and not isHeld(o) and NF.onBoard(board, o) then\nif NF.faceDown(o) then minors[#minors + 1] = o else majors[#majors + 1] = o end\nend\nend\nif #majors + #minors == 0 then return {} end\nlocal band, oint = {}, {}\nfor _, it in ipairs(NF.invItems(board, NF.invBoxes(board, NF.invSlots(board)))) do\nlocal name = it.o.getName()\nif name == \"Bandages\" or name == \"Healing Ointment\" then\nfor _, c in ipairs(NF.cubesOn(it.o, board)) do\nif name == \"Bandages\" then band[#band + 1] = c else oint[#oint + 1] = c end\nend\nend\nend\n-- (user, 2026-11-06: \"do you get the dilemma\" - the free heal only counts when the Ointment is the turn's FIRST heal,\n-- so no fixed order is always best) every order is tried: the most heal steps (each +1 point: major -> minor ->\n-- healed), then the cheapest cubes (the ones left over are sold: Bandages 1, Ointment 3 each)\nlocal bonus = p ~= nil and p.bonus == true\nlocal memo = {}\nlocal function best(M, m, B, O, credit, first)\nlocal key = M .. \":\" .. m .. \":\" .. B .. \":\" .. O .. \":\" .. credit .. \":\" .. (first and 1 or 0)\nif memo[key] then return memo[key] end\nlocal win = {steps = 0, cost = 0, plan = nil}\nlocal function try(act, nM, nm, nB, nO, nc, cost)\nlocal r = best(nM, nm, nB, nO, nc, false)\nlocal s, c = r.steps + 1, r.cost + cost\nif s > win.steps or (s == win.steps and c < win.cost) then win = {steps = s, cost = c, plan = {act = act, nxt = r}} end\nend\nif credit > 0 then                              -- the free second heal comes right after the first one (or not at