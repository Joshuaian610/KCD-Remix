://steamusercontent-a.akamaihd.net/ugc/9819290667051693201/194D9D1EC940945E6D602E1048DA3B15A0798E78/\", [\"rail_partial_l_L1.240.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/16257387736164123951/212072819CF2F066DCE74326DCFA1219D77FBAF7/\", [\"rail_partial_r_L1.380.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/9885171731826431240/BD4216AE2F6C9200B1DB38E13ECF2C2A51EA957A/\", [\"rail_stub_l.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/16336997034581900001/FD328775654B2364CC0AD382CC87A1E6FE8827A6/\", [\"rail_stub_r.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/17401661737892336804/3D54465392AA6095E82933305BC694DA0D5052EA/\", [\"rail_unit_ss.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/16717650843312811984/C09511CC60842688945342C6D7446A20144B12F5/\", [\"rail_unit_sx.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/16007010190934677624/3B4AB603AFB198D2ED2E0E558BA0DB527FDB5189/\", [\"rail_unit_xs.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/14689712656217313285/37A8A26AD9902C7F4B2700F9D7787833965B231A/\", [\"rail_unit_xx.obj\"] = \"https://steamusercontent-a.akamaihd.net/ugc/10652397101479018961/81EA1CB39695A2B2BFF951A0B475C02651E01FCE/\"}, [\"gear\"] = {[\"x\"] = 14.900000000000004, [\"z\"] = -8.24, [\"size\"] = 0.9, [\"url\"] = \"https://steamusercontent-a.akamaihd.net/ugc/14356154023075174369/6757ABB088A540BB0BB7AF5C4186DD212C63A775/\"}, [\"skip\"] = {}, [\"partial\"] = {}, [\"trayModel\"] = {[\"mesh\"] = \"https://steamusercontent-a.akamaihd.net/ugc/17225113590644424317/7F195E0E7A0190B4959E7707DC5A8449F2DECCDC/\", [\"diffuse\"] = \"https://steamusercontent-a.akamaihd.net/ugc/15904058478282011550/73D47698C10E8B1622D7AB33C4BC10606F35D4DC/\", [\"collider\"] = \"\", [\"convex\"] = true}, [\"flatModel\"] = {[\"mesh\"] = \"https://steamusercontent-a.akamaihd.net/ugc/16124807754988354724/A44421FF8DC714484C36655EA44DBE792B9E1FC1/\", [\"diffuse\"] = \"https://steamusercontent-a.akamaihd.net/ugc/15054720397406917612/F94363ADFFCC5735AB9703020EFDAC421A295923/\", [\"collider\"] = \"\", [\"convex\"] = true}, [\"flatMesh\"] = true, [\"anchors\"] = {}, [\"setupGuid\"] = \"dd652d\"}\nlocal U = CFG.unit\nlocal TAG, SEAT = \"TrayGrid\", \"TrayGrid_\" .. CFG.seat\nlocal E = 0.1\nlocal TOP = CFG.top or 0.75                -- the module top (the middle tray's modules are lower: CFG.top)\nlocal SHARED = CFG.shared == true\nlocal pending, railGuid = {}, {}\nwanted = {}\nlocal layoutCode, buildMenu = nil, nil   -- defined further down, used earlier\nNO_RAILS = false                     -- rails switched off for this module (menu: Rails on/off)\nSHOW_GRID, LOCKED = true, false      -- controller settings\nlocal history = {}                   -- controller: layout codes before each change (Undo)\nlocal function localDims(o)\nlocal w, d = (o.getGMNotes() or \"\"):match(\"^tray%a+:(%d+):(%d+)\")\nreturn tonumber(w) or 1, tonumber(d) or 1\nend\nlocal MARGIN_TAG = \"TrayMargin_\" .. CFG.seat\nfunction marginPieces()\nlocal t = {}\nfor _, o in ipairs(getObjectsWithTag(MARGIN_TAG)) do\nif (o.getGMNotes() or \"\"):sub(1, 11) == \"trayMargin:\" and not o.isDestroyed() then t[#t + 1] = o end\nend\nreturn t\nend\nlocal function isHeld(o) return o.held_by_color ~= nil and o.held_by_color ~= \"\" end\nlocal function asset(base, name) return (CFG.files and CFG.files[name]) or (base .. name) end\nlocal function seatModules()\nlocal t = {}\nfor _, o in ipairs(getObjectsWithTag(SEAT)) do\nif (o.getGMNotes() or \"\"):sub(1, 9) == \"trayGrid:\" then t[#t + 1] = o end\nend\nreturn t\nend\nlocal NEVER_RIDE = SHARED and {dd652d = true} or {dd652d = true, fdc270 = true}\nlocal NO_RIDE_TAGS = SHARED and {\"TableFrame\", \"TavernTable\"} or {\"TableFrame\", \"SmallBox\", \"StoryBox\", \"TavernTable\"}\nlocal function canRide(o)\nlocal notes = o.getGMNotes() or \"\"\nif isHeld(o) or notes:sub(1, 9) == \"trayGrid:\" or notes == \"trayZone\" or notes:sub(1, 10) == \"trayExtra:\"\nor notes:sub(1, 11) == \"trayMargin:\" or o.name == \"HandTrigger\" or NEVER_RIDE[o.getGUID()] then return false end\nfor _, t in ipairs(o.getTags() or {}) do\nfor _, n in ipairs(NO_RIDE_TAGS) do if t == n then return false end end\nend\nreturn true\nend\nlocal function ridersOf(m)\nlocal w, d = localDims(m)\nlocal t = {}\nfor _, o in ipairs(getObjects()) do\nif canRide(o) then\nlocal q = m.positionToLocal(o.getPosition())\nif math.abs(q.x) < w * U / 2 and math.abs(q.z) < d * U / 2 and q.y > -0.2 and q.y < 6 then t[#t + 1] = o end\nend\nend\nreturn t\nend\nlocal function yawOf(o) return o.getRotation().y end\nlocal function sameYaw(a, b)\nlocal d = math.abs((yawOf(a) - yawOf(b)) % 90)\nreturn math.min(d, 90 - d) < 5\nend\nlocal function quarterOf(o) return math.floor(((yawOf(o) - yawOf(self)) % 360) / 90 + 0.5) % 4 end\nlocal function dims(o)\nlocal w, d = localDims(o)\nif quarterOf(o) % 2 == 1 then return d, w end\nreturn w, d\nend\nlocal function insideModule(o, lx, lz)\nlocal ow, od = localDims(o)\nif o == self then\nreturn math.abs(lx) < ow * U / 2 - 1e-4 and math.abs(lz) < od * U / 2 - 1e-4\nend\nlocal q = o.positionToLocal(self.positionToWorld({lx, 0.4, lz}))\nreturn math.abs(q.x) < ow * U / 2 + 1e-3 and math.abs(q.z) < od * U / 2 + 1e-3 and math.abs(q.y - 0.4) < 0.5\nend\nlocal function occupiedBy(list, lx, lz)\nfor _, f in ipairs(list) do\nif f.o then\nif insideModule(f.o, lx, lz) then return true end\nelseif lx > f.x0 and lx < f.x1 and lz > f.z0 and lz < f.z1 then return true end\nend\nreturn false\nend\nfunction trayRailFeet(list)\nlocal sw, sd = localDims(self)\nlocal feet = {{x0 = -sw * U / 2 + 1e-4, x1 = sw * U / 2 - 1e-4, z0 = -sd * U / 2 + 1e-4, z1 = sd * U / 2 - 1e-4}}\nlocal sy = self.getRotation().y\nfor _, o in ipairs(list) do\nlocal oy = o.getRotation().y\nlocal dy = (oy - sy) % 90\nif math.min(dy, 90 - dy) > 0.5 then\nfeet[#feet + 1] = {o = o}\nelse\nlocal q = self.positionToLocal(o.getPosition())\nif math.abs(q.y) < 0.5 then\nlocal ow, od = localDims(o)\nif math.floor(((oy - sy) % 360) / 90 + 0.5) % 2 == 1 then ow, od = od, ow end\nlocal hx, hz = ow * U / 2 + 1e-3, od * U / 2 + 1e-3\nfeet[#feet + 1] = {x0 = q.x - hx, x1 = q.x + hx, z0 = q.z - hz, z1 = q.z + hz}\nend\nend\nend\nreturn feet\nend\nlocal SIDES = {\nS = {ox = 0, oz = -1, yaw = 0,   dx = 1,  dz = 0},\nW = {ox = -1, oz = 0, yaw = 90,  dx = 0,  dz = -1},\nN = {ox = 0, oz = 1, yaw = 180,  dx = -1, dz = 0},\nE = {ox = 1, oz = 0, yaw = 270,  dx = 0,  dz = 1},\n}\nlocal function segments()\nlocal hx, hz = CFG.w * U / 2, CFG.d * U / 2\nlocal t = {}\nfor i = 0, CFG.w - 1 do\nlocal x0, x1 = -hx + i * U, -hx + (i + 1) * U\nt[#t + 1] = {key = \"S\" .. i, side = \"S\", mx = (x0 + x1) / 2, mz = -hz, ends = {{x0, -hz}, {x1, -hz}}}\nt[#t + 1] = {key = \"N\" .. i, side = \"N\", mx = (x0 + x1) / 2, mz = hz, ends = {{x0, hz}, {x1, hz}}}\nend\nfor i = 0, CFG.d - 1 do\nlocal z0, z1 = -hz + i * U, -hz + (i + 1) * U\nt[#t + 1] = {key = \"W\" .. i, side = \"W\", mx = -hx, mz = (z0 + z1) / 2, ends = {{-hx, z0}, {-hx, z1}}}\nt[#t + 1] = {key = \"E\" .. i, side = \"E\", mx = hx, mz = (z0 + z1) / 2, ends = {{hx, z0}, {hx, z1}}}\nend\nreturn t\nend\nlocal function railPlan(list)\nlocal plan = {}\nfor _, s in ipairs(segments()) do\nlocal sd = SIDES[s.side]\nif not CFG.skip[s.key] and not occupiedBy(list, s.mx + sd.ox * E, s.mz + sd.oz * E) then\nlocal letter = {}\nlocal joints = {}\nfor _, J in ipairs(s.ends) do\nlocal bx, bz = J[1] - s.mx, J[2] - s.mz\nlocal bl = math.sqrt(bx * bx + bz * bz)\nbx, bz = bx / bl, bz / bl\nlocal kind = nil\nif occupiedBy(list, J[1] + bx * E + sd.ox * E, J[2] + bz * E + sd.oz * E) then kind = \"in\"\nelseif occupiedBy(list, J[1] + bx * E - sd.ox * E, J[2] + bz * E - sd.oz * E) then kind = \"stub\"\nelse kind = \"out\" end\nlocal hand = (bx * sd.dx + bz * sd.dz) > 0 and \"r\" or \"l\"\nletter[hand] = kind == \"stub\" and \"s\" or \"x\"\nif kind ~= \"stub\" then joints[#joints + 1] = {kind = kind, hand = hand, x = J[1], z = J[2]} end\nend\nlocal p = CFG.partial[s.key]\nif p then\nplan[s.key .. \":\" .. p.mesh] = {mesh = p.mesh, x = p.jx, z = p.jz, yaw = sd.yaw, hand = p.hand}\nelse\nlocal mesh = \"rail_unit_\" .. letter.l .. letter.r\nplan[s.key .. \":\" .. mesh] = {mesh = mesh, x = s.mx, z = s.mz, yaw = sd.yaw, hand = \"r\"}\nfor _, j in ipairs(joints) do\nlocal m = \"rail_\" .. j.kind .. \"_\" .. j.hand\nplan[s.key .. \":\" .. m] = {mesh = m, x = j.x, z = j.z, yaw = sd.yaw, hand = j.hand}\nend\nend\nend\nend\nreturn plan\nend\nlocal function railKey(a)\nfor _, f in ipairs({\"gm_notes\", \"memo\", \"nickname\", \"name\", \"description\"}) do\nlocal v = a[f]\nif type(v) == \"string\" and v:sub(1, 5) == \"rail|\" then return v:sub(6) end\nend\nend\nlocal function attachedRails()\nlocal t = {}\nfor _, a in ipairs(self.getAttachments() or {}) do\nlocal k = railKey(a) or railGuid[a.guid]\nif k then t[k] = a.index end\nend\nreturn t\nend\nlocal function rotFor(yaw)\nlocal r = self.getRotation()\nreturn {r.x, (r.y + yaw) % 360, r.z}\nend\nlocal function spawnRail(key, p)\npending[key] = true\nlocal tag = \"rail|\" .. key\nspawnObjectData({\ndata = {\nName = \"Custom_Model\", Nickname = tag, Description = tag, GMNotes = tag, Memo = tag,\nTransform = {posX = 0, posY = 0, posZ = 0, rotX = 0, rotY = 0, rotZ = 0, scaleX = 1, scaleY = 1, scaleZ = 1},\nLocked = true, Tooltip = false, Grid = false, Snap = false, ColorDiffuse = {r = 1, g = 1, b = 1},\nCustomMesh = {MeshURL = asset(CFG.railURL, p.mesh .. \".obj\"), DiffuseURL = CFG.railTex, NormalURL = \"\",\nColliderURL = asset(CFG.railURL, \"rail_collider_\" .. p.hand .. \".obj\"), Convex = true,\nMaterialIndex = 3, TypeIndex = 0, CastShadows = true},\n},\nposition = self.positionToWorld({p.x, 0, p.z}),\nrotation = rotFor(p.yaw),\ncallback_function = function(o)\nWait.condition(function()\npending[key] = nil\nif wanted[key] and attachedRails()[key] == nil and not isHeld(self) then\no.setPosition(self.positionToWorld({p.x, 0, p.z}))\no.setRotation(rotFor(p.yaw))\nrailGuid[o.getGUID()] = key\nself.addAttachment(o)\nelse\no.destruct()\nend\nend, function() return o.loading_custom == false end, 15, function() pending[key] = nil o.destruct() end)\nend,\n})\nend\nfunction refreshRails(params)\nif RAILS_HOLD then return end\nlocal ex = params and params.exclude\nlocal list = {}\nlocal me = self.getPosition()\nlocal mw, md = localDims(self)\nlocal reach = math.sqrt(mw * mw + md * md) * U / 2 + 1\nlocal function near(o)\nlocal p = o.getPosition()\nlocal ow, od = localDims(o)\nlocal r = reach + math.sqrt(ow * ow + od * od) * U / 2\nreturn (p.x - me.x) ^ 2 + (p.z - me.z) ^ 2 < r * r\nend\nif not (FLAT or NO_RAILS) then\nfor _, o in ipairs(seatModules()) do\nif o ~= self and o.getGUID() ~= ex and not isHeld(o) and near(o) and sameYaw(o, self) and not o.getVar(\"FLAT\") then\nlist[#list + 1] = o\nend\nend\nfor _, o in ipairs(marginPieces()) do            -- (the middle's wood margin: a neighbour like a module)\nif o ~= self and o.getGUID() ~= ex and near(o) then list[#list + 1] = o end\nend\nend\nlocal plan = (FLAT or NO_RAILS) and {} or railPlan(trayRailFeet(list))\nlocal want = {}\nfor k in pairs(plan) do want[k] = true end\nwanted = want\nlocal have = attachedRails()\nlocal drop = {}\nfor k, idx in pairs(have) do if not want[k] then drop[#drop + 1] = idx end end\ntable.sort(drop, function(a, b) return a > b end)\nfor _, idx in ipairs(drop) do\nlocal o = self.removeAttachment(idx)\nif o then railGuid[o.getGUID()] = nil o.destruct() end\nend\nfor k, p in pairs(plan) do\nif have[k] == nil and not pending[k] then spawnRail(k, p) end\nend\nend\nlocal function extraTag(i) return \"trayExtra:\" .. self.getGUID() .. \":\" .. i end\nlocal function extrasByTag()\nlocal t = {}\nfor _, o in ipairs(getObjects()) do\nlocal n = o.getGMNotes() or \"\"\nif n:sub(1, 10) == \"trayExtra:\" then t[n] = o end\nend\nreturn t\nend\nlocal function extraPos(e)\nlocal p = self.positionToWorld({e.x or 0, (FLAT and 0.2 or TOP) + (e.y or 0), e.z or 0})\nif e.kind == \"hidden\" then p = {x = p.x, y = p.y + (e.h or 4) / 2, z = p.z} end   -- the zone stands centred on it\nreturn p\nend\nfunction syncExtras()\nif not CFG.extras or #CFG.extras == 0 then return end\nlocal have = extrasByTag()\nlocal r = self.getRotation()\nfor i, e in ipairs(CFG.extras) do\nlocal tag = extraTag(i)\nlocal o = have[tag]\nlocal pos = extraPos(e)\nif o then\no.setPosition(pos)\no.setRotation({0, r.y + (e.yaw or 0), 0})\nelseif e.kind == \"hidden\" then\nspawnObjectData({data = {Name = \"FogOfWarTrigger\", GMNotes = tag, FogColor = CFG.seat, FogHidePointers = false,\nFogReverseHiding = false, FogSeethrough = false, Locked = true,     -- (unlocked, a zone falls like an object)\nTransform = {posX = 0, posY = 0, posZ = 0, rotX = 0, rotY = 0, rotZ = 0, scaleX = e.w, scaleY = e.h or 4, scaleZ = e.d},\nColorDiffuse = {r = 0.2, g = 0.2, b = 0.2, a = 0.3}}, position = pos, rotation = {0, r.y, 0}})\nelseif e.kind == \"object\" then\nlocal data = JSON.decode(JSON.encode(e.data))\ndata.GMNotes = tag\ndata.Locked = true\nspawnObjectData({data = data, position = pos, rotation = {0, r.y + (e.yaw or 0), 0}})\nend\nend\nend\nfunction removeExtras()\nif not CFG.extras or #CFG.extras == 0 then return end\nlocal have = extrasByTag()\nfor i = 1, #(CFG.extras or {}) do\nlocal o = have[extraTag(i)]\nif o then o.destruct() end\nend\nend\nlocal function refreshSeat()\nif SHARED and CFG.controller and marginSync then marginSync() end   -- (the wood margin first: rails count it)\nfor _, o in ipairs(seatModules()) do\no.call(\"refreshRails\", {})\no.call(\"syncExtras\")\no.call(\"featuresMoved\")                          -- features re-anchor (e.g. the coin zone follows GROSCHEN)\nend\nfor _, o in ipairs(marginPieces()) do o.call(\"refreshRails\", {}) end\nif SHARED then                                     -- the Setup Controller re-reads its spots (spawn, quests, storylines ...)\nlocal c = getObjectFromGUID(\"dd652d\")\nif c then pcall(function() c.call(\"middleMoved\") end) end\nend\nend\nFLAT = false\nfunction setStyle(p