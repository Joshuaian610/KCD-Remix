entory_\" .. CFG.seat}}\nif horse then sources[#sources + 1] = {horse, \"HorseInventory\"} end\nsources[#sources + 1] = {board, \"InventoryRed_\" .. CFG.seat}\nfor _, src in ipairs(sources) do\nlocal obj, tag = src[1], src[2]\nfor _, r in ipairs(NF.slotPairs(obj, tag)) do\nlocal pair = {{r[1], r[2]}, {r[2], r[1]}}\nfor _, pq in ipairs(pair) do\nlocal p, q = pq[1], pq[2]\nif p then\nlocal cz = q and q.z or (p.z + 0.75)\nlocal cx = q and (p.x + (p.x - q.x) * 0.21) or p.x\nlocal info = q and {(p.x + q.x) / 2, p.y, p.z + (p.z - q.z) * 1.1} or {p.x - 0.55, p.y, p.z + 0.45}\nout[#out + 1] = {w = obj.positionToWorld(p), corner = obj.positionToWorld({cx, p.y, cz}),\ninfo = obj.positionToWorld(info), red = tag:find(\"Red\") ~= nil, horse = obj == horse}\nif q then out[#out].pw = obj.positionToWorld(q) end   -- (the box's other circle: NF.invIconPair)\nend\nend\nend\nend\nreturn out\nend\nfunction NF.invTokens(board, slots)\nlocal out = {}\nfor _, o in ipairs(getObjectsWithAnyTags({\"MeatToken\", \"MushroomToken\", \"FlowerToken\"})) do\nif not isHeld(o) and not o.isSmoothMoving() then\nlocal p = o.getPosition()\nfor i, s in ipairs(slots) do\nif NF.flat2(p, s.w) < 0.5 and math.abs(p.y - s.w.y) < 1.2 then\nlocal w = NF.invWorth(o)\nif w then out[#out + 1] = {o = o, worth = w, slot = i} end\nbreak\nend\nend\nend\nend\nreturn out\nend\nNF.SNAP_TTL = 20\nNF.SNAPC = {}\nfunction NF.snaps(obj)\nlocal g = obj.getGUID()\nlocal now = os.clock()\nlocal c = NF.SNAPC[g]\nif c and now >= c.t and now - c.t < NF.SNAP_TTL then return c.list, c end\nlocal old = {}                                 -- (entries past their time go: e.g. a card that left the table)\nfor k, e in pairs(NF.SNAPC) do if now < e.t or now - e.t >= NF.SNAP_TTL then old[#old + 1] = k end end\nfor _, k in ipairs(old) do NF.SNAPC[k] = nil end\nlocal list = obj.getSnapPoints() or {}\nif #list > 0 then NF.SNAPC[g] = {t = now, list = list, made = {}} end\nreturn list, NF.SNAPC[g]\nend\nfunction NF.snapMade(obj, key, fn)\nlocal 