\"), n(\"Speech\"), n(\"Universal\"), n(\"Hunger\"), n(\"Movement\"))\nend\nfunction NF.hrDraw(i)                            -- line i as it was: everything in place, a move walked\nlocal view = NF.HIST.view or NF.histView()\nlocal n = #view\nif n == 0 then NF.hrSet(\"hrTitle\", \"text\", \"Nothing yet this game.\") return end\ni = math.max(1, math.min(n, i))\nlocal pin = NF.HIST.pin                         -- (the focus moved off a pinned line: it goes, the view is rebuilt)\nif pin and not (view[i].seat == pin.seat and view[i].seq == pin.seq) then\nlocal it = view[i]\nNF.HIST.pin = nil\nview = NF.histView()\nn = #view\nfor k, v in ipairs(view) do if v.seat == it.seat and v.seq == it.seq then i = k end end\nend\nNF.HR.i = i\nlocal it = view[i]\nlocal who = it.seat\nlocal s = it.snap\nlocal line = (it.line or \"\"):gsub(\"<[^>]*>\", \"\")\nlocal tag = (who ~= CFG.seat) and (\"[\" .. who:upper() .. \"]  \") or \"\"\nNF.hrSet(\"hrTitle\", \"text\", string.format(\"%d / %d    %s%s\", i, n, tag, line))\nNF.hrSet(\"hrNums\", \"text\", s and ((who ~= CFG.seat and (who .. \":   \") or \"\") .. NF.hrNums(s.v))\nor \"(no picture for this line: it is older than the replay)\")\nlocal function place(id, q)\nif q then NF.hrSet(id, \"position\", NF.hrMapAt(q[1], q[2])) NF.hrSet(id, \"active\", \"true\")\nelse NF.hrSet(id, \"active\", \"false\") end\nend\nfor _, c in ipairs(NF.SNAP_SEATS) do place(\"hrF\" .. c, s and s.f and s.f[c]) end\nfor k = 1, NF.HR_MAXB do\nlocal b = s and s.b and s.b[k]\nplace(\"hrB\" .. k, b and {b[2], b[3]})\nif b then NF.hrSet(\"hrB\" .. k, \"color\", NF.HR_SEAT_HEX[b[1]] or \"#FFFFFF\") end\nend\nfor k = 1, NF.HR_MAXE do place(\"hrE\" .. k, s and s.e and s.e[k]) end\nlocal path = s and s.path or {}\nfor k = 1, NF.HR_MAXP do\nplace(\"hrP\" .. k, path[k])\nif path[k] then NF.hrSet(\"hrP\" .. k, \"color\", (NF.HR_SEAT_HEX[who] or \"#FFFFFF\") .. \"CC\") end\nend\nNF.HR.anim = NF.HR.anim + 1\nlocal me = NF.HR.anim\nif #path >= 2 then\nlocal seg, f = 1, 0\nlocal function tick()\nif me ~= NF.HR.anim or not NF.HR.on then return end\nf = f + 1\nlocal a, b = path[seg], path[seg + 1]\nlocal t = f / 5\nNF.hrSet(\"hrF\" .. who, \"position\", NF.hrMapAt(a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t))\nif f >= 5 then seg, f = seg + 1, 0 end\nif seg < #path then Wait.time(tick, 0.05) else NF.hrNextLater(me) end\nend\nNF.hrSet(\"hrF\" .. who, \"active\", \"true\")\ntick()\nelse\nNF.hrNextLater(me)\nend\nend\nfunction NF.hrNextLater(me)                      -- playing: the next line after a moment\nif not NF.HR.playing then return end\nWait.time(function()\nif me ~= NF.HR.anim or not NF.HR.playing or not NF.HR.on then return end\nif NF.HR.i >= #(NF.HIST.view or NF.histView()) then\nNF.HR.playing = false\nNF.hrSet(\"hrPlay\", \"text\", \"Play\")\nreturn\nend\nNF.hrDraw(NF.HR.i + 1)\nend, 1.2)\nend\nfunction historyReplay()                         -- (the expanded window's Replay button) anyone may look\nif CFG.name ~= \"HISTORY\" or not NF.HIST.big then return end\nNF.HR.on, NF.HR.playing = true, false\nNF.hrShowParts(true)\nNF.hrSet(\"hreplay\", \"active\", \"false\")\nNF.hrSet(\"hrPlay\", \"text\", \"Play\")\nlocal v = NF.histView()                         -- (it starts at the line in focus: the list's bottom one)\nNF.hrDraw(math.max(1, #v - (NF.HIST.off or 0)))\nend\nfunction historyReplayClose()\nNF.HR.on, NF.HR.playing = false, false\nNF.HR.anim = NF.HR.anim + 1\nNF.hrShowParts(false)\nNF.hrSet(\"hreplay\", \"active\", tostring(NF.HIST.big == true))\nlocal v = NF.HIST.view or NF.histView()        -- (back to the list: the replay's line at its bottom)\nNF.HIST.off = math.max(0, #v - (NF.HR.i or #v))\nNF.histRender()\nend\nfunction historyReplayPlay()\nif not NF.HR.on then return end\nNF.HR.playing = not NF.HR.playing\nNF.hrSet(\"hrPlay\", \"text\", NF.HR.playing and \"Pause\" or \"Play\")\nif NF.HR.playing then\nif NF.HR.i >= #(NF.HIST.view or NF.histView()) then NF.hrDraw(1) else NF.hrDraw(NF.HR.i + 1) end\nend\nend\nfunction historyReplayPrev() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(NF.HR.i - 1) end end\nfunction historyReplayNext() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(NF.HR.i + 1) end end\nfunction historyReplayFirst() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(1) end end\nfunction historyReplayLast() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(#(NF.HIST.view or NF.histView())) end end\nfunction historyGrow()                           -- the toggle (anyone may look closer: it changes nothing in the game)\nif CFG.name ~= \"HISTORY\" then return end\nif NF.HR.on then historyReplayClose() end       -- (the replay only lives in the big window)\nNF.HIST.big = not NF.HIST.big\nNF.hrSet(\"hreplay\", \"active\", tostring(NF.HIST.big == true))\nlocal s = NF.histSize()\nlocal p = NF.histLayout(s)\npcall(function()\nself.UI.setAttribute(\"hpanel\", \"position\", p.panel)\nself.UI.setAttribute(\"hpanel\", \"width\", tostring(s.w))\nself.UI.setAttribute(\"hpanel\", \"height\", tostring(s.h))\nself.UI.setAttribute(\"hlines\", \"position\", p.text)\nself.UI.setAttribute(\"hlines\", \"width\", tostring(p.tw))\nself.UI.setAttribute(\"hlines\", \"height\", tostring(p.th))\nself.UI.setAttribute(\"hlines\", \"fontSize\", tostring(s.font))\nself.UI.setAttribute(\"hup\", \"position\", p.up)\nself.UI.setAttribute(\"hdown\", \"position\", p.down)\nself.UI.setAttribute(\"hinfo\", \"position\", p.info)\nself.UI.setAttribute(\"hgrow\", \"image\", NF.HIST.big and \"hshrink\" or \"hexpand\")\nend)\nNF.HIST_LINE_H = s.line\nNF.histRender()\nend\nfunction NF.histSetup()\nif CFG.name ~= \"HISTORY\" or IS_COPY then return end\nlocal files = CFG.files or {}\npcall(function()                               -- the toggle's two icons (playercubes\\tray_new_modules_v1)\nself.UI.setCustomAssets({{name = \"hexpand\", url = files[\"history_expand_v1.png\"] or \"\"},\n{name = \"hshrink\", url = files[\"history_shrink_v2.png\"] or \"\"},\n{name = \"hrmap\", url = files[\"history_map_v1.jpg\"] or \"\"},   -- (the replay's small map)\n{name = \"hrfig\", url = files[\"history_fig_v1.png\"] or \"\"},   -- (and its icons)\n{name = \"hrbed\", url = files[\"history_bed_v1.png\"] or \"\"},\n{name = \"hrenemy\", url = files[\"history_enemy_v1.png\"] or \"\"}})\nend)\nNF.HIST_LINE_H = NF.histSize().line\nself.UI.setXml(NF.histXml())\nWait.time(function() NF.histRender() NF.histPull() end, 0.5)   -- (put out later: everything so far)\nend\nfunction NF.histKeeperSetup()                    -- (the keeper) where the figure stands, for the first move's line\nif CFG.name ~= NF.HIST_KEEPER or IS_COPY then return end\nlocal fig = getObjectsWithTag(\"PlayerFigure_\" .. CFG.seat)[1]\nif fig and not NF.HIST.space then NF.HIST.space = NF.spaceAt(fig.getPosition()) end\nend\nNF.HENRY_DAY = {{-74.07, -7.20, 45}, {-74.40, 7.02, 135}, {-59.83, 7.31, 225}}   -- (as the controller's: the user's layout)\nNF.HENRY_DECK = {-60.91, -16.72, 90}\nNF.TIME_BOARD_REF = {x = -67.0, z = 0.0, yaw = 90}\nfunction NF.timeBoardShift(s)\nlocal tb = getObjectsWithTag(\"TimeBoard\")[1]\nif not tb then return s[1], s[2], s[3] end\nlocal p, r = tb.getPosition(), tb.getRotation().y\nlocal d = math.rad(r - NF.TIME_BOARD_REF.yaw)\nlocal dx, dz = s[1] - NF.TIME_BOARD_REF.x, s[2] - NF.TIME_BOARD_REF.z\nlocal c, sn = math.cos(d), math.sin(d)\nreturn p.x + dx * c + dz * sn, p.z - dx * sn + dz * c, (s[3] + r - NF.TIME_BOARD_REF.yaw) % 360\nend\nfunction NF.henryDeck()\nlocal a = NF.anchor(\"deck\")\nif a and CFG.name == \"HENRY\" then\nlocal h = math.max(NF.SIZE.henryDeck[1], NF.SIZE.henryDeck[2]) / 2 + 0.3   -- (v6: the card lies the other way)\nlocal p = NF.pileIn(self, a.x, a.z, h, h)\nif p then return p end\nend\nlocal hd = NF.controllerTable(\"HENRY_DECK\") or NF.HENRY_DECK\nlocal x, z = NF.timeBoardShift(hd)\nlocal p = NF.pileAtWorld(x, z, 2)\nif p then return p end\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Deck\" and o.getName() == \"Solo Deck (Henry)\" and not isHeld(o) then return o end\nend\nend\nfunction NF.henryDaySpots()\nlocal out = {}\nif CFG.name == \"HENRY\" then\nfor i = 1, 3 do\nlocal w, yaw = anchorWorld({name = \"day\" .. i}), anchorYaw({name = \"day\" .. i})\nif not (w and yaw) then out = {} break end\nout[i] = {w.x, w.z, yaw, y = w.y}\nend\nif #out == 3 then return out end\nend\nfor i, s in ipairs(NF.controllerTable(\"HENRY_DAY\") or NF.HENRY_DAY) do\nlocal x, z, yaw = NF.timeBoardShift(s)\nout[i] = {x, z, yaw}\nend\nreturn out\nend\nfunction NF.henryDeal(color)\nNF.serial(function()\nlocal todo = {}\nfor i, s in ipairs(NF.henryDaySpots()) do\nif not NF.pileAtWorld(s[1], s[2], 1.5) then todo[#todo + 1] = {i = i, x = s[1], z = s[2], yaw = s[3], y = s.y} end\nend\nif #todo == 0 then NF.tell(color, \"Henry's 3 day cards are already out.\") return end\nlocal dealt = 0\nlocal function one(k)\nif k > #todo then\nbroadcastToAll(\"[FFFFFF][HENRY][-] \" .. dealt .. \" day card\" .. (dealt == 1 and \"\" or \"s\") .. \" laid out face down\", {1, 1, 1})\nif dealt < #todo then NF.tell(color, \"Henry's action deck is empty (\" .. dealt .. \" of \" .. #todo .. \" dealt).\") end\nreturn\nend\nlocal d = NF.henryDeck()\nif not d then one(#todo + 1) return end\nlocal s = todo[k]\nlocal pos, rot = {s.x, NF.henryDrop(s.y), s.z}, {0, s.yaw, 180}\nif d.type == \"Deck\" then d.takeObject({position = pos, rotation = rot, smooth = true})\nelse d.setPositionSmooth(pos, false, true) d.setRotationSmooth(rot, false, true) end\ndealt = dealt + 1\nWait.time(function() one(k + 1) end, 0.3)\nend\none(1)\nend, 1.5)\nend\nfunction nfHenryDay(_, color) NF.henryDeal(color) end\nNF.HENRY_LIFT = 0                               -- (user, 2026-11-05: \"way too high\" at 1.0 - on the module like the others)\nNF.HENRY_CARD_Y = 1.9                           -- his cards appear this high over a well (they lie at 1.68), then drop\nfunction NF.henryDrop(y) return math.max(NF.HENRY_CARD_Y, (y or 0) + 0.12) end\nfunction NF.henrySpot(name)                     -- a HENRY well in the world: {x, y, z, yaw}, or nil\nlocal w = anchorWorld({name = name})\nif not w then return nil end\nreturn {x = w.x, y = w.y, z = w.z, yaw = anchorYaw({name = name}) or NF.cardYaw()}\nend\nfunction NF.henryToDiscard(og, pg, dis, top)\nlocal old = getObjectFromGUID(og)\nif not old then return end\nlocal pile = pg and getObjectFromGUID(pg) or nil\nlocal done = false\nif pile then\ndone = pcall(function()\nlocal cd, data = old.getData(), pile.getData()\nif type(cd) ~= \"table\" or type(data) ~= \"table\" or cd.CardID == nil or data.Transform == nil then error(\"no card data\") end\ncd.Locked = false\nif data.Name ~= \"Deck\" and data.Name ~= \"DeckCustom\" then\nif data.CardID == nil then error(\"not a card\") end\ndata = {Name = \"Deck\", Transform = data.Transform, Nickname = \"\", Description = \"\", Locked = false,\nDeckIDs = {data.CardID}, CustomDeck = data.CustomDeck or {}, ContainedObjects = {data}}\nend\ndata.ContainedObjects, data.DeckIDs, data.CustomDeck = data.ContainedObjects or {}, data.DeckIDs or {}, data.CustomDeck or {}\nlocal z = (data.Transform.rotZ or 0) % 360\nlocal at = (z > 90 and z < 270) and 1 or (#data.ContainedObjects + 1)\ntable.insert(data.ContainedObjects, at, cd)\ntable.insert(data.DeckIDs, at, cd.CardID)\nfor k, v in pairs(cd.CustomDeck or {}) do data.CustomDeck[k] = v end\ndestroyObject(old)\ndestroyObject(pile)\nspawnObjectData({data = data})\nend)\nend\nif not done then                               -- (no pile there, or no card data: put down / dropped from above)\nold.setLock(false)\nold.setPositionSmooth({dis.x, NF.henryDrop(pile and top or dis.y) + (pile and 0.3 or 0), dis.z}, false, true)\nend\nend\nfunction NF.henryNext(color)\nNF.serial(function()\nlocal cur, dis = NF.henrySpot(\"current\"), NF.henrySpot(\"discard\")\nif not (cur and dis) then return end\nlocal nxt = nil\nfor i = 1, 3 do\nlocal s = NF.henrySpot(\"day\" .. i)\nnxt = s and NF.pileAtWorld(s.x, s.z, 2)\nif nxt then break end\nend\nif not nxt then NF.tell(color, \"Henry's day cards are all used: the predawn lays out new ones.\") return end\nlocal old = NF.pileAtWorld(cur.x, cur.z, 2)\nif old then                                  -- onto his discard pile, face up, on top of it\nlocal henryTop, henryPile = dis.y, nil\nfor _, o in ipairs(getObjects()) do\nif o ~= old and NF.isPile(o) and not o.held_by_color then\nlocal p = o.getPosition()\nif (p.x - dis.x) ^ 2 + (p.z - dis.z) ^ 2 < 4 and p.y < 8 then\nlocal b = o.getBounds()\nlocal t = b.center.y + b.size.y / 2\nif t >= henryTop then henryTop, henryPile = t, o end\nend\nend\nend\nlocal og, pg, ht = old.getGUID(), henryPile and henryPile.getGUID() or nil, henryTop\nold.setLock(true)\nold.setRotationSmooth({0, dis.yaw, 0}, false, true)\nold.setPositionSmooth({dis.x, NF.henryDrop(henryTop) + 0.6, dis.z}, false, true)\nWait.time(function() NF.henryToDiscard(og, pg, dis, ht) end, 0.8)\nend\nnxt.setPositionSmooth({cur.x, NF.henryDrop(cur.y), cur.z}, false, true)\nnxt.setRotationSmooth({0, cur.yaw, 0}, false, true)\nlocal g = nxt.getGUID()\nWait.time(function()\nlocal c = getObjectFromGUID(CFG.setupGuid or NF.SETUP_GUID)\nif c then pcall(function() c.call(\"henryFigureTo\", {guid = g}) end) end\nend, 0.6)\nbroadcastToAll(\"[FFFFFF][HENRY][-] next action card\", {1, 1, 1})\nend, 1.0)\nend\nfunction nfHenryNext(_, color) NF.henryNext(color) end\nNF.POTION_BASE = \"\"\nNF.POTIONS = {\n{\"Padfoot\", \"potion_01_padfoot_v1.jpg\", \"White\"}, {\"Bard Potion\", \"potion_02_bard_potion_v1.jpg\", \"White\"},\n{\"Amor\", \"potion_03_amor_v1.jpg\", \"White\"},\n{\"Bivoj's Rage\", \"potion_04_bivojs_rage_v1.jpg\", \"Red\"}, {\"Dollmaker Potion\", \"potion_05_dollmaker_potion_v1.jpg\", \"Red\"},\n{\"Lethean Water\", \"potion_06_lethean_water_v1.jpg\", \"Red\"},\n{\"Bowman's Brew\", \"potion_07_bowmans_brew_v1.jpg\", \"Yellow\"}, {\"Aesop Potion\", \"potion_08_aesop_potion_v1.jpg\", \"Yellow\"},\n{\"Artemisia\", \"potion_09_artemisia_v1.jpg\", \"Yellow\"},\n{\"Marigold Decoction\", \"potion_10_marigold_decoction_v1.jpg\", \"Orange\"}, {\"Lazarus Potion\", \"potion_11_lazarus_potion_v1.jpg\", \"Orange\"},\n{\"Moonshine\", \"potion_12_moonshine_v1.jpg\", \"Orange\"},\n{\"Bane Potion\", \"potion_13_bane_potion_v1.jpg\", \"Blue\"}, {\"Nighthawk\", \"potion_14_nighthawk_v1.jpg\", \"Blue\"},\n{\"Saviour Schnapps\", \"potion_15_saviour_schnapps_v1.jpg\", \"Blue\"},\n}\nNF.POT_K = 0.8\nNF.POT = {cols = 5, rows = 3, cw = 4.6 * NF.POT_K, ch = 4.6 * NF.POT_K * 427 / 660, gap = 0.3 * NF.POT_K,\nmargin = 0.45 * NF.POT_K, thick = 0.2, hover = 3.0, side_gap = 0.4, tint = {0.11, 0.08, 0.05}}\nNF.POT_LANGS = {de = true, es = true, ru = true, fr = true, zh = true}\nNF.potLangGuid = nil\nfunction NF.potLang()\nlocal o = NF.potLangGuid and getObjectFromGUID(NF.potLangGuid)\nif not o then\nNF.potLangGuid = nil\nfor _, x in ipairs(getObjects()) do\nif x.getName() == \"Language (controller)\" then o, NF.potLangGuid = x, x.getGUID() break end\nend\nend\nif not o then return \"en\" end\nlocal ok, st = pcall(function() return o.getTable(\"state\") end)\nlocal code = ok and type(st) == \"table\" and st.lang or \"en\"\nreturn NF.POT_LANGS[code] and code or \"en\"\nend\nfunction NF.potFile(i, code)\nlocal f = NF.POTIONS[i][2]\nif code and code ~= \"en\" then f = f:gsub(\"_v1%.jpg$\", \"_\" .. code .. \"_v1.jpg\") end\nreturn f\nend\nNF.POT_TAG = \"kcdPotionBoard:\"                  -- the board's GM notes: tag .. seat (found again if its GUID changed)\nNF.potGuid = nil\nNF.POT_SHOP = {g = \"d26293\", x = 50.75, z = -0.945, ry = 270}\nNF.POT_SPOTS, NF.POT_SPOT_Z, NF.POT_NEAR = {53.926, 49.907, 45.879, 41.867, 37.848}, -9.856, 2.0\nNF.POT_STRIP, NF.POT_FRAME, NF.POT_DIM, NF.POT_WATCH = 1.0 * NF.POT_K, 0.14 * NF.POT_K, {0, 0, 0, 0.5}, 1.5\nNF.POT_FRAME_COLOUR = {1.0, 0.80, 0.30, 1}\nNF.potAll = false                               -- true: all 15 (the strip's button), else the laid ones only\nNF.POT_ALWAYS_ALL = true                        -- (user, 2026-11-05) always all 15, no strip / \"Show all recipes\"\nNF.potShown, NF.potTick = nil, 0\nfunction NF.potSize(rows, strip)\nlocal P = NF.POT\nlocal n = rows or P.rows\nreturn P.cols * P.cw + (P.cols - 1) * P.gap + 2 * P.margin, n * P.ch + (n - 1) * P.gap + 2 * P.margin + (strip or 0)\nend\nfunction NF.potLaid()\nlocal laid, n = {}, 0\nlocal r = NF.POT_SHOP\nlocal shop = getObjectFromGUID(CFG.shopGuid or r.g)\nif not shop then return laid, 0 end\nlocal p, a = shop.getPosition(), math.rad(shop.getRotation().y - r.ry)\nlocal spots = {}\nfor i, x in ipairs(NF.POT_SPOTS) do\nlocal dx, dz = x - r.x, NF.POT_SPOT_Z - r.z\nspots[i] = {x = p.x + dx * math.cos(a) + dz * math.sin(a), z = p.z - dx * math.sin(a) + dz * math.cos(a)}\nend\nlocal byName = {}\nfor i, q in ipairs(NF.POTIONS) do byName[q[1]:lower()] = i end\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Card\" then\nlocal op, near = o.getPosition(), false\nfor _, s in ipairs(spots) do\nif NF.flat2(op, s) < NF.POT_NEAR ^ 2 then near = true break end\nend\nif near then\nlocal i = byName[(o.getName() or \"\"):lower()]\nif not i then\nlocal ok, d = pcall(function() return o.getData() end)\nlocal id = ok and d and tonumber(d.CardID) or nil\nif id and id % 100 < #NF.POTIONS then i = id % 100 + 1 end\nend\nif i and not laid[i] then laid[i], n = true, n + 1 end\nend\nend\nend\nreturn laid, n\nend\nfunction NF.potKey(laid)\nlocal t = {}\nfor i = 1, #NF.POTIONS do if laid[i] then t[#t + 1] = i end end\nreturn table.concat(t, \",\") .. (NF.potAll and \"|all\" or \"\") .. \"|\" .. NF.potLang()\nend\nfunction NF.potLayout(laid, n, all)\nlocal P, cells = NF.POT, {}\nif n == 0 or all or NF.POT_ALWAYS_ALL then    -- (all 15: the laid ones framed, the others dimmed; no strip)\nfor i = 1, #NF.POTIONS do\ncells[#cells + 1] = {i = i, c = math.floor((i - 1) / P.rows), r = (i - 1) % P.rows,\ndim = n > 0 and not laid[i], frame = n > 0 and laid[i] or false}\nend\nreturn cells, P.rows, (n > 0 and not NF.POT_ALWAYS_ALL) and NF.POT_STRIP or 0\nend\nlocal rows, inCol = 1, {}\nfor i = 1, #NF.POTIONS do\nif laid[i] then\nlocal c = math.floor((i - 1) / P.rows)\ninCol[c] = (inCol[c] or 0) + 1\nrows = math.max(rows, inCol[c])\ncells[#cells + 1] = {i = i, c = c, r = inCol[c] - 1, dim = false, frame = false}\nend\nend\nreturn cells, rows, NF.POT_STRIP\nend\nfunction NF.isPotBoard(o) return o ~= nil and o.getGMNotes() == NF.POT_TAG .. CFG.seat and not o.isDestroyed() end\nfunction NF.potBoard()\nlocal o = NF.potGuid and getObjectFromGUID(NF.potGuid)\nif NF.isPotBoard(o) then return o end\nNF.potGuid = nil\nreturn nil\nend\nfunction NF.potSpot()\nlocal p, yaw = self.getPosition(), self.getRotation().y\nlocal half = 1.4\nlocal ok, b = pcall(function() return self.getBoundsNormalized() end)\nif ok and b and b.size then\nlocal q = math.floor((yaw % 180) / 45 + 0.5) % 4   -- (turned by about 90: the module's width is along world z)\nhalf = ((q == 1 or q == 2) and b.size.z or b.size.x) / 2\nend\nlocal W = NF.potSize()\nlocal d = -(half + NF.POT.side_gap + W / 2)\nlocal a = math.rad(yaw)\nreturn {p.x + d * math.cos(a), p.y + NF.POT.hover, p.z - d * math.sin(a)}, yaw\nend\nfunction NF.potDress(o)\nif NF.dead or not NF.isPotBoard(o) then return end\nlocal laid, n = NF.potLaid()\nNF.potShown = NF.potKey(laid)\nlocal cells, rows, strip = NF.potLayout(laid, n, NF.potAll)\nlocal P, W, H = NF.POT, NF.potSize(rows, strip)\nlocal s = o.getScale()\nlocal ok, b = pcall(function() return o.getBoundsNormalized() end)\nlocal nx, ny, nz = 1, 1, 1\nif ok and b and b.size and b.size.x > 0 then\nnx, ny, nz = b.size.x / s.x, b.size.y / s.y, b.size.z / s.z\nif nx < 0.2 or nx > 5 or ny < 0.2 or ny > 5 or nz < 0.2 or nz > 5 then nx, ny, nz = 1, 1, 1 end\nend\nif math.abs(s.x * nx - W) > 0.01 or math.abs(s.y * ny - P.thick) > 0.01 or math.abs(s.z * nz - H) > 0.01 then\no.setScale({W / nx, P.thick / ny, H / nz})   -- (W x