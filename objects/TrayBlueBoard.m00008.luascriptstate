 = D * I.share\nlocal rc = D / 2 + sz / 2 + D * I.gap\nlocal step = 2 * math.asin(math.min(1, (sz + D * I.space) / (2 * rc)))\nlocal a0 = math.rad(top and I.top or I.bottom)\nlocal urls = NF.INV_ICON_URL[CFG.seat] or NF.INV_ICON_URL.Blue\nNF.INV.idec = NF.INV.idec or {}\nlocal ordered = {}\nfor _, a in ipairs(acts) do if a[1] ~= \"sell\" then ordered[#ordered + 1] = a end end\nfor _, a in ipairs(acts) do if a[1] == \"sell\" then ordered[#ordered + 1] = a end end\nacts = ordered\nlocal dir = I.dir\nlocal n = 0\nfor j, a in ipairs(acts) do\nlocal fn = \"nfInv\" .. a[1] .. k\nNF.INV.btns[fn] = t.o.getGUID()\nlocal ang = a0 + (#acts - j) * step * dir\nlocal sn, cs = math.sin(ang), math.cos(ang)\nlocal w = {x = c.x + rc * (sn * rx + cs * ux), y = c.y, z = c.z + rc * (sn * rz + cs * uz)}\nlocal url = urls and urls[a[1]] or nil\nif url then\nlocal q = self.positionToLocal(w)\nlocal sure = NF.PEND and NF.PEND.fn == fn and os.clock() <= NF.PEND.till   -- (rebuilt while it asks: it keeps asking)\nlocal name = \"invi_\" .. k .. \"_\" .. j\nNF.INV.iconOf = NF.INV.iconOf or {}\nNF.INV.iconOf[fn] = {name = name, url = url}\nNF.INV.idec[#NF.INV.idec + 1] = NF.invDecal(name, sure and NF.INV_ICON_CONFIRM or url, q, sz, sz)\nlocal lab = NF.INV_LABEL_URL and NF.INV_LABEL_URL[a[1] .. (top and \"_b\" or \"_t\")]\nif lab then\nlocal lk = NF.INV_LABEL_K or 1.75\nNF.INV.idec[#NF.INV.idec + 1] = NF.invDecal(name .. \"_l\", lab, {x = q.x, y = q.y - 0.002, z = q.z}, sz * lk, sz * lk)\nend\nlocal px = math.floor(sz * NF.BTN_PX * 0.96)\nself.createButton(__sharpB({click_function = fn, function_owner = self, label = \"\", tooltip = a[3],\nposition = {-q.x, q.y + 0.25, q.z}, rotation = {0, 180, 0}, width = px, height = px,\ncolor = {1, 1, 1, 0}, hover_color = {1, 1, 1, 0.15}, press_color = {1, 1, 1, 0.3}, font_color = {1, 1, 1, 1}}, true))\nelse\nNF.invBtn(fn, a[2], w, a[3])               -- (no picture for this seat: the word, at the icon's place)\nend\nn = n + 1\nend\nreturn n\nend\nfunction NF.invShow(board)\nlocal slots = NF.invSlots(board)\nlocal toks = NF.invTokens(board, slots)\nlocal boxes = NF.invBoxes(board, slots)\nlocal items = NF.invItems(board, boxes)\nlocal sig = {}\nfor _, t in ipairs(toks) do sig[#sig + 1] = t.o.getGUID() .. t.slot .. (NF.faceDown(t.o) and \"d\" or \"u\") end\nlocal ncubes = {}\nfor k, it in ipairs(items) do\nif NF.CUBES[it.o.getName()] then ncubes[k] = #NF.cubesOn(it.o, board) end\nsig[#sig + 1] = \"i\" .. it.o.getGUID() .. it.box .. (it.equipped and \"e\" or \"\") .. (ncubes[k] or \"\")\nend\nsig[#sig + 1] = \"fix\" .. ((NF.FIXM and NF.FIXM.kit) or \"\")   -- (the item in use for fixing shows no buttons of its own)\nlocal pelts = NF.invPelts(board)\nfor _, a in ipairs(pelts) do\nlocal p = a.o.getPosition()\nsig[#sig + 1] = \"a\" .. a.o.getGUID() .. math.floor(p.x * 4) .. \":\" .. math.floor(p.z * 4)\nend\ntable.sort(sig)\nsig = table.concat(sig, \",\")\nlocal have = 0                                 -- (a menu redraw may have cleared them)\nfor _, b in ipairs(self.getButtons() or {}) do\nif b.click_function:find(\"^nfInv\") and b.click_function ~= \"nfInvSort\" then have = have + 1 end\nend\nif NF.INV.shown and sig == NF.INV.sig and have == (NF.INV.nb or 0) then return end\nNF.invClear()\nNF.INV.sig = sig\nlocal yaw = math.rad(board.getRotation().y)\nlocal function along(w, d)                     -- d up the player's view (board-local -z), world\nreturn {x = w.x + d * math.sin(yaw) * -1, y = w.y, z = w.z + d * math.cos(yaw) * -1}\nend\nlocal qdecals = {}                             -- (the potions' \"?\" pictures)\nlocal under = {}                               -- (tokens under an item card get no buttons)\nNF.INV.eq, NF.INV.cube = {}, {}\nlocal nb = 0\nfor k, it in ipairs(items) do\nfor _, c in ipairs(boxes[it.box].circles) do under[c] = true end\nlocal row = 0\nlocal function cardBtn(fn, label, tip, wid)\nNF.invBtn(fn, label, NF.cardPoint(it.o, NF.CARD_BTN.u, NF.CARD_BTN.v + row * NF.CARD_BTN.dv, 0.1), tip, wid)\nrow, nb = row + 1, nb + 1\nend\nif it.slot and k <= NF.INV.CARDS then                   -- equipment (any box): EQUIP / UNEQUIP\nNF.INV.eq[k] = it.o.getGUID()\ncardBtn(\"nfInvEq\" .. k, it.equipped and \"UNEQUIP\" or \"EQUIP\",\nit.equipped and (\"Unequip \" .. it.o.getName() .. \": SORT may move it again\")\nor (it.own and (\"Equip \" .. it.o.getName() .. \" here: SORT leaves it in its box\"))\nor (\"Equip \" .. it.o.getName() .. \": into its box \" .. it.slot .. \", swapped with what lies there\"), 400)\nend\nlocal spec = NF.CUBES[it.o.getName()]\nif NF.FIXM and NF.FIXM.kit == it.o.getGUID() then spec = nil end\nif spec and (ncubes[k] or 0) > 0 and k <= NF.INV.CARDS then   -- a card with cubes left: USE (READ for a book) | EAT ALL | SELL\nNF.INV.cube[k] = it.o.getGUID()\nlocal word = spec.word or (spec.book and \"READ\") or (spec.food and \"EAT\") or \"USE\"\ncardBtn(\"nfInvCuse\" .. k, word,\nword:sub(1, 1) .. word:sub(2):lower() .. \" \" .. it.o.getName() .. \": 1 cube off\"\n.. ((spec.gain and (\", \" .. NF.gainText(spec.gain))) or \"\")\n.. (spec.eat and (\", hunger +\" .. spec.eat) or \"\") .. \" (\" .. ncubes[k] .. \" left)\", 400)\nif spec.all and ncubes[k] == spec.n then   -- (user) the bag still full: EAT ALL\ncardBtn(\"nfInvCall\" .. k, \"EAT ALL\",\n\"Eat all of \" .. it.o.getName() .. \" at once: all \" .. spec.n .. \" cubes off, hunger +\" .. (spec.eat or 0) * spec.n\n.. \", and a Good card onto your discard pile\", 400)\nend\nif spec.sell then\ncardBtn(\"nfInvCsell\" .. k, \"SELL\", \"Sell \" .. it.o.getName() .. \": all \" .. ncubes[k] .. \" cubes, +\" .. NF.netPrice(it.o, spec.sell * ncubes[k]) .. \" Groschen\" .. NF.cutText(NF.markCount(it.o)), 400)\nelseif spec.bsell then                     -- (user, 2026-11-04) a book sells before it is read out, too\ncardBtn(\"nfInvCbsell\" .. k, \"SELL\", \"Sell \" .. it.o.getName() .. \" for \" .. NF.netPrice(it.o, spec.bsell)\n.. \" Groschen\" .. NF.cutText(NF.markCount(it.o)) .. \", unread pages and all (back under the Item Market Cards)\", 400)\nend\nelseif spec and ncubes[k] == 0 and it.o.hasTag(\"CubesGiven\") and k <= NF.INV.CARDS then\nNF.INV.cube[k] = it.o.getGUID()\ncardBtn(\"nfInvCrem\" .. k, \"DISCARD\", \"Discard the used-up \" .. it.o.getName() .. \" (back under the Item Market Cards)\", 400)\nif spec.bsell then\ncardBtn(\"nfInvCbsell\" .. k, \"SELL\", \"Sell \" .. it.o.getName() .. \" for \" .. NF.netPrice(it.o, spec.bsell) .. \" Groschen\" .. NF.cutText(NF.markCount(it.o)) .. \" (back under the Item Market Cards)\", 400)\nend\nend\nend\nfor k, t in ipairs(toks) do\nif k > NF.INV.max then break end\nif not under[t.slot] then\nlocal s, wv = slots[t.slot], t.worth\nlocal acts = {}\nif wv.eat then acts[#acts + 1] = {\"eat\", \"EAT\", \"Eat this \" .. wv.label .. \": hunger +\" .. wv.eat} end\nif wv.drink then acts[#acts + 1] = {\"drink\", \"DRINK\", \"Drink this \" .. wv.label} end\nacts[#acts + 1] = {\"sell\", \"SELL\", \"Sell this \" .. wv.label .. \" for \" .. wv.sell .. \" Groschen\"}\nnb = nb + NF.invIconPair(board, t, s, acts, k)   -- (owner 11-13: round icons round the token, NF.INV_ICON)\nif NF.INV_RECIPE_Q and wv.drink and s.info then   -- a potion: \"?\" in its colour shows that colour's recipe in play\nlocal fn = \"nfInvinfo\" .. k\nNF.INV.btns[fn] = t.o.getGUID()\nlocal q = self.positionToLocal(s.info)\nlocal tip = \"Show the \" .. wv.colour .. \" recipe in play (click the card to put it away)\"\nlocal d = NF.INV_Q * NF.BTN_K                -- (world units)\nself.createButton(__sharpB({click_function = fn, function_owner = self, label = \"\", tooltip = tip,\nposition = {-q.x, q.y + 0.25, q.z}, rotation = {0, 180, 0}, width = math.floor(d * NF.BTN_PX * 0.92),\nheight = math.floor(d * NF.BTN_PX * 0.92), color = {1, 1, 1, 0}, hover_color = {1, 1, 1, 0.12},\npress_color = {1, 1, 1, 0.25}}, true))\nnb = nb + 1\nqdecals[#qdecals + 1] = NF.invDecal(\"invq_\" .. k, NF.invIcon(\"potion_info_\" .. CFG.seat:lower() .. \"_\"\n.. (wv.colour or \"white\"):lower() .. \"_v1.png\"), q, d, d)\nend\nend                                          -- (not under an item card)\nend\nfor k, a in ipairs(pelts) do\nif k > NF.PELT_MAX then break end\nlocal name, v = a.name, a.value\nNF.INV.btns[\"nfInvAsell\" .. k], NF.INV.btns[\"nfInvAdisc\" .. k] = a.o.getGUID(), a.o.getGUID()\nNF.invBtn(\"nfInvAsell\" .. k, \"SELL\", NF.tileViewPoint(board, a.o, 0.48, 0.61),\n\"Sell this \" .. name .. \" for \" .. v .. \" Groschen (the tile goes into your trash)\", 300)\nNF.invBtn(\"nfInvAdisc\" .. k, \"DISCARD\", NF.tileViewPoint(board, a.o, 0.48, 0.77),\n\"Discard this \" .. name .. \" (into your trash, nothing gained)\", 300)\nnb = nb + 2\nend\nNF.decalsSet(\"invq_\", qdecals)\nNF.decalsSet(\"invi_\", NF.INV.idec or {})       -- (the tokens' round icons, NF.invIconPair)\nNF.INV.idec = {}\nNF.invSortEnsure(board)\nNF.INV.shown, NF.INV.nb = true, nb\nend\nNF.PELT = {stag = {\"Red Deer\", 18}, boar = {\"Wild Boar\", 14}, roe = {\"Roe Deer\", 9}, pheasant = {\"Pheasant\", 8},\nhare = {\"Hare\", 5}}\nNF.PELT_MAX = 8\nfunction NF.invPelts(board)                      -- the animal tiles lying in the inventory: {o, name, value}\nlocal out = {}\nfor _, o in ipairs(getObjectsWithTag(\"AnimalTile\")) do\nif not isHeld(o) and not o.isSmoothMoving() and NF.invInside(board, o.getPosition()) then\nfor kind, e in pairs(NF.PELT) do\nif o.hasTag(\"AnimalTile_\" .. kind) then out[#out + 1] = {o = o, name = e[1], value = e[2]} break end\nend\nend\nend\ntable.sort(out, function(a, b) return a.o.getGUID() < b.o.getGUID() end)\nreturn out\nend\nfunction NF.tileViewPoint(board, o, u, v)\nlocal c, b = o.getPosition(), o.getBoundsNormalized()\nlocal W, H = b.size.x, b.size.z\nif math.abs(((o.getRotation().y - board.getRotation().y) % 180) - 90) < 45 then W, H = b.size.z, b.size.x end\nlocal o0, ox, oz = board.positionToWorld({0, 0, 0}), board.positionToWorld({1, 0, 0}), board.positionToWorld({0, 0, 1})\nlocal rx, rz = {ox.x - o0.x, ox.z - o0.z}, {oz.x - o0.x, oz.z - o0.z}\nlocal lx = math.max(0.0001, math.sqrt(rx[1] ^ 2 + rx[2] ^ 2))\nlocal lz = math.max(0.0001, math.sqrt(rz[1] ^ 2 + rz[2] ^ 2))\nlocal du, dv = (u - 0.5) * W, (v - 0.5) * H\nreturn {x = c.x + rx[1] / lx * du + rz[1] / lz * dv, y = c.y, z = c.z + rx[2] / lx * du + rz[2] / lz * dv}\nend\nfunction NF.invPeltAct(k, what, color)\nif color ~= CFG.seat and not (Player[color] and Player[color].admin) then\nNF.tell(color, \"Only \" .. CFG.seat .. \" can use \" .. CFG.seat .. \"'s inventory.\") return\nend\nlocal o = getObjectFromGUID(NF.INV.btns[\"nfInvA\" .. what .. k] or \"\")\nlocal board = NF.invBoard()\nif not (o and board) or o.isDestroyed() then return end\nlocal e = nil\nfor kind, x in pairs(NF.PELT) do if o.hasTag(\"AnimalTile_\" .. kind) then e = x end end\nif not e then return end\nlocal bin = getObjectsWithTag(\"TrashBin_\" .. CFG.seat)[1]\nif not bin then NF.say(e[1] .. \": your trash can is not on the table - nothing happens\", false) return end\nlocal g = (what == \"sell\") and NF.module(\"GROSCHEN\") or nil\nif what == \"sell\" and not g then NF.say(e[1] .. \": no Groschen well on your tray - nothing happens\", false) return end\no.setLock(false)\nbin.putObject(o)\nif what == \"sell\" then\ng.call(\"groschenChange\", {color = color, why = e[1] .. \" sold\", n = e[2]})   -- (\"[BLUE] Roe Deer sold: Groschen 3 → 12\")\nelse\nNF.say(e[1] .. \" discarded (trash)\")\nend\nNF.INV.sig = \"\"\nend\nfor k = 1, NF.PELT_MAX do                        -- (CONFIRM first, as every button: NF.confirm)\nfor _, w in ipairs({\"sell\", \"disc\"}) do\n_G[\"nfInvA\" .. w .. k] = function(_, c)\nNF.confirm(\"nfInvA\" .. w .. k, NF.INV.btns[\"nfInvA\" .. w .. k], c, function() NF.invPeltAct(k, w, c) end)\nend\nend\nend\nNF.INV_ICON_BASE = \"\"\nNF.INV_Q = 0.36                                  -- the \"?\" picture's size per BTN_K (world units)\nfunction NF.invIcon(f) return asset(CFG.iconBase or NF.INV_ICON_BASE, f) end\nfunction NF.invDecal(name, url, q, w, h)\nlocal s = self.getScale()\n