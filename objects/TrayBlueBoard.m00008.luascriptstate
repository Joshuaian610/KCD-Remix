"healed\", none = \"You have no wounds on your board.\"},\nbandage = {wounds = true, major = true, label = \"HEAL\", done = \"bandaged\", none = \"You have no major wound on your board.\"},\n}\nNF.healedTurn = false                            -- (a healing done this turn: the next is not the first)\nNF.FIX_PITCH, NF.FIX_DIST, NF.FIX_COLOUR = 85, 28, {1, 0.78, 0.2}\nNF.HEAL_DIST = 17                                -- (healing: the inventory in view, user's picture 2026-11-05)\nNF.FIXM = nil\nfunction NF.invFocus(board)                      -- the middle of the board's inventory boxes A-D and R (no horse)\nlocal x0, x1, z0, z1, y = nil, nil, nil, nil, nil\nfor _, b in ipairs(NF.invBoxes(board, NF.invSlots(board))) do\nif (b.code or \"\"):match(\"^[ABCDR]$\") and b.w then\nx0, x1 = math.min(x0 or b.w.x, b.w.x), math.max(x1 or b.w.x, b.w.x)\nz0, z1 = math.min(z0 or b.w.z, b.w.z), math.max(z1 or b.w.z, b.w.z)\ny = b.w.y\nend\nend\nif not x0 then return nil end\nreturn {(x0 + x1) / 2, y, (z0 + z1) / 2}\nend\nNF.CANCEL_W, NF.CANCEL_H = 480, 140              -- (the card buttons: 400 x 110, at NF.CARD_BTN)\nfunction NF.fixCancelBtn(kit)\nlocal b = kit.getBoundsNormalized()\nlocal cw, cl = math.max(0.5, b.size.x), math.max(0.5, b.size.z)\nlocal du = ((NF.CANCEL_W - 400) * NF.BTN_K / NF.BTN_PX / 2) / cw\nlocal dv = ((NF.CANCEL_H - 110) * NF.BTN_K / NF.BTN_PX / 2) / cl\nlocal q = self.positionToLocal(NF.cardPoint(kit, NF.CARD_BTN.u - du, NF.CARD_BTN.v + dv, 0.1))\nlocal seat = NF.seatBtnColour()\nself.createButton(__sharpB({click_function = \"nfFixCancel\", function_owner = self, label = \"CANCEL\",\ntooltip = \"Stop \" .. kit.getName() .. \" (nothing more is used)\", position = {-q.x, q.y + 0.25, q.z}, rotation = {0, 180, 0},\nwidth = math.floor(NF.CANCEL_W * NF.BTN_K), height = math.floor(NF.CANCEL_H * NF.BTN_K), font_size = math.floor(NF.BTN_FONT * 1.25),\ncolor = seat, hover_color = NF.lighter(seat, 0.18), press_color = NF.lighter(seat, 0.3), font_color = {1, 1, 1, 1}}, tr