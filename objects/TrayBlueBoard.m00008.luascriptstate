x = math.max(0.0001, math.sqrt(rx[1] ^ 2 + rx[2] ^ 2))\nlocal lz = math.max(0.0001, math.sqrt(rz[1] ^ 2 + rz[2] ^ 2))\nlocal du, dv = (u - 0.5) * W, (v - 0.5) * H\nreturn {x = c.x + rx[1] / lx * du + rz[1] / lz * dv, y = c.y, z = c.z + rx[2] / lx * du + rz[2] / lz * dv}\nend\nfunction NF.invPeltAct(k, what, color)\nif color ~= CFG.seat and not (Player[color] and Player[color].admin) then\nNF.tell(color, \"Only \" .. CFG.seat .. \" can use \" .. CFG.seat .. \"'s inventory.\") return\nend\nlocal o = getObjectFromGUID(NF.INV.btns[\"nfInvA\" .. what .. k] or \"\")\nlocal board = NF.invBoard()\nif not (o and board) or o.isDestroyed() then return end\nlocal e = nil\nfor kind, x in pairs(NF.PELT) do if o.hasTag(\"AnimalTile_\" .. kind) then e = x end end\nif not e then return end\nlocal bin = getObjectsWithTag(\"TrashBin_\" .. CFG.seat)[1]\nif not bin then NF.say(e[1] .. \": your trash can is not on the table - nothing happens\", false) return end\nlocal g = (what == \"sell\") and NF.module(\"GROSCHEN\") or nil\nif what == \"sell\" and not g then NF.say(e[1] .. \": no Groschen well on your tray - nothing happens\", false) return end\no.setLock(false)\nbin.putObject(o)\nif what == \"sell\" then\ng.call(\"groschenChange\", {color = color, why = e[1] .. \" sold\", n = e[2]})   -- (\"[BLUE] Roe Deer sold: Groschen 3 → 12\")\nelse\nNF.say(e[1] .. \" discarded (trash)\")\nend\nNF.INV.sig = \"\"\nend\nfor k = 1, NF.PELT_MAX do                        -- (CONFIRM first, as every button: NF.confirm)\nfor _, w in ipairs({\"sell\", \"disc\"}) do\n_G[\"nfInvA\" .. w .. k] = function(_, c)\nNF.confirm(\"nfInvA\" .. w .. k, NF.INV.btns[\"nfInvA\" .. w .. k], c, function() NF.invPeltAct(k, w, c) end)\nend\nend\nend\nNF.INV_ICON_BASE = \"\"\nNF.INV_Q = 0.36                                  -- the \"?\" picture's size per BTN_K (world units)\nfunction NF.invIcon(f) return asset(CFG.iconBase or NF.INV_ICON_BASE, f) end\nfunction NF.invDecal(name, url, q, w, h)\nlocal s = self.getScale()\nreturn {name = name, url = url, position = {q.x / s.x, (q.y + 0.24) / s.y, q.z / s.z}, rotation = {90, 0, 0},\nscale = {w / s.x, h / s.z, 1}}\nend\nfunction NF.decalsSet(prefix, list)\nlocal keep, had = {}, 0\nfor _, d in ipairs(self.getDecals() or {}) do\nif (d.name or \"\"):sub(1, #prefix) == prefix then had = had + 1 else keep[#keep + 1] = d end\nend\nif had == 0 and #list == 0 then return end\nfor _, d in ipairs(list) do keep[#keep + 1] = d end\nself.setDecals(keep)\nend\nNF.CARD_BTN = {u = 0.80, v = 0.31, dv = 0.085}   -- where a card's buttons go: right of the picture, under the title\nfunction NF.invSortEnsure(board)\nif SCRIPT_OPTS and SCRIPT_OPTS.trayButtons == false then   -- (scripting option Player tray: no SORT button, no picture)\nlocal idx = {}\nfor _, b in ipairs(self.getButtons() or {}) do if b.click_function == \"nfInvSort\" then idx[#idx + 1] = b.index end end\ntable.sort(idx, function(a, b) return a > b end)\nfor _, i in ipairs(idx) do self.removeButton(i) end\nfor _, d in ipairs(self.getDecals() or {}) do if d.name == \"invsort\" then NF.decalsSet(\"invsort\", {}) break end end\nreturn\nend\nlocal has = false\nfor _, b in ipairs(self.getButtons() or {}) do if b.click_function == \"nfInvSort\" then has = true break end end\nif has then                                    -- (the button is there: its picture too? a menu redraw may set decals)\nfor _, d in ipairs(self.getDecals() or {}) do if d.name == \"invsort\" then return end end\nlocal idx = {}\nfor _, b in ipairs(self.getButtons() or {}) do\nif b.click_function == \"nfInvSort\" then idx[#idx + 1] = b.index end\nend\ntable.sort(idx, function(a, b) return a > b end)\nfor _, i in ipairs(idx) do self.removeButton(i) end\nend\nlocal sw = NF.invSortSpot(board)\nif not sw then return end\nlocal tip = \"Sort the inventory, biggest first: item cards into the boxes A-D, then animal tiles and wounds into the \"\n.. \"halves, then meat, mushrooms, potions, flowers (the red box last)\"\nlocal W, H = 420 * NF.BTN_K / NF.BTN_PX, 110 * NF.BTN_K / NF.BTN_PX   -- (world units, as invBtn's 420 x 110)\nlocal q = self.positionToLocal(sw)\nself.createButton(__sharpB({click_function = \"nfInvSort\", function_owner = self, label = \"\", tooltip = tip,\nposition = {-q.x, q.y + 0.25, q.z}, rotation = {0, 180, 0}, width = math.floor(W * NF.BTN_PX),\nheight = math.floor(H * NF.BTN_PX), font_size = NF.BTN_FONT, color = {1, 1, 1, 0}, hover_color = {1, 1, 1, 0.12},\npress_color = {1, 1, 1, 0.25}, font_color = {1, 1, 1, 1}}, true))\nNF.decalsSet(\"invsort\", {NF.invDecal(\"invsort\", NF.invIcon(\"sort_btn_\" .. CFG.seat:lower() .. \"_v1.png\"), q, W, H)})\nend\nfunction NF.invSortSpot(board)\nlocal b = board.getBoundsNormalized()\nlocal sc = board.getScale()\nlocal halfz = (b.size.z / 2) / math.max(0.01, sc.z)\nlocal w = board.positionToWorld({-3.76, 0, halfz + 0.3})\nw.y = self.positionToWorld({0, NF.top(), 0}).y\nreturn w\nend\nNF.INV_LINGER = 2.0                             -- (seconds the inventory buttons stay after the pointer leaves)\nfunction NF.invHide()\nif NF.INV.shown then NF.invClear() NF.INV.shown = false end\nend\nNF.INV_IDLE = 1.0                               -- (owner 11-11) seconds between looks while nobody sits there / its buttons are off\nfunction NF.invTick()\nif NF.dead then return end\nlocal wait = NF.INV.every\nNF.HORSE_MEMO = {}                             -- (the seat's horse: looked for once in this whole tick, NF.horseOf)\nlocal ok = pcall(function()\nlocal pl = Player[CFG.seat]\nlocal board = NF.invBoard()\nlocal idle = not (board and pl and pl.seated)\nif SCRIPT_OPTS and SCRIPT_OPTS.trayButtons == false then idle = true end   -- (scripting option: Player tray)\nNF.INV.sortN = (NF.INV.sortN or 0) - 1\nif board and (idle or NF.INV.sortN <= 0) then\nNF.INV.sortN = math.floor(1 / NF.INV.every + 0.5)\nNF.invSortEnsure(board)\nend\nif idle then\nwait = NF.INV_IDLE\nNF.INV.sortN = 0                             -- (and on the first look once someone sits there again)\nNF.invHide()\nreturn\nend\nlocal p = pl.getPointerPosition()\nif p and NF.invInside(board, p) then\nNF.INV.outTicks = 0\nNF.invShow(board)\nelseif NF.INV.shown then                     -- (counted in ticks of NF.INV.every, not the clock)\nNF.INV.outTicks = (NF.INV.outTicks or 0) + 1\nif NF.INV.outTicks * NF.INV.every >= NF.INV_LINGER then NF.INV.outTicks = 0 NF.invHide() end\nend\nend)\nNF.HORSE_MEMO = nil\nif not ok then NF.invHide() end\nWait.time(NF.invTick, NF.pmWait(\"inv\", wait))\nend\nfunction NF.hungerTrack(board)\nlocal cube = nil\nfor _, o in ipairs(getObjectsWithTag(\"Hunger_\" .. CFG.seat)) do if o.type ~= \"Surface\" then cube = o end end\nlocal spots = NF.snapMade(board, \"hunger\", function(list)\nlocal out = {}\nfor _, s in ipairs(list) do\nfor _, t in ipairs(s.tags or {}) do if t == \"Hunger_\" .. CFG.seat then out[#out + 1] = s.position end end\nend\ntable.sort(out, function(a, b) return a.x > b.x end)\nreturn out\nend)\nif not cube or #spots == 0 then return nil end\nlocal cp, now, bd = cube.getPosition(), 0, 0.81\nfor i, q in ipairs(spots) do\nlocal d = NF.flat2(board.positionToWorld(q), cp)\nif d < bd then now, bd = i, d end\nend\nreturn cube, spots, now\nend\nfunction NF.hungerUp(board, n)\nlocal cube, spots, now = NF.hungerTrack(board)\nif not cube then return nil end\nlocal to = math.min(#spots, now + n)\nlocal w = board.positionToWorld(spots[to])\ncube.setPositionSmooth({w.x, w.y + 0.4, w.z}, false, true)\npcall(function() cube.setVar(\"index\", to) end)  -- (user, 2026-11-06: the cube's own value follows, as a drop does)\nreturn now, to\nend\nfunction NF.eatAsk(n)\nlocal board = NF.invBoard()\nlocal cube, spots, now = nil, nil, nil\nif board then cube, spots, now = NF.hungerTrack(board) end\nif not cube or not n or n <= 0 then return nil end\nif now >= #spots then return \"YOU ARE FULL - EAT?\" end   -- (the user's words, caps)\nlocal waste = now + n - #spots\nreturn waste > 0 and (\"WASTES \" .. waste .. \" - EAT?\") or nil\nend\nfunction NF.eatText(from, to, n)                 -- the chat's end of \"ate meat...\": the hunger, and what was wasted\nif not from then return \" (hunger +\" .. n .. \")\" end\nif from == to then return \": already full (\" .. n .. \" wasted)\" end\nlocal waste = n - (to - from)\nreturn \": hunger \" .. from .. \" → \" .. to .. (waste > 0 and (\" (\" .. waste .. \" wasted)\") or \"\")\nend\nfunction NF.askFont(ask)                          -- a longer CONFIRM text: smaller, to fit the button\nreturn math.floor(NF.BTN_FONT_CONFIRM * math.min(1, 9 / math.max(1, #(ask or \"CONFIRM\"))))\nend\nfunction NF.invAct(k, what, color)\nif color ~= CFG.seat and not (Player[color] and Player[color].admin) then\nNF.tell(color, \"Only \" .. CFG.seat .. \" can use \" .. CFG.seat .. \"'s inventory.\") return\nend\nlocal o = getObjectFromGUID(NF.INV.btns[\"nfInv\" .. what .. k] or \"\")\nif not o or o.isDestroyed() then return end\nlocal wv = NF.invWorth(o)\nlocal board = NF.invBoard()\nif not (wv and board) then return end\nif what == \"info\" then NF.invRecipe(wv.colour, color, o) return end\nNF.invRecipeAway()                             -- (user: eating, drinking or selling closes a shown recipe too)\nif what == \"eat\" then\nlocal from, to = NF.hungerUp(board, wv.eat)\no.destruct()\nNF.say(\"ate \" .. wv.label .. NF.eatText(from, to, wv.eat))\nelseif what == \"drink\" then\no.destruct()\nNF.say(\"drank a \" .. wv.label)\nNF.tellTucked(\"cfDrank\", tostring(wv.colour or \"\"))   -- (Unexpected Gift, tucked: a white potion drunk = +1 Universal)\nelse\nlocal g = NF.module(\"GROSCHEN\")\nlocal paid = g and g.call(\"groschenPay\", {n = wv.sell}) or 0\no.destruct()\nNF.say(\"sold \" .. wv.label .. \" for \" .. wv.sell .. \" Groschen\" .. ((paid or 0) > 0 and \"\" or \" (no Groschen well found: add it by hand)\"))\nend\nNF.INV.sig = \"\"                                -- (rebuilt on the next tick)\nend\nfunction NF.invRecipeInPlay(colour)\nlocal names = {}\nfor _, p in ipairs(NF.POTIONS or {}) do if p[3] == colour then names[p[1]] = true end end\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Card\" and names[o.getName()] and not isHeld(o) and not NF.faceDown(o) then return o end\nend\nend\nfunction NF.invRecipeAway()\nlocal o = NF.INV.recipe and getObjectFromGUID(NF.INV.recipe)\nif o then o.destruct() end\nNF.INV.recipe = nil\nend\nNF.RECIPE_SCALE, NF.CARD_HALF_W = 1.8, 1.1      -- the shown copy's scale; a card's half width at scale 1 (world)\nfunction NF.invRecipeSpot(board, token)\nlocal lo, hi = nil, nil\nfor _, s in ipairs(board.getSnapPoints() or {}) do\nfor _, t in ipairs(s.tags or {}) do\nif t == \"Inventory_\" .. CFG.seat then\nlo, hi = math.min(lo or s.position.x, s.position.x), math.max(hi or s.position.x, s.position.x)\nend\nend\nend\nlocal mid = lo and (lo + hi) / 2 or 0\nlocal q = board.positionToLocal(token.getPosition())\nlocal side = (q.x < mid) and -1 or 1\nlocal bs = math.max(0.01, board.getScale().x)\nlocal off = 0.45 + 0.1 + NF.CARD_HALF_W * NF.RECIPE_SCALE / bs     -- token radius + gap + half the card (board units)\nreturn board.positionToWorld({q.x + side * off, 0, q.z}), side\nend\nfunction NF.invRecipe(colour, color, token)\nNF.invRecipeAway()\nlocal card = NF.invRecipeInPlay(colour)\nif not card then NF.tell(color, \"No \" .. colour .. \" recipe is in play.\") return end\nlocal board = NF.invBoard()\nlocal d = card.getData()\nd.GUID = nil\nd.Locked = true\nd.Tags = nil                                   -- (a copy to look at: no script may take it for the real recipe)\nlocal sc = NF.RECIPE_SCALE\nd.Transform = d.Transform or {}\nd.Transform.scaleX, d.Transform.scaleY, d.Transform.scaleZ = sc, 1, sc\nlocal at = token and NF.invRecipeSpot(board, token) or board.positionToWorld({-3.76, 0, 0.8})\nd.Transform.posX, d.Transform.posY, d.Transform.posZ = at.x, at.y + 1.2, at.z\nd.Transform.rotX, d.Transform.rotY, d.Transform.rotZ = 0, board.getRotation().y % 360, 0   -- (live test: + 180 showed it upside down)\nlocal o = spawnObjectData({data = d, callback_function = function(c)\nc.setLock(true)\nc.setName(\"Recipe (shown): \" .. (d.Nickname or colour))\nc.createButton(__sharpB({click_function = \"nfInvRecipeAway\", function_owner = self, label = \"\", tooltip = \"Put it away\",\nposition = {0, 0.2, 0}, width = 1100, height = 1550, color = {1, 1, 1, 0}, hover_color = {1, 1, 1, 0.08},\npress_color = {1, 1, 1, 0.15}}, true))\nend})\nNF.INV.recipe = o and o.getGUID() or nil\nend\nfunction nfInvRecipeAway() NF.invRecipeAway() end\nfor k = 1, NF.INV.max do\n_G[\"nfInvinfo\" .. k] = function(_, c) NF.invAct(k, \"info\", c) end\nfor _, w in ipairs({\"eat\", \"drink\", \"sell\"}) do  -- (SURE? first: see NF.confirm)\n_G[\"nfInv\" .. w .. k] = function(_, c)\nlocal ask = nil                            -- (eating past the top of the hunger track: says so first)\nif w == \"eat\" then\nlocal o = getObjectFromGUID(NF.INV.btns[\"nfInveat\" .. k] or \"\")\nlocal wv = o and NF.invWorth(o) or nil\nif wv and wv.eat then ask = NF.eatAsk(wv.eat) end\nend\nNF.confirm(\"nfInv\" .. w .. k, NF.INV.btns[\"nfInv\" .. w .. k], c, function() NF.invAct(k, w, c) end, ask)\nend\nend\nend\nNF.INV.tokenTags = {\"MeatToken\", \"MushroomToken\", \"FlowerToken\"}\nfunction NF.invBlocked(board, slots, skip)\nlocal blocked, y0 = {}, slots[1] and slots[1].w.y or 0\nskip = skip or {}\nlocal halves = nil\nfor _, o in ipairs(getObjects()) do\nlocal kind = o.type\nif (kind == \"Card\" or kind == \"Deck\" or kind == \"Tile\" or o.hasTag(\"AnimalTile\")) and o ~= board and not isHeld(o)\nand not skip[o.getGUID()] and not o.hasTag(\"HorseTile\") then   -- (the horse carries its circles: it covers none)\nlocal food = false\nfor _, t in ipairs(NF.INV.tokenTags) do if o.hasTag(t) then food = true break end end\nlocal b = (not food) and o.getBounds()\nif b and math.abs(b.center.y - y0) < 1.5 then\nfor _, i in ipairs(NF.invUnder(o, slots, b)) do blocked[i] = true end\nend\nif not food and (o.hasTag(\"WoundToken\") or o.hasTag(\"AnimalTile\")) then\nhalves = halves or NF.invHalves(board, slots)\nlocal hi = NF.invHalfAt(halves, o.getPosition())\nif hi then for _, c in ipairs(halves[hi].circles) do blocked[c] = true end end\nend\nend\nend\nreturn blocked\nend\nfunction NF.invUnder(o, slots, b)\nlocal out = {}\nb = b or o.getBounds()\nlocal hx, hz = b.size.x / 2 - 0.15, b.size.z / 2 - 0.15      -- (an edge just touching a circle does not count)\nfor i, s in ipairs(slots) do\nif math.abs(s.w.x - b.center.x) < hx and math.abs(s.w.z - b.center.z) < hz then out[#out + 1] = i end\nend\nreturn out\nend\nfunction NF.invHalfAt(halves, p)\nlocal at, bd = nil, 1.6 * 1.6\nfor hi, h in ipairs(halves) do\nlocal d = NF.flat2(p, h.w)\nif d < bd and math.abs(p.y - h.w.y) < 1.5 then at, bd = hi, d end\nend\nreturn at\nend\nfunction NF.invBoxes(board, slots)\nlocal inv, red = {}, nil\nfor _, s in ipairs((NF.snaps(board))) do         -- (owner 11-11: the kept list, NF.snaps - only read)\nfor _, t in ipairs(s.tags or {}) do\nif t == \"InventorySlot_\" .. CFG.seat then inv[#inv + 1] = s.position\nelseif t == \"OverloadSlot_\" .. CFG.seat then red = s.position end\nend\nend\ntable.sort(inv, function(a, b) if math.abs(a.z - b.z) > 0.3 then return a.z < b.z end return a.x > b.x end)\nlocal out = {}\nfor i, p in ipairs(inv) do out[#out + 1] = {code = (\"ABCD\"):sub(i, i), l = p} end\nfor _, b in ipairs(out) do b.w = board.positionToWorld(b.l) end\nlocal horse = NF.horseOf()\nif horse then\nlocal full, half = {}, {}\nfor _, s in ipairs((NF.snaps(horse))) do\nfor _, t in ipairs(s.tags or {}) do\nif t == \"HorseSlot\" then full[#full + 1] = s.position elseif t == \"HorseHalf\" then half[#half + 1] = s.position end\nend\nend\ntable.sort(full, function(a, b) return a.x > b.x end)\ntable.sort(half, function(a, b) return a.x > b.x end)\nlocal hy = horse.getRotation().y\nfor i, p in ipairs(full) do\nlocal w = horse.positionToWorld(p)\nout[#out + 1] = {code = \"H\" .. i, l = board.positionToLocal(w), w = w, horse = true, yaw = hy}\nend\nfor i, p in ipairs(half) do\nlocal w = horse.positionToWorld(p)\nout[#out + 1] = {code = \"Hh\" .. i, l = board.positionToLocal(w), w = w, horse = true, half = true, yaw = hy}\nend\nend\nif red then out[#out + 1] = {code = \"R\", l = red, w = board.positionToWorld(red)} end\nfor _, b in ipairs(out) do b.circles = {} end\nfor i, s in ipairs(slots or {}) do\nlocal q, best, bd = board.positionToLocal(s.w), nil, nil\nfor _, b in ipairs(out) do\nlocal d = (q.x - b.l.x) ^ 2 + (q.z - b.l.z) ^ 2\nif not bd or d < bd then best, bd = b, d end\nend\nif best then best.circles[#best.circles + 1] = i end\nend\nreturn out\nend\nfunction NF.invItems(board, boxes)\nlocal out = {}\nfor _, o in ipairs(getObjectsWithTag(\"ItemCard\")) do\nif o.type == \"Card\" and not isHeld(o) and not o.isSmoothMoving() then\nlocal q = board.positionToLocal(o.getPosition())\nfor bi, b in ipairs(boxes) do\nif (q.x - b.l.x) ^ 2 + (q.z - b.l.z) ^ 2 < 0.36 and math.abs(q.y - b.l.y) < 1.2 then\nlocal slot = nil                       -- (its own box, if it is equipment)\nfor _, c in ipairs({\"A\", \"B\", \"C\", \"D\", \"R\"}) do if o.hasTag(\"EquipSlot_\" .. c) then slot = c end end\nlocal own = slot == b.code\nout[#out + 1] = {o = o, box = bi, slot = slot, own = own, equipped = own and o.hasTag(\"Equipped\")}\nbreak\nend\nend\nend\nend\nreturn out\nend\nfunction NF.invOnTop(card, board)\nlocal b = card.getBounds()\nlocal out = {}\nfor _, o in ipairs(getObjects()) do\nif o ~= card and o ~= board and o ~= self and not isHeld(o) and not o.getLock() and o.type ~= \"Scripting\"\nand o.type ~= \"Surface\" and not o.hasTag(\"ItemCard\")\nand not o.hasTag(\"WoundToken\") and not o.hasTag(\"AnimalTile\") then   -- (those SORT lays into the halves itself)\nlocal food = false\nfor _, t in ipairs(NF.INV.tokenTags) do if o.hasTag(t) then food = true break end end\nlocal p = o.getPosition()\nif not food and math.abs(p.x - b.center.x) < b.size.x / 2 and math.abs(p.z - b.center.z) < b.size.z / 2\nand p.y > b.center.y - 0.05 and p.y < b.center.y + 4 then out[#out + 1] = o end\nend\nend\nreturn out\nend\nfunction NF.invLift(o, x, y, z, up, r)          -- lifted, carried over, set down (as SORT moves tokens)\no.setPositionSmooth({x, y + up, z}, false, true)\nWait.time(function() if not o.isDestroyed() then\no.setPositionSmooth({x, y, z}, false, true)\no.setRotationSmooth(r, false, true) end end, 0.6)\nend\nNF.INV.placing = {}\nNF.INV.CARDS = 8                                 -- item cards with buttons (board 5 + the horse's 3)                              -- box code -> os.clock() until it counts as taken (a card on its way)\nfunction NF.placedWhere(r)                    -- (invPlace's answer as words)\nlocal s = type(r) == \"string\" and r:match(\"^W:(.+)$\")\nreturn s and (\" → worn (\" .. s .. \" slot)\") or \" → inventory\"\nend\nfunction invPlace(p)\nif CFG.name ~= \"BOARD\" then return false end\nlocal card = getObjectFromGUID(type(p) == \"table\" and p.guid or \"\")\nlocal board = NF.invBoard()\nif not (card and board) then return false end\n-- (user, 2026-11-06: \"taking an item when its slot is empty will automatically equip it: weapon into the weapon slot,\n-- bow into bow, etc.\") the board's worn slots first (their snap tags match the card's SlotWeapon, SlotBow, ...)\nfor _, s in ipairs(board.getSnapPoints() or {}) do\nlocal tag = nil\nfor _, t in ipairs(s.tags or {}) do if t:match(\"^Slot%u\") and card.hasTag(t) then tag = t end end\nif tag then\nlocal taken = (NF.INV.placing[tag] or 0) > os.clock()\nfor _, o in ipairs(getObjectsWithTag(\"ItemCard\")) do\nif o ~= card and o.type == \"Card\" and not isHeld(o) then\nlocal q = board.positionToLocal(o.getPosition())\nif (q.x - s.position.x) ^ 2 + (q.z - s.position.z) ^ 2 < 0.36 and math.abs(q.y - s.position.y) < 1.2 then taken = true end\nend\nend\nif not taken then\nNF.INV.placing[tag] = os.clock() + 2.5\nlocal w = board.positionToWorld(s.position)\ncard.setLock(false)\nNF.invLift(card, w.x, w.y + 0.08, w.z, 1.5, {0, board