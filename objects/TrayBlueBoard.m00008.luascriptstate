ocal bonus = p ~= nil and p.bonus == true\nlocal memo = {}\nlocal function best(M, m, B, O, credit, first)\nlocal key = M .. \":\" .. m .. \":\" .. B .. \":\" .. O .. \":\" .. credit .. \":\" .. (first and 1 or 0)\nif memo[key] then return memo[key] end\nlocal win = {steps = 0, cost = 0, plan = nil}\nlocal function try(act, nM, nm, nB, nO, nc, cost)\nlocal r = best(nM, nm, nB, nO, nc, false)\nlocal s, c = r.steps + 1, r.cost + cost\nif s > win.steps or (s == win.steps and c < win.cost) then win = {steps = s, cost = c, plan = {act = act, nxt = r}} end\nend\nif credit > 0 then                              -- the free second heal comes right after the first one (or not at all)\nif M > 0 then try(\"freeM\", M - 1, m + 1, B, O, 0, 0) end\nif m > 0 then try(\"freem\", M, m - 1, B, O, 0, 0) end\nlocal r = best(M, m, B, O, 0, false)\nif r.steps > win.steps or (r.steps == win.steps and r.cost < win.cost) then win = {steps = r.steps, cost = r.cost, plan = r.plan} end\nelse\nlocal gift = (bonus and first) and 1 or 0       -- (the Ointment as the turn's first heal: once more for free)\nif B > 0 and M > 0 then try(\"bandM\", M - 1, m + 1, B - 1, O, 0, 1) end\nif O > 0 and M > 0 then try(\"ointM\", M - 1, m + 1, B, O - 1, gift, 3) end\nif O > 0 and m > 0 then try(\"ointm\", M, m - 1, B, O - 1, gift, 3) end\nend\nmemo[key] = win\nreturn win\nend\nlocal acts = {}\nlocal node = best(#majors, #minors, #band, #oint, 0, true).plan\nwhile node do acts[#acts + 1] = node.act node = node.nxt.plan end\nif #acts == 0 then return {} end\nlocal steps = {}\nlocal used = {band = 0, oint = 0, free = 0}\nlocal majorQ, minorQ = {}, {}\nfor _, o in ipairs(majors) do majorQ[#majorQ + 1] = o end\nfor _, o in ipairs(minors) do minorQ[#minorQ + 1] = o end\nfor _, a in ipairs(acts) do\nif a == \"bandM\" or a == \"ointM\" or a == \"freeM\" then\nlocal o = table.remove(majorQ, 1)            -- a major wound turned to minor\nsteps[#steps + 1] = {o, \"flip\"}\nminorQ[#minorQ + 1] = o\nelse\nlocal o = table.remove(minorQ, 1)            -- a minor wound healed (back under the Wound Tokens)\nsteps[#steps + 1] = {o, \"remove\"}\nend\nif a == \"bandM\" then table.remove(band).destruct() used.band = used.band + 1\nelseif a == \"ointM\" or a == \"ointm\" then table.remove(oint).destruct() used.oint = used.oint + 1\nelse used.free = used.free + 1 end\nend\nfor k, st in ipairs(steps) do                   -- one after the other (a wound turned first, then put away)\nWait.time(function()\nlocal o = st[1]\nif o.isDestroyed() then return end\nif st[2] == \"flip\" then o.flip() else NF.woundUnderDeck(o) end\nend, (k - 1) * 0.9)\nend\nNF.healedTurn = true\nlocal out, flips, gone = {}, 0, 0\nfor _, st in ipairs(steps) do if st[2] == \"flip\" then flips = flips + 1 else gone = gone + 1 end end\nif used.band > 0 then out[#out + 1] = \"Bandages \" .. used.band end\nif used.oint > 0 then out[#out + 1] = \"Healing Ointment \" .. used.oint .. (used.free > 0 and (\" +\" .. used.free .. \" free\") or \"\") end\nlocal what = {}\nif flips > 0 then what[#what + 1] = flips .. (flips == 1 and \" major wound to minor\" or \" major wounds to minor\") end\nif gone > 0 then what[#what + 1] = gone .. (gone == 1 and \" minor wound healed\" or \" minor wounds healed\") end\nNF.say(\"healed for the scoring: \" .. table.concat(what, \", \") .. \" (\" .. table.concat(out, \", \") .. \")\")\nNF.INV.sig = \"\"\nreturn {healed = out, flips = flips, gone = gone, time = #steps * 0.9}\nend\nlocal function book(n, skill, a, uni) return {n = n, book = true, word = \"READ\", gain = {[skill] = a, Universal = uni}, bsell = (n == 2) and 7 or ((a == 2) and 10 or 12), u = 0.76, v = 0.62} end\nNF.CUBES = {\n[\"Hercules and His Diet I\"] = book(2, \"Strength\", 2, 1),\n[\"Hercules and His Diet II\"] = book(3, \"Strength\", 2, 1),\n[\"Hercules and His Diet III\"] = book(3, \"Strength\", 1, 2),\n[\"The Joy of Gutting I\"] = book(2, \"Perception\", 2, 1),\n[\"The Joy of Gutting II\"] = book(3, \"Perception\", 2, 1),\n[\"The Joy of Gutting III\"] = book(3, \"Perception\", 1, 2),\n[\"Shadow Play I\"] = book(2, \"Dexterity\", 2, 1),\n[\"Shadow Play II\"] = book(3, \"Dexterity\", 2, 1),\n[\"Shadow Play III\"] = book(3, \"Dexterity\", 1, 2),\n[\"Silence is Golden and Other Myths I\"] = book(2, \"Speech\", 2, 1),\n[\"Silence is Golden and Other Myths II\"] = book(3, \"Speech\", 2, 1),\n[\"Silence is Golden and Other Myths III\"] = book(3, \"Speech\", 1, 2),\n[\"Book of Prayers\"] = {n = 3, book = true, word = \"READ\", gain = {Universal = 1}, good = \"discard\", bsell = 10, u = 0.76, v = 0.62},\n[\"Dried Fruit\"] = {n = 5, sell = 2, food = true, word = \"EAT\", eat = 2, all = \"good\", u = 0.68, v = 0.63},  -- + EAT ALL\n[\"Dried Meat\"] = {n = 4, sell = 2, food = true, word = \"EAT\", eat = 3, u = 0.68, v = 0.63},\n[\"Dried Mushrooms\"] = {n = 5, sell = 1, food = true, word = \"EAT\", eat = 2, u = 0.68, v = 0.63},\n[\"Soap\"] = {n = 4, sell = 1, word = \"DRINK\", fix = \"dirt\", u = 0.68, v = 0.63},   -- (user's joke, 2026-11-04: to be undone later)\n[\"Whetstone\"] = {n = 3, sell = 1, word = \"REPAIR\", fix = \"mark\", u = 0.68, v = 0.58},\n[\"Small Repair Kit\"] = {n = 3, sell = 2, word = \"REPAIR\", fix = \"shield\", u = 0.68, v = 0.63},\n[\"Big Repair Kit\"] = {n = 5, sell = 2, word = \"REPAIR\", fix = \"shield\", u = 0.68, v = 0.63},\n[\"Holy Water\"] = {n = 2, sell = 4, word = \"DRINK\", holy = true, u = 0.68, v = 0.63},\n[\"Bandages\"] = {n = 3, sell = 1, word = \"HEAL\", fix = \"bandage\", u = 0.68, v = 0.63},\n[\"Healing Ointment\"] = {n = 3, sell = 3, word = \"HEAL\", fix = \"heal\", u = 0.70, v = 0.62},\n}\nNF.CUBE_DONE = {READ = \"read\", EAT = \"ate from\", REPAIR = \"repaired with\", DRINK = \"drank\", HEAL = \"healed with\", USE = \"used\"}\nfunction NF.cubeName() return \"Cube (\" .. CFG.seat .. \")\" end\nfunction NF.goodPile()                           -- the Good Cards deck (or its last card)\nfor _, o in ipairs(getObjects()) do\nif (o.type == \"Deck\" or o.type == \"Card\") and o.getName() == \"Good Cards\" and not isHeld(o) then return o end\nend\nend\nfunction NF.cubesOn(card, board)\nlocal out = {}\nfor _, o in ipairs(NF.invOnTop(card, board)) do if o.getName() == NF.cubeName() then out[#out + 1] = o end end\nreturn out\nend\nfunction NF.cardPoint(card, u, v, lift)\nlocal b, sc = card.getBoundsNormalized(), card.getScale()\nlocal w, d = b.size.x / math.max(0.01, sc.x), b.size.z / math.max(0.01, sc.z)\nreturn card.positionToWorld({(0.5 - u) * w, lift or 0.3, (v - 0.5) * d})\nend\nfunction NF.cubeBag()\nfor _, o in ipairs(getObjects()) do\nif o.getName() == \"Cubes (\" .. CFG.seat .. \")\" and o.takeObject then return o end\nend\nend\nNF.CUBE_LIFT, NF.CUBE_DROP, NF.CUBE_SETTLE = 0.15, 0.6, 1.6   -- the card's lift, the cubes' height over it, settle time\nfunction NF.cubeFill(card)\nif NF.dead or not card or card.isDestroyed() or isHeld(card) then return end\nlocal spec, board = NF.CUBES[card.getName()], NF.invBoard()\nif not (spec and board) or card.hasTag(\"CubesGiven\") or not NF.invInside(board, card.getPosition()) then return end\nif #NF.cubesOn(card, board) > 0 then return end\nlocal bag = NF.cubeBag()\nif not bag then NF.tell(CFG.seat, \"No cube bag found for \" .. card.getName() .. \": add \" .. spec.n .. \" cubes by hand.\") return end\ncard.addTag(\"CubesGiven\")\nlocal wasLocked = card.getLock()\nlocal rest = card.getPosition()\ncard.setLock(true)\ncard.setPosition({rest.x, rest.y + NF.CUBE_LIFT, rest.z})\nWait.time(function()\nif card.isDestroyed() or NF.dead then return end\ncard.setLock(wasLocked)\nend, 0.12 * (spec.n - 1) + NF.CUBE_SETTLE)\nlocal cols = math.min(spec.n, 3)\nlocal rows = math.ceil(spec.n / cols)\nfor i = 1, spec.n do\nlocal c, r = (i - 1) % cols, math.floor((i - 1) / cols)\nlocal hu, hv = (cols - 1) / 2 * 0.36, (rows - 1) / 2 * 0.24   -- (live test 2: spread out more; the grid kept on the card)\nlocal cu = math.max(0.12 + hu, math.min(0.88 - hu, spec.u))\nlocal cv = math.max(0.1 + hv, math.min(0.78 - hv, spec.v))\nlocal u = cu + (c - (cols - 1) / 2) * 0.36\nlocal v = cv + (r - (rows - 1) / 2) * 0.24\nWait.time(function()\nif card.isDestroyed() or NF.dead then return end\nlocal p = NF.cardPoint(card, u, v, NF.CUBE_DROP)\nbag.takeObject({position = {p.x, p.y, p.z}, smooth = false})\nend, 0.12 * (i - 1))\nend\nNF.INV.sig = \"\"\nend\nfunction NF.cubeDrop(obj)\nif obj.type ~= \"Card\" or not NF.CUBES[obj.getName()] then return end\nWait.time(function()                           -- (user: 1.2 s after it was put down, never while it is held)\nWait.condition(function() NF.cubeFill(obj) end,\nfunction() return obj.isDestroyed() or (not isHeld(obj) and not obj.isSmoothMoving()) end, 3)\nend, 1.2)\nend\nNF.XP_MAX = 4\nfunction NF.xpStep(skill)\nlocal best, bv, bg = nil, nil, nil\nfor _, o in ipairs(getObjectsWithTag(skill .. \"_\" .. CFG.seat)) do\nif (o.getName() or \"\"):find(\"XP Cube\", 1, true) then\nlocal v = o.call(\"getValue\") or -1\nlocal g = o.getVar(\"gen\") or 0\nif type(v) == \"number\" and v >= 0 and v < NF.XP_MAX and (not best or g > bg) then best, bv, bg = o, v, g end\nend\nend\nif best then best.call(\"setValue\", {value = bv + 1}) return true end\nreturn false\nend\nfunction NF.xpGain(skill, n)\nlocal left = n\nlocal function go(tries)\nif left <= 0 or NF.dead then return end\nif NF.xpStep(skill) then\nleft = left - 1\nWait.time(function() go(0) end, 0.5)\nelseif tries < 8 then                        -- (the track is full: its spare cube is on the way)\nWait.time(function() go(tries + 1) end, 0.5)\nend\nend\ngo(0)\nend\nfunction NF.gainText(gain)\nlocal out = {}\nfor _, s in ipairs({\"Strength\", \"Perception\", \"Dexterity\", \"Speech\", \"Universal\"}) do\nif gain[s] then out[#out + 1] = s .. \" +\" .. gain[s] end\nend\nreturn table.concat(out, \", \")\nend\n-- (user, 2026-11-06: \"-3 per token taken off the price of the lower sell value\", and the same for the SELL buttons)\n-- the Shield and Dirt tokens lying on a card that is sold: 3 Groschen less for each, never below 0; they go with it\nfunction NF.marksOn(card)\nlocal out, n = {}, 0\nfor _, tag in ipairs({\"ShieldToken\", \"DirtToken\"}) do\nfor _, t in ipairs(NF.tokensOn(card, tag)) do\nlocal q = 1\npcall(function() local k = t.getQuantity() if type(k) == \"number\" and k > 1 then q = k end end)\nout[#out + 1] = t\nn = n + q\nend\nend\nreturn out, n\nend\nfunction NF.markCount(card) local _, n = NF.marksOn(card) return n end\nfunction NF.netPrice(card, base) return math.max(0, (base or 0) - 3 * NF.markCount(card)) end\nfunction NF.takeMarks(card, base)                -- the price after the tokens; the tokens removed (both bowls are endless)\nlocal list, n = NF.marksOn(card)\nfor _, t in ipairs(list) do t.destruct() end\nreturn math.max(0, (base or 0) - 3 * n), n\nend\nfunction NF.cutText(n)\nif not n or n <= 0 then return \"\" end\nreturn \" (−\" .. 3 * n .. \" for \" .. n .. (n == 1 and \" Shield / Dirt token\" or \" Shield / Dirt tokens\") .. \" on it)\"\nend\nfunction NF.cubeAct(k, what, color)\nif color ~= CFG.seat and not (Player[color] and Player[color].admin) then\nNF.tell(color, \"Only \" .. CFG.seat .. \" can use \" .. CFG.seat .. \"'s inventory.\") return\nend\nlocal card = getObjectFromGUID((NF.INV.cube or {})[k] or \"\")\nlocal spec, board = card and NF.CUBES[card.getName()], NF.invBoard()\nif not (spec and board) then return end\nlocal cubes = NF.cubesOn(card, board)\nif what == \"remove\" or what == \"bsell\" then    -- used up (user, live test): back under the Item Market Cards\nif #cubes > 0 and what == \"remove\" then return end\nlocal paid = 0\nlocal price, cut = spec.bsell or 0, 0\nif what == \"bsell\" then\nif not spec.bsell then return end\nfor _, c in ipairs(cubes) do c.destruct() end   -- (user, 2026-11-04: sold unread, the pages left go too)\nprice, cut = NF.takeMarks(card, spec.bsell)    -- (user, 2026-11-06: -3 per Shield / Dirt token on it, never below 0)\nlocal g = NF.module(\"GROSCHEN\")\npaid = (price > 0 and g) and g.call(\"groschenPay\", {n = price}) or 0\nend\nlocal name = card.getName()\nlocal market = nil\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Deck\" and o.getName() == \"Item Market Cards\" and not isHeld(o) then market = o break end\nend\nif market then NF.underDeck(card, market) end\nNF.say((what == \"bsell\" and (\"sold \" .. name .. \" for \" .. price .. \" Groschen\" .. NF.cutText(cut)) or (name .. \" discarded.\"))\n.. (market and (what == \"bsell\" and \" (back under the Item Market Cards)\" or \"\") or \" (no Item Market Cards deck found: put it back by hand)\")\n.. ((what == \"bsell\" and price > 0 and (paid or 0) <= 0) and \" (no Groschen well found: add it by hand)\" or \"\"))\nNF.INV.sig = \"\"\nreturn\nend\nif #cubes == 0 then return end\nif what == \"sell\" then                         -- (user, live test) SELL sells all the cubes left at once\nif not spec.sell then return end\nlocal n = #cubes\nfor _, c in ipairs(cubes) do c.destruct() end\nlocal price, cut = NF.takeMarks(card, spec.sell * n)   -- (user, 2026-11-06: -3 per Shield / Dirt token on it, never below 0)\nlocal g = NF.module(\"GROSCHEN\")\nlocal paid = (price > 0 and g) and g.call(\"groschenPay\", {n = price}) or 0\nNF.say(\"sold \" .. card.getName() .. \" (\" .. n .. \" x \" .. spec.sell .. \") for \" .. price .. \" Groschen\" .. NF.cutText(cut)\n.. ((price <= 0 or (paid or 0) > 0) and \"\" or \" (no Groschen well found: add it by hand)\"))\nNF.INV.sig = \"\"\nreturn\nend\nif what == \"use\" and spec.holy then           -- Holy Water: the Bad cards laid out to choose from (again: all back)\nif NF.HW and NF.HW.kit == card.getGUID() then NF.hwEnd() return end\nif NF.HW then NF.hwEnd() end\nNF.hwStart(card, color, board)\nreturn\nend\nif what == \"use\" and spec.fix then             -- repair kit / soap: the board in view, what can be fixed lit up\nif NF.FIXM and NF.FIXM.kit == card.getGUID() then NF.fixClear() NF.FIXM = nil return end   -- (pressed again: stop)\nNF.fixClear()\nNF.FIXM = {kit = card.getGUID(), kind = spec.fix}\nNF.INV.sig = \"\"                              -- (its own buttons go: CANCEL instead)\nlocal look = {position = board.getPosition(), pitch = NF.FIX_PITCH, yaw = (board.getRotation().y + 180) % 360,\ndistance = NF.FIX_DIST}\nif NF.FIX[spec.fix] and NF.FIX[spec.fix].wounds then\nlocal c = NF.invFocus(board)\nif c then look.position, look.distance = c, NF.HEAL_DIST end\nend\npcall(function() Player[color].lookAt(look) end)\nNF.fixShow()\nreturn\nend\nif what == \"all\" then                          -- Dried Fruit: every cube eaten at once, hunger for each, a Good card onto the discard pile\nif not spec.all or #cubes < spec.n then return end\nfor _, c in ipairs(cubes) do c.destruct() end\nlocal from, to = nil, nil\nlocal n = (spec.eat or 0) * #cubes\nif spec.eat then from, to = NF.hungerUp(board, n) end\nlocal good = NF.goodToDiscard(color)         -- (user, live test: onto the discard pile, not into the hand)\nNF.say(\"ate all of \" .. card.getName() .. (spec.eat and NF.eatText(from, to, n) or \"\")\n.. (good and \", a Good card onto the discard pile\" or \"\"))\nNF.INV.sig = \"\"\nreturn\nend\ntable.sort(cubes, function(a, b) return a.getPosition().y > b.getPosition().y end)\ncubes[1].destruct()                            -- (back into the seat's endless cube bag)\nlocal left = #cubes - 1\nif what == \"use\" and spec.food then            -- a food card: EAT (the hunger cube up, if the card says by how much)\nlocal from, to = nil, nil\nif spec.eat then from, to = NF.hungerUp(board, spec.eat) end\nNF.say(\"ate from \" .. card.getName() .. (spec.eat and NF.eatText(from, to, spec.eat) or \"\") .. \" (\" .. left .. \" left)\",\n\"Eat: \" .. card.getName())\nelseif what == \"use\" then\nlocal g = spec.gain and NF.gainText(spec.gain) or \"\"\nlocal done = NF.CUBE_DONE[spec.word or (spec.book and \"READ\") or \"USE\"] or \"used\"\nif spec.good == \"discard\" then g = g .. (g ~= \"\" and \", \" or \"\") .. \"a Good card onto the discard pile\"