them\nlocal B = {lines = {}, snaps = {}, seqs = {}, base = p.base or 0}\nfor i, l in ipairs(p.lines) do\nB.lines[i] = l\nB.snaps[i] = type(p.snaps) == \"table\" and p.snaps[i] or nil\nB.seqs[i] = type(p.seqs) == \"table\" and p.seqs[i] or nil\nend\nNF.HIST.by[seat] = B\nelseif type(p.i) == \"number\" then              -- one line (new or changed); out of step: all of that seat again\nlocal B = NF.HIST.by[seat]\nif not B or (B.base or 0) ~= (p.base or 0) or p.i > #B.lines + 1 then\nNF.histPullSeat(seat)\nreturn\nend\nB.lines[p.i], B.snaps[p.i], B.seqs[p.i] = p.line, p.snap, p.seq\nelse\nreturn\nend\nlocal own = NF.HIST.by[CFG.seat] or {lines = {}, snaps = {}, seqs = {}}\nNF.HIST.lines, NF.HIST.snaps = own.lines, own.snaps   -- (this seat's own, as before)\nif not (NF.HR and NF.HR.on) and (NF.HIST.off or 0) == 0 then   -- (at the newest: the newest stays in view)\nNF.histView()\nNF.histRender()\nelse\nNF.histFocusKeep(function() end)             -- (looking back: the same line stays in focus)\nend\nend\nfunction NF.histPush(i)                          -- (the keeper) to every seat's HISTORY module: line i, or all\nlocal h = NF.HIST\nlocal p\nif i then\np = {seat = CFG.seat, i = i, line = h.lines[i], snap = (h.snaps or {})[i], seq = (h.seqs or {})[i], base = h.base or 0}\nelse\np = historyLines()\nend\nfor _, m in ipairs(NF.histModules(\"HISTORY\")) do\nif m ~= self then pcall(function() m.call(\"historyShow\", p) end) end\nend\nend\nfunction NF.histPullSeat(seat)                   -- (a HISTORY module) all lines of one seat from its keeper\nfor _, k in ipairs(NF.histModules(NF.HIST_KEEPER)) do\nif k ~= self and k.hasTag(\"TrayGrid_\" .. seat) then\nlocal ok, r = pcall(function() return k.call(\"historyLines\", {}) end)\nif ok and type(r) == \"table\" and type(r.lines) == \"table\" then\nr.seat = r.seat or seat\nhistoryShow(r)\nend\nend\nend\nend\nfunction NF.histPull()                           -- (a HISTORY module) all lines so far, of every seat\nfor _, k in ipairs(