e(\"hgrow\", \"image\", NF.HIST.big and \"hshrink\" or \"hexpand\")\nend)\nNF.HIST_LINE_H = s.line\nNF.histRender()\nend\nfunction NF.histSetup()\nif CFG.name ~= \"HISTORY\" or IS_COPY then return end\nlocal files = CFG.files or {}\npcall(function()                               -- the toggle's two icons (playercubes\\tray_new_modules_v1)\nself.UI.setCustomAssets({{name = \"hexpand\", url = files[\"history_expand_v1.png\"] or \"\"},\n{name = \"hshrink\", url = files[\"history_shrink_v2.png\"] or \"\"},\n{name = \"hrmap\", url = files[\"history_map_v1.jpg\"] or \"\"},   -- (the replay's small map)\n{name = \"hrfig\", url = files[\"history_fig_v1.png\"] or \"\"},   -- (and its icons)\n{name = \"hrbed\", url = files[\"history_bed_v1.png\"] or \"\"},\n{name = \"hrenemy\", url = files[\"history_enemy_v1.png\"] or \"\"}})\nend)\nNF.HIST_LINE_H = NF.histSize().line\nself.UI.setXml(NF.histXml())\nWait.time(function() NF.histRender() NF.histPull() end, 0.5)   -- (put out later: everything so far)\nend\nfunction NF.histKeeperSetup()                    -- (the keeper) where the figure stands, for the first move's line\nif CFG.name ~= NF.HIST_KEEPER or IS_COPY then return end\nlocal fig = getObjectsWithTag(\"PlayerFigure_\" .. CFG.seat)[1]\nif fig and not NF.HIST.space then NF.HIST.space = NF.spaceAt(fig.getPosition()) end\nend\nNF.HENRY_DAY = {{-74.07, -7.20, 45}, {-74.40, 7.02, 135}, {-59.83, 7.31, 225}}   -- (as the controller's: the user's layout)\nNF.HENRY_DECK = {-60.91, -16.72, 90}\nNF.TIME_BOARD_REF = {x = -67.0, z = 0.0, yaw = 90}\nfunction NF.timeBoardShift(s)\nlocal tb = getObjectsWithTag(\"TimeBoard\")[1]\nif not tb then return s[1], s[2], s[3] end\nlocal p, r = tb.getPosition(), tb.getRotation().y\nlocal d = math.rad(r - NF.TIME_BOARD_REF.yaw)\nlocal dx, dz = s[1] - NF.TIME_BOARD_REF.x, s[2] - NF.TIME_BOARD_REF.z\nlocal c, sn = math.cos(d), math.sin(d)\nreturn p.x + dx * c + dz * sn, p.z - dx * sn + dz * c, (s[3] + r - NF.TIME_BOARD_REF.yaw) % 360\nend\nfunction NF.henryDeck()\nlocal a = NF.anchor(\"deck\")\nif a and CFG.name == \"HENRY\" then\nlocal h = math.max(NF.SIZE.henryDeck[1], NF.SIZE.henryDeck[2]) / 2 + 0.3   -- (v6: the card lies the other way)\nlocal p = NF.pileIn(self, a.x, a.z, h, h)\nif p then return p end\nend\nlocal hd = NF.controllerTable(\"HENRY_DECK\") or NF.HENRY_DECK\nlocal x, z = NF.timeBoardShift(hd)\nlocal p = NF.pileAtWorld(x, z, 2)\nif p then return p end\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Deck\" and o.getName() == \"Solo Deck (Henry)\" and not isHeld(o) then return o end\nend\nend\nfunction NF.henryDaySpots()\nlocal out = {}\nif CFG.name == \"HENRY\" then\nfor i = 1, 3 do\nlocal w, yaw = anchorWorld({name = \"day\" .. i}), anchorYaw({name = \"day\" .. i})\nif not (w and yaw) then out = {} break end\nout[i] = {w.x, w.z, yaw, y = w.y}\nend\nif #out == 3 then return out end\nend\nfor i, s in ipairs(NF.controllerTable(\"HENRY_DAY\") or NF.HENRY_DAY) do\nlocal x, z, yaw = NF.timeBoardShift(s)\nout[i] = {x, z, yaw}\nend\nreturn out\nend\nfunction NF.henryDeal(color)\nNF.serial(function()\nlocal todo = {}\nfor i, s in ipairs(NF.henryDaySpots()) do\nif not NF.pileAtWorld(s[1], s[2], 1.5) then todo[#todo + 1] = {i = i, x = s[1], z = s[2], yaw = s[3], y = s.y} end\nend\nif #todo == 0 then NF.tell(color, \"Henry's 3 day cards are already out.\") return end\nlocal dealt = 0\nlocal function one(k)\nif k > #todo then\nbroadcastToAll(\"[FFFFFF][HENRY][-] \" .. dealt .. \" day card\" .. (dealt == 1 and \"\" or \"s\") .. \" laid out face down\", {1, 1, 1})\nif dealt < #todo then NF.tell(color, \"Henry's action deck is empty (\" .. dealt .. \" of \" .. #todo .. \" dealt).\") end\nreturn\nend\nlocal d = NF.henryDeck()\nif not d then one(#todo + 1) return end\nlocal s = todo[k]\nlocal pos, rot = {s.x, NF.henryDrop(s.y), s.z}, {0, s.yaw, 180}\nif d.type == \"Deck\" then d.takeObject({position = pos, rotation = rot, smooth = true})\nelse d.setPositionSmooth(pos, false, true) d.setRotationSmooth(rot, fal