.sig = \"\"\nWait.time(NF.fixShow, 0.3)                     -- (once the token and the cube are gone)\nend\nNF.WOUND_YAW = 0          -- (user, 2026-11-05, from the picture: \"left side is correct\" - a wound lies straight, like the board)\nfunction NF.woundDrop(obj)\nif obj.type ~= \"Card\" or not obj.hasTag(\"WoundToken\") then return end\nWait.time(function()\nif obj.isDestroyed() or isHeld(obj) then return end\nlocal board = NF.invBoard()\nif not (board and NF.invInside(board, obj.getPosition())) then return end\nlocal r = obj.getRotation()\nlocal want = (board.getRotation().y + NF.WOUND_YAW) % 360\nif math.abs(((r.y - want + 180) % 360) - 180) > 5 then obj.setRotationSmooth({r.x, want, r.z}, false, true) end\nend, 0.4)\nend\nfunction NF.woundUnderDeck(w)\nlocal deck = nil\nfor _, o in ipairs(getObjectsWithTag(\"WoundDeck\")) do if o.type == \"Deck\" and not isHeld(o) then deck = o break end end\nif not deck then                               -- (no deck left: the tile lies down where the deck belongs)\nlocal spot = NF.nearestNamed(\"Middle: Wound\", w.getPosition())\nif spot then\nlocal p = spot.getPosition()\nw.setRotationSmooth({0, spot.getRotation().y, 180}, false, true)\nw.setPositionSmooth({p.x, p.y + 1, p.z}, false, true)\nw.addTag(\"WoundDeck\")\nend\nreturn\nend\nNF.underDeck(w, deck)\nend\nfunction NF.underDeck(w, deck)\nif w.hasTag(\"SoldAtCalc\") then w.removeTag(\"SoldAtCalc\") end   -- (sold at Calculate: back in its deck as it was)\nlocal p, r = deck.getPosition(), deck.getRotation()\nlocal name, tags, locked = deck.getName(), deck.getTags(), deck.getLock()\ndeck.setLock(false)\ndeck.setPosition({p.x, p.y + 1.5, p.z})\nw.setRotation({r.x, r.y, r.z})\nw.setPosition({p.x, p.y, p.z})\nWait.frames(function()\nif w.isDestroyed() or deck.isDestroyed() then return end\nw.putObject(deck)                            -- (the deck onto the tile: the tile ends up at the bottom)\nWait.frames(function()\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Deck\"