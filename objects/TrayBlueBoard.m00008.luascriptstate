le\") then   -- (the horse carries its circles: it covers none)\nlocal food = false\nfor _, t in ipairs(NF.INV.tokenTags) do if o.hasTag(t) then food = true break end end\nlocal b = (not food) and o.getBounds()\nif b and math.abs(b.center.y - y0) < 1.5 then\nfor _, i in ipairs(NF.invUnder(o, slots, b)) do blocked[i] = true end\nend\nif not food and (o.hasTag(\"WoundToken\") or o.hasTag(\"AnimalTile\")) then\nhalves = halves or NF.invHalves(board, slots)\nlocal hi = NF.invHalfAt(halves, o.getPosition())\nif hi then for _, c in ipairs(halves[hi].circles) do blocked[c] = true end end\nend\nend\nend\nreturn blocked\nend\nfunction NF.invUnder(o, slots, b)\nlocal out = {}\nb = b or o.getBounds()\nlocal hx, hz = b.size.x / 2 - 0.15, b.size.z / 2 - 0.15      -- (an edge just touching a circle does not count)\nfor i, s in ipairs(slots) do\nif math.abs(s.w.x - b.center.x) < hx and math.abs(s.w.z - b.center.z) < hz then out[#out + 1] = i end\nend\nreturn out\nend\nfunction NF.invHalfAt(halves, p)\nlocal at, bd = nil, 1.6 * 1.6\nfor hi, h in ipairs(halves) do\nlocal d = NF.flat2(p, h.w)\nif d < bd and math.abs(p.y - h.w.y) < 1.5 then at, bd = hi, d end\nend\nreturn at\nend\nfunction NF.invBoxes(board, slots)\nlocal inv, red = {}, nil\nfor _, s in ipairs((NF.snaps(board))) do         -- (owner 11-11: the kept list, NF.snaps - only read)\nfor _, t in ipairs(s.tags or {}) do\nif t == \"InventorySlot_\" .. CFG.seat then inv[#inv + 1] = s.position\nelseif t == \"OverloadSlot_\" .. CFG.seat then red = s.position end\nend\nend\ntable.sort(inv, function(a, b) if math.abs(a.z - b.z) > 0.3 then return a.z < b.z end return a.x > b.x end)\nlocal out = {}\nfor i, p in ipairs(inv) do out[#out + 1] = {code = (\"ABCD\"):sub(i, i), l = p} end\nfor _, b in ipairs(out) do b.w = board.positionToWorld(b.l) end\nlocal horse = NF.horseOf()\nif horse then\nlocal full, half = {}, {}\nfor _, s in ipairs((NF.snaps(horse))) do\nfor _, t in ipairs(s.tags or {}) do\nif t == \"HorseSlot\" then full[#full + 1] = s.position elseif t == \"HorseHalf\" then half[#half + 1] = s.position end\nend\nend\ntable.sort(full, function(a, b) return a.x > b.x end)\ntable.sort(half, function(a, b) return a.x > b.x end)\nlocal hy = horse.getRotation().y\nfor i, p in ipairs(full) do\nlocal w = horse.positionToWorld(p)\nout[#out + 1] = {code = \"H\" .. i, l = board.positionToLocal(w), w = w, horse = true, yaw = hy}\nend\nfor i, p in ipairs(half) do\nlocal w = horse.positionToWorld(p)\nout[#out + 1] = {code = \"Hh\" .. i, l = board.positionToLocal(w), w = w, horse = true, half = true, yaw = hy}\nend\nend\nif red then out[#out + 1] = {code = \"R\", l = red, w = board.positionToWorld(red)} end\nfor _, b in ipairs(out) do b.circles = {} end\nfor i, s in ipairs(slots or {}) do\nlocal q, best, bd = board.positionToLocal(s.w), nil, nil\nfor _, b in ipairs(out) do\nlocal d = (q.x - b.l.x) ^ 2 + (q.z - b.l.z) ^ 2\nif not bd or d < bd then best, bd = b, d end\nend\nif best then best.circles[#best.circles + 1] = i end\nend\nreturn out\nend\nfunction NF.invItems(board, boxes)\nlocal out = {}\nfor _, o in ipairs(getObjectsWithTag(\"ItemCard\")) do\nif o.type == \"Card\" and not isHeld(o) and not o.isSmoothMoving() then\nlocal q = board.positionToLocal(o.getPosition())\nfor bi, b in ipairs(boxes) do\nif (q.x - b.l.x) ^ 2 + (q.z - b.l.z) ^ 2 < 0.36 and math.abs(q.y - b.l.y) < 1.2 then\nlocal slot = nil                       -- (its own box, if it is equipment)\nfor _, c in ipairs({\"A\", \"B\", \"C\", \"D\", \"R\"}) do if o.hasTag(\"EquipSlot_\" .. c) then slot = c end end\nlocal own = slot == b.code\nout[#out + 1] = {o = o, box = bi, slot = slot, own = own, equipped = own and o.hasTag(\"Equipped\")}\nbreak\nend\nend\nend\nend\nreturn out\nend\nfunction NF.invOnTop(card, board)\nlocal b = card.getBounds()\nlocal out = {}\nfor _, o in ipairs(getObjects()) do\nif o ~= card and o ~= board and o ~= self and not isHeld(o) and not o.getLock() and o.type ~= \"Scripting\"\nand o.type ~= \"Surface\" and not o.hasTag(\"ItemCard\")\nand not o.hasTag(\"WoundToken\") and not o.hasTag(\"AnimalTile\") then   -- (those SORT lays into the halves itself)\nlocal food = false\nfor _, t in ipairs(NF.INV.tokenTags) do if o.hasTag(t) then food = true break end end\nlocal p = o.getPosition()\nif not food and math.abs(p.x - b.center.x) < b.size.x / 2 and math.abs(p.z - b.center.z) < b.size.z / 2\nand p.y > b.center.y - 0.05 and p.y < b.center.y + 4 then out[#out + 1] = o end\nend\nend\nreturn out\nend\nfunction NF.invLift(o, x, y, z, up, r)          -- lifted, carried over, set down (as SORT moves tokens)\no.setPositionSmooth({x, y + up, z}, false, true)\nWait.time(function() if not o.isDestroyed() then\no.setPositionSmooth({x, y, z}, false, true)\no.setRotationSmooth(r, false, true) end end, 0.6)\nend\nNF.INV.placing = {}\nNF.INV.CARDS = 8                                 -- item cards with buttons (board 5 + the horse's 3)                              -- box code -> os.clock() until it counts as taken (a card on its way)\nfunction NF.placedWhere(r)                    -- (invPlace's answer as words)\nlocal s = type(r) == \"string\" and r:match(\"^W:(.+)$\")\nreturn s and (\" → worn (\" .. s .. \" slot)\") or \" → inventory\"\nend\nfunction invPlace(p)\nif CFG.name ~= \"BOARD\" then return false end\nlocal card = getObjectFromGUID(type(p) == \"table\" and p.guid or \"\")\nlocal board = NF.invBoard()\nif not (card and board) then return false end\n-- (user, 2026-11-06: \"taking an item when its slot is empty will automatically equip it: weapon into the weapon slot,\n-- bow into bow, etc.\") the board's worn slots first (their snap tags match the card's SlotWeapon, SlotBow, ...)\nfor _, s in ipairs(board.getSnapPoints() or {}) do\nlocal tag = nil\nfor _, t in ipairs(s.tags or {}) do if t:match(\"^Slot%u\") and card.hasTag(t) then tag = t end end\nif tag then\nlocal taken = (NF.INV.placing[tag] or 0) > os.clock()\nfor _, o in ipairs(getObjectsWithTag(\"ItemCard\")) do\nif o ~= card and o.type == \"Card\" and not isHeld(o) then\nlocal q = board.positionToLocal(o.getPosition())\nif (q.x - s.position.x) ^ 2 + (q.z - s.position.z) ^ 2 < 0.36 and math.abs(q.y - s.position.y) < 1.2 then taken = true end\nend\nend\nif not taken then\nNF.INV.placing[tag] = os.clock() + 2.5\nlocal w = board.positionToWorld(s.position)\ncard.setLock(false)\nNF.invLift(card, w.x, w.y + 0.08, w.z, 1.5, {0, board.getRotation().y, 0})\nNF.INV.sig = \"\"\nreturn \"W:\" .. tag:sub(5):lower()\nend\nend\nend\nlocal all = NF.invSlots(board)\nlocal boxes = NF.invBoxes(board, all)\nlocal items = NF.invItems(board, boxes)\nlocal blocked = NF.invBlocked(board, all, {[card.getGUID()] = true})\nlocal toks = NF.invTokens(board, all)\nlocal used = {}\nfor _, it in ipairs(items) do used[it.box] = true end\nfor _, t in ipairs(toks) do blocked[t.slot] = true end\nlocal now = os.clock()\nfor bi, b in ipairs(boxes) do\nlocal free = not b.half and not used[bi] and not ((NF.INV.placing[b.code] or 0) > now)\nfor _, c in ipairs(b.circles) do if blocked[c] then free = false end end\nif free then\nNF.INV.placing[b.code] = now + 2.5\nlocal yaw = b.yaw or board.getRotation().y    -- (on the horse: turned as the horse lies)\ncard.setLock(false)\nNF.invLift(card, b.w.x, b.w.y + 0.08, b.w.z, 1.5, {0, yaw, 0})\nNF.INV.sig = \"\"\nif NF.CUBES[card.getName()] then NF.cubeDrop(card) end   -- (a script move is no drop: its cubes asked for here)\nreturn b.code\nend\nend\nreturn false\nend\nfunction horsePlace(p)\nif CFG.name ~= \"BOARD\" then return false end\nlocal card = getObjectFromGUID(type(p) == \"table\" and p.guid or \"\")\nlocal m, board = NF.module(\"HORSE\"), NF.invBoard()\nif not (card and m and board) then return false end\nlocal old = NF.horseOf()\nif old and old ~= card then return \"have\" end\nlocal at = nil\nfor _, sp in ipairs(m.getSnapPoints() or {}) do\nfor _, t in ipairs(sp.tags or {}) do if t == \"HorseTile\" then at = m.positionToWorld(sp.position) end end\nend\nat = at or m.getPosition()\ncard.setLock(false)\nNF.invLift(card, at.x, at.y + 0.1, at.z, 2.0, {0, board.getRotation().y, 0})\nNF.INV.sig = \"\"\nreturn \"placed\"\nend\nfunction NF.invHalves(board, slots, boxes)\nlocal out = {}\nlocal function add(obj, tag, horse, red)\nlocal list = {}\nfor _, s in ipairs(obj.getSnapPoints() or {}) do\nfor _, t in ipairs(s.tags or {}) do\nif t == tag then list[#list + 1] = s break end\nend\nend\ntable.sort(list, function(a, b)\nif math.abs(a.position.z - b.position.z) > 0.05 then return a.position.z < b.position.z end\nreturn a.position.x > b.position.x\nend)\nlocal oy = obj.getRotation().y\nfor _, s in ipairs(list) do\nlocal turn = (s.rotation and s.rotation.y) or 90\nout[#out + 1] = {w = obj.positionToWorld(s.position), yaw = (oy + turn) % 360, oy = oy, horse = horse, red = red,\ncircles = {}, k = #out + 1}\nend\nend\nadd(board, \"InventoryHalf_\" .. CFG.seat, false, false)\nlocal horse = NF.horseOf()\nif horse then add(horse, \"HorseMedium\", true, false) end\nadd(board, \"OverloadHalf_\" .. CFG.seat, false, true)\nfor i, s in ipairs(slots or {}) do              -- each circle into the half it lies in (its two circles, ~0.9 away)\nlocal best, bd = nil, 1.5 * 1.5\nfor _, h in ipairs(out) do\nlocal d = NF.flat2(s.w, h.w)\nif d < bd and math.abs(s.w.y - h.w.y) < 1.2 then best, bd = h, d end\nend\nif best then best.circles[#best.circles + 1] = i end\nend\nboxes = boxes or NF.invBoxes(board, slots)\nfor _, h in ipairs(out) do                      -- (each half's box: the nearest box middle)\nlocal bi, bd = 999, nil\nfor j, b in ipairs(boxes) do\nlocal d = NF.flat2(h.w, b.w)\nif not bd or d < bd then bi, bd = j, d end\nend\nh.box = bi\nend\ntable.sort(out, function(a, b) if a.box ~= b.box then return a.box < b.box end return a.k < b.k end)\nreturn out\nend\nfunction NF.invAnimals(board, halves, tag)\nlocal out = {}\nfor _, o in ipairs(getObjectsWithTag(tag or \"AnimalTile\")) do\nif not isHeld(o) and not o.isSmoothMoving() and (tag ~= \"WoundToken\" or o.type == \"Card\") then\nlocal p = o.getPosition()\nlocal at = NF.invHalfAt(halves, p)\nif at or NF.invInside(board, p) then out[#out + 1] = {o = o, half = at} end\nend\nend\ntable.sort(out, function(a, b) return (a.half or 999) < (b.half or 999) end)\nreturn out\nend\nfunction NF.newWorth(kind)\nif kind == \"meat\" then return {order = 10} end\nif kind == \"mushroom\" then return {order = 20} end\nlocal v = NF.INV.flower[(kind:sub(1, 1):upper()) .. kind:sub(2)]\nreturn {order = 40 + (v and v[3] or 9)}\nend\nfunction NF.invPlan(board, want)\nwant = want or {}\nlocal all = NF.invSlots(board)\nlocal boxes = NF.invBoxes(board, all)\nlocal halves = NF.invHalves(board, all, boxes)\nlocal items, skip, tops = NF.invItems(board, boxes), {}, {}\nfor _, it in ipairs(items) do\nskip[it.o.getGUID()] = true\ntops[it] = NF.invOnTop(it.o, board)\nfor _, m in ipairs(tops[it]) do skip[m.getGUID()] = true end\nend\nlocal animals, wounds = {}, NF.invAnimals(board, halves, \"WoundToken\")\nfor _, a in ipairs(NF.invAnimals(board, halves)) do      -- (the new tile, lying by the inventory, is no old one)\nif not (want.tile and a.o.getGUID() == want.tile.getGUID()) then animals[#animals + 1] = a end\nend\nfor _, a in ipairs(animals) do skip[a.o.getGUID()] = true end\nfor _, a in ipairs(wounds) do skip[a.o.getGUID()] = true end\nif want.tile then skip[want.tile.getGUID()] = true end\nlocal rank, order = {}, {}\nfor bi, b in ipairs(boxes) do for _, c in ipairs(b.circles) do rank[c] = bi end end\nfor i = 1, #all do order[i] = i end\ntable.sort(order, function(a, b)\nif (rank[a] or 999) ~= (rank[b] or 999) then return (rank[a] or 999) < (rank[b] or 999) end\nreturn a < b\nend)\nlocal ctx = {board = board, all = all, boxes = boxes, halves = halves, items = items, tops = tops, animals = animals,\nwounds = wounds, other = NF.invBlocked(board, all, skip),   -- (cards not on a box ...: they stay)\ntoks = NF.invTokens(board, all), want = want, order = order}\nlocal plan = NF.invLayout(ctx, true)\nif want.tile and plan.newTile then              -- (the new tile found a half: is anything old held back for it?)\nlocal without = NF.invLayout(ctx, false)\nif plan.stuck > without.stuck then plan = without end\nend\nreturn plan\nend\nfunction NF.invLayout(ctx, withTile)\nlocal all, boxes, halves, want = ctx.all, ctx.boxes, ctx.halves, ctx.want\nlocal keep = {c = {}, o = {}}\nlocal function pass()\nlocal plan = {board = ctx.board, all = all, boxes = boxes, halves = halves, items = {}, tiles = {}, toks = {},\nover = {}, stuck = 0}\nlocal covered, taken, used = {}, {}, {}\nfor c in pairs(ctx.other) do covered[c] = true end\nfor c in pairs(keep.c) do covered[c] = true end\nlocal function hold(o, cs)                   -- (it stays, but its circles were given away: held, laid out again)\nkeep.o[o.getGUID()] = true\nfor _, c in ipairs(cs) do keep.c[c] = true end\nplan.again = true\nend\nfor _, it in ipairs(ctx.items) do\nif it.equipped then\ntaken[it.box] = true\nfor _, c in ipairs(boxes[it.box].circles) do covered[c] = true end\nend\nend\nlocal open = {}\nfor bi, b in ipairs(boxes) do\nlocal clear = not taken[bi] and not b.half    -- (a horse's half box takes no item card)\nfor _, c in ipairs(b.circles) do if covered[c] then clear = false end end\nif clear then open[#open + 1] = bi end\nend\nlocal moving, isOpen, extra, k = {}, {}, #open, 0\nfor _, bi in ipairs(open) do isOpen[bi] = true end\nfor _, it in ipairs(ctx.items) do\nif not it.equipped then\nmoving[#moving + 1] = it\nif isOpen[it.box] then extra = extra - 1 end\nend\nend\ntable.sort(moving, function(a, b) return a.box < b.box end)\nfor _, it in ipairs(moving) do\nlocal to = it.box\nif isOpen[it.box] or extra > 0 then\nif not isOpen[it.box] then extra = extra - 1 end\nk = k + 1\nto = open[k] or it.box\nend\nfor _, c in ipairs(boxes[to].circles) do covered[c] = true end\nplan.items[#plan.items + 1] = {it = it, to = to, tops = ctx.tops[it]}\nend\nlocal list = {}\nfor _, a in ipairs(ctx.animals) do list[#list + 1] = {o = a.o, from = a.half} end\nif want.tile and withTile then list[#list + 1] = {o = want.tile, new = true, wound = want.tile.hasTag(\"WoundToken\") or nil}\nelseif want.tile then plan.over[#plan.over + 1] = {tile = want.tile} end\nfor _, a in ipairs(ctx.wounds) do list[#list + 1] = {o = a.o, from = a.half, wound = true} end\nfor _, t in ipairs(list) do\nif keep.o[t.o.getGUID()] then              -- (held where it lies: its circles are covered already)\nplan.stuck = plan.stuck + 1\nif t.from then used[t.from] = true end\nelse\nlocal to = nil\nfor hi, h in ipairs(halves) do\nlocal ok = not used[hi] and #h.circles > 0 and not (t.wound and h.horse)\nfor _, c in ipairs(h.circles) do if covered[c] then ok = false end end\nif ok then to = hi break end\nend\nif to then\nused[to] = true\nfor _, c in ipairs(halves[to].circles) do covered[c] = true end\nplan.tiles[#plan.tiles + 1] = {o = t.o, to = to, new = t.new, wound = t.wound}\nif t.new then plan.newTile = true end\nelseif t.new then\nplan.over[#plan.over + 1] = {tile = t.o}\nelse                                     -- (no free half: it stays where it lies)\nlocal cs = t.from and halves[t.from].circles or NF.invUnder(t.o, all)\nfor _, c in ipairs(cs) do if covered[c] then hold(t.o, cs) return plan end end\nfor _, c in ipairs(cs) do covered[c] = true end\nif t.from then used[t.from] = true end\nplan.stuck = plan.stuck + 1\nend\nend\nend\nlocal free, toks = {}, {}\nfor _, c in ipairs(ctx.order) do if not covered[c] then free[#free + 1] = c end end\nfor _, t in ipairs(ctx.toks) do\nif keep.o[t.o.getGUID()] then plan.stuck = plan.stuck + 1 else toks[#toks + 1] = t end\nend\nlocal news = {}\nfor _, k in ipairs(want.tokens or {}) do news[#news + 1] = {kind = k, worth = NF.newWorth(k), slot = 100000 + #news} end\nlocal function byOrder(a, b)\nif a.worth.order ~= b.worth.order then return a.worth.order < b.worth.order end\nreturn a.slot < b.slot\nend\nlocal order = {}\nif #free >= #toks + #news then               -- (room for all: everything in the fixed order)\nfor _, t in ipairs(toks) do order[#order + 1] = t end\nfor _, t in ipairs(news) do order[#order + 1] = t end\ntable.sort(order, byOrder)\nelse                                         -- (not enough: the old ones first, the new ones after them)\ntable.sort(toks, byOrder)\ntable.sort(news, byOrder)\nfor _, t in ipairs(toks) do order[#order + 1] = t end\nfor _, t in ipairs(news) do order[#order + 1] = t end\nend\nfor i, t in ipairs(order) do\nlocal c = free[i]\nif c then\nplan.toks[#plan.toks + 1] = {o = t.o, kind = t.kind, from = t.o and t.slot or nil, to = c}\nelseif t.kind then\nplan.over[#plan.over + 1] = {kind = t.kind}\nelse                                       -- (an old token without a free circle stays where it is)\nhold(t.o, {t.slot}) return plan\nend\nend\nreturn plan\nend\nlocal plan = nil\nfor _ = 1, 100 do\nplan = pass()\nif not plan.again then break end\nend\nreturn plan\nend\nNF.INV_CARD_DROP = 0.12                          -- a sorted card is set down this high over its box's surface\nfunction NF.invRun(plan)\nlocal board, boxes, halves, all = plan.board, plan.boxes, plan.halves, plan.all\nlocal moved = {}\nWait.time(function()\nfor _, mv in ipairs(moved) do\nlocal o = mv.o\nif o and not o.isDestroyed() and not isHeld(o) then\nlocal q = o.getPosition()\nif q.y < mv.y - 0.08 then o.setPositionSmooth({q.x, mv.y + NF.INV_CARD_DROP + 0.1, q.z}, false, true) end\nend\nend\nend, 2.5)\nfor i, e in ipairs(plan.items) do\nlocal it, to = e.it, e.to\nif to ~= it.box then\nlocal from, dest = boxes[it.box].w, boxes[to].w\nlocal dx, dz = dest.x - from.x, dest.z - from.z\nlocal p, r = it.o.getPosition(), it.o.getRotation()\nlocal cy = dest.y + NF.INV_CARD_DROP\nlocal rz = r.z % 360\nNF.invLift(it.o, p.x + dx, cy, p.z + dz, 1.2 + 0.05 * i, {0, r.y, (rz > 90 and rz < 270) and 180 or 0})\nfor _, m in ipairs(e.tops or {}) do\nlocal q = m.getPosition()\nNF.invLift(m, q.x + dx, cy + math.max(0.05, q.y - p.y) + 0.05, q.z + dz, 1.5 + 0.05 * i, m.getRota