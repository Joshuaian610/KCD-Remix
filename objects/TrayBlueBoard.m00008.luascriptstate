t.x + ((k - 1) % 3 - 1) * 0.7, y = spot.y, z = spot.z + math.floor((k - 1) / 3) * 0.7 - 0.35}\nlocal free = at == nil\nfor _, w in ipairs(reserved) do if NF.flat2(w, c) < 0.09 then free = false end end\nfor _, p in ipairs(lying) do if NF.flat2(p, c) < 0.09 then free = false end end\nif free then at = c end\nend\nat = at or {x = spot.x, y = spot.y + 0.3 * #lying, z = spot.z}\nNF.reserve({w = at})\nbowl.takeObject({position = {at.x, at.y + 0.4, at.z}, rotation = {0, yaw, down and 180 or 0}, smooth = false})\nNF.say(\"+1 \" .. kind .. (NF.FLOWER[kind] and (down and \" potion\" or \" flower\") or \"\") .. \" (onto the character tile: no room)\")\nend\nfunction nfMeat(_, color) NF.food(\"meat\", color) end\nfunction nfMushroom(_, color) NF.food(\"mushroom\", color) end\nfunction nfDirt(_, color) NF.food(\"dirt\", color) end\nfunction nfFlowerWhite(_, color, alt) NF.food(\"white\", color, nil, alt == true) end\nfunction nfFlowerYellow(_, color, alt) NF.food(\"yellow\", color, nil, alt == true) end\nfunction nfFlowerOrange(_, color, alt) NF.food(\"orange\", color, nil, alt == true) end\nfunction nfFlowerRed(_, color, alt) NF.food(\"red\", color, nil, alt == true) end\nfunction nfFlowerBlue(_, color, alt) NF.food(\"blue\", color, nil, alt == true) end\nNF.ONTO = {DAMAGE = {bowl = \"Shield Tokens (-3)\", tag = \"ShieldToken\", what = \"shield token\"},\nGUARDS = {bowl = \"Guard Tokens\", tag = \"GuardToken\", what = \"guard token\"}}\nfunction NF.onto(color)\nlocal e = NF.ONTO[CFG.name]\nif not e then return end\nlocal bowl = NF.nearestNamed(e.bowl, self.getPosition())\nif not bowl then NF.tell(color, \"No \" .. e.bowl .. \" on the table.\") return end\nif bowl.type ~= \"Infinite\" and not tostring(bowl.name):find(\"Infinite\", 1, true) and #(bowl.getObjects() or {}) == 0 then NF.tell(color, e.bowl .. \" is empty.\") return end\nlocal a = NF.anchor(\"token\")\nlocal w = self.positionToWorld({-a.x, NF.btnY(a), a.z})\nlocal n = 0\nfor _, o in ipairs(getObjectsWithTag(e.tag)) d