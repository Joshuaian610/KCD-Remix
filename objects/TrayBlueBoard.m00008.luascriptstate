thTag(\"HorseTile\")) do\nif o.type == \"Card\" and not isHeld(o) then\nlocal p = o.getPosition()\nif math.abs(p.x - mb.center.x) < mb.size.x / 2 and math.abs(p.z - mb.center.z) < mb.size.z / 2\nand p.y > mb.center.y - 1 and p.y < mb.center.y + 4 then return o end\nend\nend\nreturn nil\nend\nfunction NF.invSlots(board)\nlocal out = {}\nlocal horse = NF.horseOf()\nlocal sources = {{board, \"Inventory_\" .. CFG.seat}}\nif horse then sources[#sources + 1] = {horse, \"HorseInventory\"} end\nsources[#sources + 1] = {board, \"InventoryRed_\" .. CFG.seat}\nfor _, src in ipairs(sources) do\nlocal obj, tag = src[1], src[2]\nfor _, r in ipairs(NF.slotPairs(obj, tag)) do\nlocal pair = {{r[1], r[2]}, {r[2], r[1]}}\nfor _, pq in ipairs(pair) do\nlocal p, q = pq[1], pq[2]\nif p then\nlocal cz = q and q.z or (p.z + 0.75)\nlocal cx = q and (p.x + (p.x - q.x) * 0.21) or p.x\nlocal info = q and {(p.x + q.x) / 2, p.y, p.z + (p.z - q.z) * 1.1} or {p.x - 0.55, p.y, p.z + 0.45}\nout[#out + 1] = {w = obj.positionToWorld(p), corner = obj.positionToWorld({cx, p.y, cz}),\ninfo = obj.positionToWorld(info), red = tag:find(\"Red\") ~= nil, horse = obj == horse}\nif q then out[#out].pw = obj.positionToWorld(q) end   -- (the box's other circle: NF.invIconPair)\nend\nend\nend\nend\nreturn out\nend\nfunction NF.invTokens(board, slots)\nlocal out = {}\nfor _, o in ipairs(getObjectsWithAnyTags({\"MeatToken\", \"MushroomToken\", \"FlowerToken\"})) do\nif not isHeld(o) and not o.isSmoothMoving() then\nlocal p = o.getPosition()\nfor i, s in ipairs(slots) do\nif NF.flat2(p, s.w) < 0.5 and math.abs(p.y - s.w.y) < 1.2 then\nlocal w = NF.invWorth(o)\nif w then out[#out + 1] = {o = o, worth = w, slot = i} end\nbreak\nend\nend\nend\nend\nreturn out\nend\nNF.SNAP_TTL = 20\nNF.SNAPC = {}\nfunction NF.snaps(obj)\nlocal g = obj.getGUID()\nlocal now = os.clock()\nlocal c = NF.SNAPC[g]\nif c and now >= c.t and now - c.t < NF.SNAP_TTL then return c.list, c end\nlocal old = {}                                 -- (entries past their time go: e.g. a card that left the table)\nfor k, e in pairs(NF.SNAPC) do if now < e.t or now - e.t >= NF.SNAP_TTL then old[#old + 1] = k end end\nfor _, k in ipairs(old) do NF.SNAPC[k] = nil end\nlocal list = obj.getSnapPoints() or {}\nif #list > 0 then NF.SNAPC[g] = {t = now, list = list, made = {}} end\nreturn list, NF.SNAPC[g]\nend\nfunction NF.snapMade(obj, key, fn)\nlocal list, c = NF.snaps(obj)\nif not c then return fn(list) end\nlocal v = c.made[key]\nif v == nil then\nv = fn(list)\nc.made[key] = v\nend\nreturn v\nend\nNF.horseOf0 = NF.horseOf\nfunction NF.horseOf()\nlocal memo = NF.HORSE_MEMO\nif memo and memo.done then return memo.o end\nlocal o = NF.horseOf0()\nif memo then memo.done, memo.o = true, o end\nreturn o\nend\nNF.invSlots0 = NF.invSlots\nfunction NF.invSlots(board)\nlocal _, e = NF.snaps(board)\nif not e then return NF.invSlots0(board) end\nlocal horse = NF.horseOf()\nlocal p, r = board.getPosition(), board.getRotation()\nlocal key = string.format(\"%.3f %.3f %.3f %.2f %.2f %.2f\", p.x, p.y, p.z, r.x, r.y, r.z)\nif horse then\np, r = horse.getPosition(), horse.getRotation()\nkey = key .. string.format(\" %s %.3f %.3f %.3f %.2f %.2f %.2f\", horse.getGUID(), p.x, p.y, p.z, r.x, r.y, r.z)\nend\nlocal c = e.made.invSlots\nif c and c.key == key then return c.slots end\nlocal slots = NF.invSlots0(board)\ne.made.invSlots = {key = key, slots = slots}\nreturn slots\nend\nNF.MODC = {}\nNF.module0 = NF.module\nfunction NF.module(name)\nif CFG.name == name then return NF.module0(name) end\nlocal m = NF.MODC[name]\nif m then\nlocal ok, same = pcall(function() return not m.isDestroyed() and NF.modName(m) == name end)\nif ok and same then return m end\nNF.MODC[name] = nil\nend\nlocal found = NF.module0(name)                 -- (none: the look gives no value at all - MoonSharp: not even nil)\nif not found then return nil end\nNF.MODC[name] = found\nreturn found\nend\nNF.PM_SEAT = {Blue = 0, Brown = 1, Green = 2, Orange = 3, White = 0.5, Red = 1.