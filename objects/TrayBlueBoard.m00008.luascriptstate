olor=\"#00000000\">\n<Panel id=\"hpanel\" position=\"%s\" width=\"%d\" height=\"%d\" color=\"#101A2CF2\" outline=\"#C9A04F\" outlineSize=\"2 -2\"> </Panel>\n<Text id=\"hlines\" position=\"%s\" width=\"%d\" height=\"%d\" alignment=\"LowerLeft\" fontSize=\"%d\" color=\"#E8DDC4\"\nhorizontalOverflow=\"Wrap\" verticalOverflow=\"Truncate\"> </Text>\n<Button id=\"hup\" position=\"%s\" width=\"56\" height=\"50\" fontSize=\"30\" textColor=\"#F1DDB0\" active=\"false\"\ncolors=\"#1E4167|#265183|#2A5A90|#1E4167\" onClick=\"historyUp\">&#9650;</Button>\n<Button id=\"hdown\" position=\"%s\" width=\"56\" height=\"50\" fontSize=\"30\" textColor=\"#F1DDB0\" active=\"false\"\ncolors=\"#1E4167|#265183|#2A5A90|#1E4167\" onClick=\"historyDown\">&#9660;</Button>\n<Text id=\"hinfo\" position=\"%s\" width=\"150\" height=\"50\" alignment=\"MiddleRight\" fontSize=\"22\" color=\"#C9B48A\"> </Text>\n<Button id=\"hgrow\" position=\"%s\" width=\"54\" height=\"54\" image=\"%s\" colors=\"#FFFFFF|#FFFFFFDD|#FFFFFFBB|#FFFFFF\"\nonClick=\"historyGrow\"> </Button>\n<Button id=\"hreplay\" position=\"%s\" width=\"150\" height=\"54\" fontSize=\"24\" textColor=\"#F1DDB0\" active=\"%s\"\ncolors=\"#1E4167|#265183|#2A5A90|#1E4167\" onClick=\"historyReplay\">Replay</Button>\n<Button id=\"hall\" position=\"%s\" width=\"200\" height=\"54\" fontSize=\"22\" textColor=\"#F1DDB0\"\ncolors=\"#1E4167|#265183|#2A5A90|#1E4167\" onClick=\"historyAll\">%s</Button>\n%s\n</Panel>]], top, p.panel, s.w, s.h, p.text, p.tw, p.th, s.font, p.up, p.down, p.info, p.grow,\nNF.HIST.big and \"hshrink\" or \"hexpand\", NF.hrAt(126, -36), tostring(NF.HIST.big == true),\nNF.hrAt(320, -36), NF.HIST.all and \"[x] Show all\" or \"[  ] Show all\", NF.hrXml())\nend\nNF.HR = {on = false, i = 1, playing = false, anim = 0}\nNF.HR_MAP = {w = 1460, h = 804}\nNF.HR_SEAT_HEX = {Blue = \"#3F7FE0\", Brown = \"#8B5A2B\", Green = \"#3FA34D\", Orange = \"#E8862A\"}\nNF.HR_MAXB, NF.HR_MAXE, NF.HR_MAXP = 8, 20, 40\nfunction NF.hrAt(dx, dy)                         -- px from the panel's top-left anchor (as NF.histLayout)\nlocal L, T = NF.HIST_RECT.left * 100, NF.HIST_RECT.top * 100\nreturn string.format(\"%d %d 0\", math.floor(L + dx + 0.5), math.floor(T + dy + 0.5))\nend\nfunction NF.hrMapAt(fx, fy)                      -- a map picture fraction -> its px on the small map\nlocal M = NF.HR_MAP\nreturn NF.hrAt(20 + fx * M.w, -70 - fy * M.h)\nend\nfunction NF.hrXml()\nlocal M = NF.HR_MAP\nlocal t = {}\nlocal function add(s) t[#t + 1] = s end\nadd(string.format('<Image id=\"hrMap\" position=\"%s\" width=\"%d\" height=\"%d\" image=\"hrmap\" active=\"false\" raycastTarget=\"false\"/>',\nNF.hrAt(20 + M.w / 2, -70 - M.h / 2), M.w, M.h))\nadd(string.format('<Text id=\"hrTitle\" position=\"%s\" width=\"1040\" height=\"50\" alignment=\"MiddleLeft\" fontSize=\"26\" color=\"#F1DDB0\" active=\"false\"> </Text>',\nNF.hrAt(960, -35)))\nadd(string.format('<Text id=\"hrNums\" position=\"%s\" width=\"1460\" height=\"50\" alignment=\"MiddleCenter\" fontSize=\"26\" color=\"#E8DDC4\" active=\"false\"> </Text>',\nNF.hrAt(750, -70 - M.h - 35)))\nfor i = 1, NF.HR_MAXP do                       -- the way (under the figures)\nadd(string.format('<Image id=\"hrP%d\" position=\"0 0 0\" width=\"18\" height=\"18\" image=\"hrfig\" color=\"#FFFFFFCC\" active=\"false\" raycastTarget=\"false\"/>', i))\nend\nfor i = 1, NF.HR_MAXE do\nadd(string.format('<Image id=\"hrE%d\" position=\"0 0 0\" width=\"32\" height=\"32\" image=\"hrenemy\" active=\"false\" raycastTarget=\"false\"/>', i))\nend\nfor i = 1, NF.HR_MAXB do\nadd(string.format('<Image id=\"hrB%d\" position=\"0 0 0\" width=\"36\" height=\"36\" image=\"hrbed\" color=\"#FFFFFF\" active=\"false\" raycastTarget=\"false\"/>', i))\nend\nfor _, c in ipairs(NF.SNAP_SEATS) do\nadd(string.format('<Image id=\"hrF%s\" position=\"0 0 0\" width=\"48\" height=\"48\" image=\"hrfig\" color=\"%s\" active=\"false\" raycastTarget=\"false\"/>',\nc, NF.HR_SEAT_HEX[c] or \"#FFFFFF\"))\nend\nlocal bx = {{\"hrFirst\", \"|&lt;\", \"historyReplayFirst\"}, {\"hrPrev\", \"&lt;\", \"historyReplayPrev\"},\n{\"hrPlay\", \"Play\", \"historyReplayPlay\"}, {\"hrNext\", \"&gt;\", \"historyReplayNext\"},\n{\"hrLast\", \"&gt;|\", \"historyReplayLast\"}}\nfor k, b in ipairs(bx) do\nadd(string.format('<Button id=\"%s\" position=\"%s\" width=\"%d\" height=\"56\" fontSize=\"26\" textColor=\"#F1DDB0\" active=\"false\" colors=\"#1E4167|#265183|#2A5A90|#1E4167\" onClick=\"%s\">%s</Button>',\nb[1], NF.hrAt(480 + (k - 1) * 120, -70 - M.h - 100), b[1] == \"hrPlay\" and 110 or 90, b[3], b[2]))\nend\nadd(string.format('<Button id=\"hrList\" position=\"%s\" width=\"150\" height=\"56\" fontSize=\"24\" textColor=\"#F1DDB0\" active=\"false\" colors=\"#5A1E14|#7A2A1C|#8F3A28|#5A1E14\" onClick=\"historyReplayClose\">List</Button>',\nNF.hrAt(1380, -70 - M.h - 100)))\nreturn table.concat(t, \"\\n\")\nend\nNF.HR_PARTS = {\"hrMap\", \"hrTitle\", \"hrNums\", \"hrFirst\", \"hrPrev\", \"hrPlay\", \"hrNext\", \"hrLast\", \"hrList\"}\nfunction NF.hrSet(id, k, v) pcall(function() self.UI.setAttribute(id, k, v) end) end\nfunction NF.hrShowParts(on)                      -- the replay or the list\nfor _, id in ipairs(NF.HR_PARTS) do NF.hrSet(id, \"active\", tostring(on)) end\nfor _, id in ipairs({\"hlines\", \"hup\", \"hdown\", \"hinfo\"}) do NF.hrSet(id, \"active\", tostring(not on and id == \"hlines\")) end\nif not on then\nfor i = 1, NF.HR_MAXP do NF.hrSet(\"hrP\" .. i, \"active\", \"false\") end\nfor i = 1, NF.HR_MAXE do NF.hrSet(\"hrE\" .. i, \"active\", \"false\") end\nfor i = 1, NF.HR_MAXB do NF.hrSet(\"hrB\" .. i, \"active\", \"false\") end\nfor _, c in ipairs(NF.SNAP_SEATS) do NF.hrSet(\"hrF\" .. c, \"active\", \"false\") end\nend\nend\nfunction NF.hrNums(v)\nif not v then return \"\" end\nlocal function n(k) return tostring(v[k] or \"-\") end\nreturn string.format(\"Strength %s   Perception %s   Dexterity %s   Speech %s   Universal %s      Hunger %s      Movement %s\",\nn(\"Strength\"), n(\"Perception\"), n(\"Dexterity\"), n(\"Speech\"), n(\"Universal\"), n(\"Hunger\"), n(\"Movement\"))\nend\nfunction NF.hrDraw(i)                            -- line i as it was: everything in place, a move walked\nlocal view = NF.HIST.view or NF.histView()\nlocal n = #view\nif n == 0 then NF.hrSet(\"hrTitle\", \"text\", \"Nothing yet this game.\") return end\ni = math.max(1, math.min(n, i))\nlocal pin = NF.HIST.pin                         -- (the focus moved off a pinned line: it goes, the view is rebuilt)\nif pin and not (view[i].seat == pin.seat and view[i].seq == pin.seq) then\nlocal it = view[i]\nNF.HIST.pin = nil\nview = NF.histView()\nn = #view\nfor k, v in ipairs(view) do if v.seat == it.seat and v.seq == it.seq then i = k end end\nend\nNF.HR.i = i\nlocal it = view[i]\nlocal who = it.seat\nlocal s = it.snap\nlocal line = (it.line or \"\"):gsub(\"<[^>]*>\", \"\")\nlocal tag = (who ~= CFG.seat) and (\"[\" .. who:upper() .. \"]  \") or \"\"\nNF.hrSet(\"hrTitle\", \"text\", string.format(\"%d / %d    %s%s\", i, n, tag, line))\nNF.hrSet(\"hrNums\", \"text\", s and ((who ~= CFG.seat and (who .. \":   \") or \"\") .. NF.hrNums(s.v))\nor \"(no picture for this line: it is older than the replay)\")\nlocal function place(id, q)\nif q then NF.hrSet(id, \"position\", NF.hrMapAt(q[1], q[2])) NF.hrSet(id, \"active\", \"true\")\nelse NF.hrSet(id, \"active\", \"false\") end\nend\nfor _, c in ipairs(NF.SNAP_SEATS) do place(\"hrF\" .. c, s and s.f and s.f[c]) end\nfor k = 1, NF.HR_MAXB do\nlocal b = s and s.b and s.b[k]\nplace(\"hrB\" .. k, b and {b[2], b[3]})\nif b then NF.hrSet(\"hrB\" .. k, \"color\", NF.HR_SEAT_HEX[b[1]] or \"#FFFFFF\") end\nend\nfor k = 1, NF.HR_MAXE do place(\"hrE\" .. k, s and s.e and s.e[k]) end\nlocal path = s and s.path or {}\nfor k = 1, NF.HR_MAXP do\nplace(\"hrP\" .. k, path[k])\nif path[k] then NF.hrSet(\"hrP\" .. k, \"color\", (NF.HR_SEAT_HEX[who] or \"#FFFFFF\") .. \"CC\") end\nend\nNF.HR.anim = NF.HR.anim + 1\nlocal me = NF.HR.anim\nif #path >= 2 then\nlocal seg, f = 1, 0\nlocal function tick()\nif me ~= NF.HR.anim or not NF.HR.on then return end\nf = f + 1\nlocal a, b = path[seg], path[seg + 1]\nlocal t = f / 5\nNF.hrSet(\"hrF\" .. who, \"position\", NF.hrMapAt(a[1] + (b[1] - a[1]) * t, a[2] + (b[2] - a[2]) * t))\nif f >= 5 then seg, f = seg + 1, 0 end\nif seg < #path then Wait.time(tick, 0.05) else NF.hrNextLater(me) end\nend\nNF.hrSet(\"hrF\" .. who, \"active\", \"true\")\ntick()\nelse\nNF.hrNextLater(me)\nend\nend\nfunction NF.hrNextLater(me)                      -- playing: the next line after a moment\nif not NF.HR.playing then return end\nWait.time(function()\nif me ~= NF.HR.anim or not NF.HR.playing or not NF.HR.on then return end\nif NF.HR.i >= #(NF.HIST.view or NF.histView()) then\nNF.HR.playing = false\nNF.hrSet(\"hrPlay\", \"text\", \"Play\")\nreturn\nend\nNF.hrDraw(NF.HR.i + 1)\nend, 1.2)\nend\nfunction historyReplay()                         -- (the expanded window's Replay button) anyone may look\nif CFG.name ~= \"HISTORY\" or not NF.HIST.big then return end\nNF.HR.on, NF.HR.playing = true, false\nNF.hrShowParts(true)\nNF.hrSet(\"hreplay\", \"active\", \"false\")\nNF.hrSet(\"hrPlay\", \"text\", \"Play\")\nlocal v = NF.histView()                         -- (it starts at the line in focus: the list's bottom one)\nNF.hrDraw(math.max(1, #v - (NF.HIST.off or 0)))\nend\nfunction historyReplayClose()\nNF.HR.on, NF.HR.playing = false, false\nNF.HR.anim = NF.HR.anim + 1\nNF.hrShowParts(false)\nNF.hrSet(\"hreplay\", \"active\", tostring(NF.HIST.big == true))\nlocal v = NF.HIST.view or NF.histView()        -- (back to the list: the replay's line at its bottom)\nNF.HIST.off = math.max(0, #v - (NF.HR.i or #v))\nNF.histRender()\nend\nfunction historyReplayPlay()\nif not NF.HR.on then return end\nNF.HR.playing = not NF.HR.playing\nNF.hrSet(\"hrPlay\", \"text\", NF.HR.playing and \"Pause\" or \"Play\")\nif NF.HR.playing then\nif NF.HR.i >= #(NF.HIST.view or NF.histView()) then NF.hrDraw(1) else NF.hrDraw(NF.HR.i + 1) end\nend\nend\nfunction historyReplayPrev() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(NF.HR.i - 1) end end\nfunction historyReplayNext() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(NF.HR.i + 1) end end\nfunction historyReplayFirst() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(1) end end\nfunction historyReplayLast() if NF.HR.on then NF.HR.playing = false NF.hrSet(\"hrPlay\", \"text\", \"Play\") NF.hrDraw(#(NF.HIST.view or NF.histView())) end end\nfunction historyGrow()                           -- the toggle (anyone may look closer: it changes nothing in the game)\nif CFG.name ~= \"HISTORY\" then return end\nif NF.HR.on then historyReplayClose() end       -- (the replay only lives in the big window)\nNF.HIST.big = not NF.HIST.big\nNF.hrSet(\"hreplay\", \"active\", tostring(NF.HIST.big == true))\nlocal s = NF.histSize()\nlocal p = NF.histLayout(s)\npcall(function()\nself.UI.setAttribute(\"hpanel\", \"position\", p.panel)\nself.UI.setAttribute(\"hpanel\", \"width\", tostring(s.w))\nself.UI.setAttribute(\"hpanel\", \"height\", tostring(s.h))\nself.UI.setAttribute(\"hlines\", \"position\", p.text)\nself.UI.setAttribute(\"hlines\", \"width\", tostring(p.tw))\nself.UI.setAttribute(\"hlines\", \"height\", tostring(p.th))\nself.UI.setAttribute(\"hlines\", \"fontSize\", tostring(s.font))\nself.UI.setAttribute(\"hup\", \"position\", p.up)\nself.UI.setAttribute(\"hdown\", \"position\", p.down)\nself.UI.setAttribute(\"hinfo\", \"position\", p.info)\nself.UI.setAttribute(\"hgrow\", \"image\", NF.HIST.big and \"hshrink\" or \"hexpand\")\nend)\nNF.HIST_LINE_H = s.line\nNF.histRender()\nend\nfunction NF.histSetup()\nif CFG.name ~= \"HISTORY\" or IS_COPY then return end\nlocal files = CFG.files or {}\npcall(function()                               -- the toggle's two icons (playercubes\\tray_new_modules_v1)\nself.UI.setCustomAssets({{name = \"hexpand\", url = fi