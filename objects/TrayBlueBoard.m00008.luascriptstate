etRotation().y, 0})\nNF.INV.sig = \"\"\nreturn \"W:\" .. tag:sub(5):lower()\nend\nend\nend\nlocal all = NF.invSlots(board)\nlocal boxes = NF.invBoxes(board, all)\nlocal items = NF.invItems(board, boxes)\nlocal blocked = NF.invBlocked(board, all, {[card.getGUID()] = true})\nlocal toks = NF.invTokens(board, all)\nlocal used = {}\nfor _, it in ipairs(items) do used[it.box] = true end\nfor _, t in ipairs(toks) do blocked[t.slot] = true end\nlocal now = os.clock()\nfor bi, b in ipairs(boxes) do\nlocal free = not b.half and not used[bi] and not ((NF.INV.placing[b.code] or 0) > now)\nfor _, c in ipairs(b.circles) do if blocked[c] then free = false end end\nif free then\nNF.INV.placing[b.code] = now + 2.5\nlocal yaw = b.yaw or board.getRotation().y    -- (on the horse: turned as the horse lies)\ncard.setLock(false)\nNF.invLift(card, b.w.x, b.w.y + 0.08, b.w.z, 1.5, {0, yaw, 0})\nNF.INV.sig = \"\"\nif NF.CUBES[card.getName()] then NF.cubeDrop(card) end   -- (a script move is no drop: its cubes asked for here)\nreturn b.code\nend\nend\nreturn false\nend\nfunction horsePlace(p)\nif CFG.name ~= \"BOARD\" then return false end\nlocal card = getObjectFromGUID(type(p) == \"table\" and p.guid or \"\")\nlocal m, board = NF.module(\"HORSE\"), NF.invBoard()\nif not (card and m and board) then return false end\nlocal old = NF.horseOf()\nif old and old ~= card then return \"have\" end\nlocal at = nil\nfor _, sp in ipairs(m.getSnapPoints() or {}) do\nfor _, t in ipairs(sp.tags or {}) do if t == \"HorseTile\" then at = m.positionToWorld(sp.position) end end\nend\nat = at or m.getPosition()\ncard.setLock(false)\nNF.invLift(card, at.x, at.y + 0.1, at.z, 2.0, {0, board.getRotation().y, 0})\nNF.INV.sig = \"\"\nreturn \"placed\"\nend\nfunction NF.invHalves(board, slots, boxes)\nlocal out = {}\nlocal function add(obj, tag, horse, red)\nlocal list = {}\nfor _, s in ipairs(obj.getSnapPoints() or {}) do\nfor _, t in ipairs(s.tags or {}) do\nif t == tag then list[#list + 1] = s break end\nend\nend\ntable.sort(list, function(a, b)\nif math.abs(a.position.z - b.position.z) > 0.05 then return a.position.z < b.position.z end\nreturn a.position.x > b.position.x\nend)\nlocal oy = obj.getRotation().y\nfor _, s in ipairs(list) do\nlocal turn = (s.rotation and s.rotation.y) or 90\nout[#out + 1] = {w = obj.positionToWorld(s.position), yaw = (oy + turn) % 360, oy = oy, horse = horse, red = red,\ncircles = {}, k = #out + 1}\nend\nend\nadd(board, \"InventoryHalf_\" .. CFG.seat, false, false)\nlocal horse = NF.horseOf()\nif horse then add(horse, \"HorseMedium\", true, false) end\nadd(board, \"OverloadHalf_\" .. CFG.seat, false, true)\nfor i, s in ipairs(slots or {}) do              -- each circle into the half it lies in (its two circles, ~0.9 away)\nlocal best, bd = nil, 1.5 * 1.5\nfor _, h in ipairs(out) do\nlocal d = NF.flat2(s.w, h.w)\nif d < bd and math.abs(s.w.y - h.w.y) < 1.2 then best, bd = h, d end\nend\nif best then best.circles[#best.circles + 1] = i end\nend\nboxes = boxes or NF.invBoxes(board, slots)\nfor _, h in ipairs(out) do                      -- (each half's box: the nearest box middle)\nlocal bi, bd = 999, nil\nfor j, b in ipairs(boxes) do\nlocal d = NF.flat2(h.w, b.w)\nif not bd or d < bd then bi, bd = j, d end\nend\nh.box = bi\nend\ntable.sort(out, function(a, b) if a.box ~= b.box then return a.box < b.box end return a.k < b.k end)\nreturn out\nend\nfunction NF.invAnimals(board, halves, tag)\nlocal out = {}\nfor _, o in ipairs(getObjectsWithTag(tag or \"AnimalTile\")) do\nif not isHeld(o) and not o.isSmoothMoving() and (tag ~= \"WoundToken\" or o.type == \"Card\") then\nlocal p = o.getPosition()\nlocal at = NF.invHalfAt(halves, p)\nif at or NF.invInside(board, p) then out[#out + 1] = {o = o, half = at} end\nend\nend\ntable.sort(out, function(a, b) return (a.half or 999) < (b.half or 999) end)\nreturn out\nend\nfunction NF.newWorth(kind)\nif kind == \"meat\" then return {order = 10} end\nif kind == \"mushroom\" then return {order = 20} end\nlocal v = NF.INV.flower[(kind:sub(1, 1):upper()) .. kind:sub(2)]\nreturn {order = 40 + (v and v[3] or 9)}\nend\nfunction NF.invPlan(board, want)\nwant = want or {}\nlocal all = NF.invSlots(board)\nlocal boxes = NF.invBoxes(board, all)\nlocal halves = NF.invHalves(board, all, boxes)\nlocal items, skip, tops = NF.invItems(board, boxes), {}, {}\nfor _, it in ipairs(items) do\nskip[it.o.getGUID()] = true\ntops[it] = NF.invOnTop(it.o, board)\nfor _, m in ipairs(tops[it]) do skip[m.getGUID()] = true end\nend\nlocal animals, wounds = {}, NF.invAnimals(board, halves, \"WoundToken\")\nfor _, a in ipairs(NF.invAnimals(board, halves)) do      -- (the new tile, lying by the inventory, is no old one)\nif not (want.tile and a.o.getGUID() == want.tile.getGUID()) then animals[#animals + 1] = a end\nend\nfor _, a in ipairs(animals) do skip[a.o.getGUID()] = true end\nfor _, a in ipairs(wounds) do skip[a.o.getGUID()] = true end\nif want.tile then skip[want.tile.getGUID()] = true end\nlocal rank, order = {}, {}\nfor bi, b in ipairs(boxes) do for _, c in ipairs(b.circles) do rank[c] = bi end end\nfor i = 1, #all do order[i] = i end\ntable.sort(order, function(a, b)\nif (rank[a] or 999) ~= (rank[b] or 999) then return (rank[a] or 999) < (rank[b] or 999) end\nreturn a < b\nend)\nlocal ctx = {board = board, all = all, boxes = boxes, halves = halves, items = items, tops = tops, animals = animals,\nwounds = wounds, other = NF.invBlocked(board, all, skip),   -- (cards not on a box ...: they stay)\ntoks = NF.invTokens(board, all), want = want, order = order}\nlocal plan = NF.invLayout(ctx, true)\nif want.tile and plan.newTile then              -- (the new tile found a half: is anything old held back for it?)\nlocal without = NF.invLayout(ctx, false)\nif plan.stuck > without.stuck then plan = without end\nend\nreturn plan\nend\nfunction NF.invLayout(ctx, withTile)\nlocal all, boxes, halves, want = ctx.all, ctx.boxes, ctx.halves, ctx.want\nlocal keep = {c = {}, o = {}}\nlocal function pass()\nlocal plan = 