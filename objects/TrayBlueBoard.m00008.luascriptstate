, frame = n > 0 and laid[i] or false}\nend\nreturn cells, P.rows, (n > 0 and not NF.POT_ALWAYS_ALL) and NF.POT_STRIP or 0\nend\nlocal rows, inCol = 1, {}\nfor i = 1, #NF.POTIONS do\nif laid[i] then\nlocal c = math.floor((i - 1) / P.rows)\ninCol[c] = (inCol[c] or 0) + 1\nrows = math.max(rows, inCol[c])\ncells[#cells + 1] = {i = i, c = c, r = inCol[c] - 1, dim = false, frame = false}\nend\nend\nreturn cells, rows, NF.POT_STRIP\nend\nfunction NF.isPotBoard(o) return o ~= nil and o.getGMNotes() == NF.POT_TAG .. CFG.seat and not o.isDestroyed() end\nfunction NF.potBoard()\nlocal o = NF.potGuid and getObjectFromGUID(NF.potGuid)\nif NF.isPotBoard(o) then return o end\nNF.potGuid = nil\nreturn nil\nend\nfunction NF.potSpot()\nlocal p, yaw = self.getPosition(), self.getRotation().y\nlocal half = 1.4\nlocal ok, b = pcall(function() return self.getBoundsNormalized() end)\nif ok and b and b.size then\nlocal q = math.floor((yaw % 180) / 45 + 0.5) % 4   -- (turned by about 90: the module's width is along world z)\nhalf = ((q == 1 or q == 2) and b.size.z or b.size.x) / 2\nend\nlocal W = NF.potSize()\nlocal d = -(half + NF.POT.side_gap + W / 2)\nlocal a = math.rad(yaw)\nreturn {p.x + d * math.cos(a), p.y + NF.POT.hover, p.z - d * math.sin(a)}, yaw\nend\nfunction NF.potDress(o)\nif NF.dead or not NF.isPotBoard(o) then return end\nlocal laid, n = NF.potLaid()\nNF.potShown = NF.potKey(laid)\nlocal cells, rows, strip = NF.potLayout(laid, n, NF.potAll)\nlocal P, W, H = NF.POT, NF.potSize(rows, strip)\nlocal s = o.getScale()\nlocal ok, b = pcall(function() return o.getBoundsNormalized() end)\nlocal nx, ny, nz = 1, 1, 1\nif ok and b and b.size and b.size.x > 0 then\nnx, ny, nz = b.size.x / s.x, b.size.y / s.y, b.size.z / s.z\nif nx < 0.2 or nx > 5 or ny < 0.2 or ny > 5 or nz < 0.2 or nz > 5 then nx, ny, nz = 1, 1, 1 end\nend\nif math.abs(s.x * nx - W) > 0.01 or math.abs(s.y * ny - P.thick) > 0.01 or math.abs(s.z * nz - H) > 0.01 then\no.setScale({W / nx, P.thick / ny, H / nz})   -- (W x H