n = {0, top + 0.05 / s.y, strip / 2 / s.z}, rotation = {0, 180, 0},\nwidth = math.floor(W / s.x * NF.BTN_PX), height = math.floor((H - strip) / s.z * NF.BTN_PX),\ncolor = {0, 0, 0, 0}, hover_color = {1, 1, 1, 0.05}, press_color = {1, 1, 1, 0.12}, font_color = {0, 0, 0, 0}}, true))\nif strip > 0 then\no.createButton(__sharpB({click_function = \"nfPotionsAll\", function_owner = self,\nlabel = NF.potAll and \"Show laid out only\" or \"Show all recipes\",\ntooltip = NF.potAll and \"Only the recipes on the potion board\" or \"All 15 recipes; the ones not on the potion board darker\",\nposition = {0, top + 0.05 / s.y, (-H / 2 + strip / 2) / s.z}, rotation = {0, 180, 0}, scale = unscale,\nwidth = math.floor(6.0 * NF.POT_K * NF.BTN_PX), height = math.floor((strip - 0.25 * NF.POT_K) * NF.BTN_PX),\nfont_size = math.floor(200 * NF.POT_K),\ncolor = NF.NAVY, hover_color = {0.18, 0.26, 0.45, 1}, press_color = {0.28, 0.36, 0.55, 1}, font_color = NF.GOLD}, true))\nend\nend\nfunction NF.potWatch()\nNF.potTick = NF.potTick + 1\nlocal me = NF.potTick\nlocal function tick()\nif NF.dead or me ~= NF.potTick then return end\nlocal o = NF.potBoard()\nif not o then return end\nif NF.potKey((NF.potLaid())) ~= NF.potShown then NF.potDress(o) end\nWait.time(tick, NF.POT_WATCH)\nend\nWait.time(tick, NF.POT_WATCH)\nend\nfunction NF.potionsShow()\nlocal P, W, H = NF.POT, NF.potSize()\nlocal pos, yaw = NF.potSpot()\nlocal o = spawnObjectData({data = {\nName = \"BlockSquare\", Nickname = \"Potions (\" .. CFG.seat .. \")\", GMNotes = NF.POT_TAG .. CFG.seat,\nTransform = {posX = pos[1], posY = pos[2], posZ = pos[3], rotX = 0, rotY = yaw, rotZ = 0,\nscaleX = W, scaleY = P.thick, scaleZ = H},\nColorDiffuse = {r = P.tint[1], g = P.tint[2], b = P.tint[3]},\nLocked = true, Grid = false, Snap = false, Tooltip = false,\n}, callback_function = function(obj) obj.setLock(true) NF.potDress(obj) NF.potWatch() end})\nNF.potGuid = o and o.getGUID() or nil\nNF.potAll = false                              -- (opens on the laid out ones)\nend\nfunction NF.potionsHide()\nlocal o = NF.potBoard()\nNF.potGuid = nil\nNF.potTick = NF.potTick + 1                    -- (its watch ends)\nif o then o.destruct() end\nend\nfunction NF.potionsAll()\nlocal o = NF.potBoard()\nif not o then return end\nNF.potAll = not NF.potAll\nNF.potDress(o)\nend\nfunction NF.potionsToggle()\nif NF.potBoard() then NF.potionsHide() else NF.potionsShow() end\nend\nfunction NF.potionsRestore()\nlocal keep = NF.potBoard()\nfor _, o in ipairs(getObjects()) do\nif NF.isPotBoard(o) and not (keep and o.getGUID() == keep.getGUID()) then\nif keep then o.destruct() else keep = o end\nend\nend\nNF.potGuid = keep and keep.getGUID() or nil\nif keep then NF.potDress(keep) NF.potWatch() end\nend\nfunction NF.potionsFollow()\nlocal o = NF.potBoard()\nif not o then return end\nlocal pos, yaw = NF.potSpot()\no.setPosition(pos)\no.setRotation({0, yaw, 0})\nend\nfunction nfPotions() NF.potionsToggle() end\nfunction nfPotionsBoard() NF.potionsHide() end\nfunction nfPotionsAll() NF.potionsAll() end\nfunction nfPotionsClose() pcall(function() Global.UI.setAttribute(\"kcdPotions\", \"active\", \"false\") end) end\nNF.TEST_X, NF.TEST_Z0, NF.TEST_Z1 = 2.9, 1.0, 17.0\nNF.TUCK = {x0 = -2.94, x1 = 2.97, z0 = -1.93, z1 = 5.67, ymax = 0.35}\nfunction NF.onModule(m, o)\nlocal w, d = dims(m)\nlocal q = m.positionToLocal(o.getPosition())\nreturn math.abs(q.x) < w * U / 2 and math.abs(q.z) < d * U / 2 and q.y > -0.5 and q.y < 6\nend\nfunction NF.inHand(o)\nlocal ok, z = pcall(function() return o.getZones() end)\nif ok and z then\nfor _, zz in ipairs(z) do if zz.type == \"Hand\" then return true end end\nend\nreturn false\nend\nfunction NF.tellTucked(fn, text)\nlocal tc = nil\npcall(function() tc = NF.tuckedCard() end)\nif tc and tc.type == \"Card\" and tc.hasTag(\"CardFrames\") then\npcall(function() tc.call(fn, {text = tostring(text or \"\"), seat = CFG.seat}) end)\nend\nend\nfunction nfDrawHand(p)\nlocal n = math.floor(tonumber(type(p) == \"t