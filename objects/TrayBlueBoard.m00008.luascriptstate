\nfunction NF.underDeck(w, deck)\nif w.hasTag(\"SoldAtCalc\") then w.removeTag(\"SoldAtCalc\") end   -- (sold at Calculate: back in its deck as it was)\nlocal p, r = deck.getPosition(), deck.getRotation()\nlocal name, tags, locked = deck.getName(), deck.getTags(), deck.getLock()\ndeck.setLock(false)\ndeck.setPosition({p.x, p.y + 1.5, p.z})\nw.setRotation({r.x, r.y, r.z})\nw.setPosition({p.x, p.y, p.z})\nWait.frames(function()\nif w.isDestroyed() or deck.isDestroyed() then return end\nw.putObject(deck)                            -- (the deck onto the tile: the tile ends up at the bottom)\nWait.frames(function()\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Deck\" and NF.flat2(o.getPosition(), p) < 1 then\no.setName(name)\no.setTags(tags)\nif locked then o.setLock(true) end\nend\nend\nif not deck.isDestroyed() and not w.isDestroyed() then deck.putObject(w) end   -- (fallback: on top)\nend, 10)\nend, 2)\nend\nNF.BAD = {[\"Honor the Dead\"] = true, [\"Entertain the Children\"] = true, [\"Help the Locals Forage\"] = true,\n[\"Find the Balance\"] = true, [\"Help a Wayfarer\"] = true, [\"Be Generous\"] = true, [\"Contemplate\"] = true,\n[\"Pillory Punishment\"] = true, [\"Be Chivalrous\"] = true, [\"Feed the Poor\"] = true}\nNF.HW = nil\nfunction NF.goodToDiscard(color)                 -- the Good deck's top card onto this seat's discard pile\nlocal good = NF.goodPile()\nif not good then NF.tell(color, \"No Good Cards deck found: put a Good card onto your discard pile by hand.\") return false end\nif good.type == \"Deck\" then\nlocal m, a = NF.discardSpot()\nlocal at = m and m.positionToWorld({a.x, 3, a.z}) or self.positionToWorld({0, 3, 0})\nlocal c = good.takeObject({position = {at.x, at.y, at.z}, smooth = false})\nif c and not NF.toDiscard({c}) then NF.tell(color, \"No DISCARD module: the Good card lies on your tray.\") end\nelseif not NF.toDiscard({good}) then\nNF.tell(color, \"No DISCARD module on your tray: take the Good card by hand.\")\nend\nreturn true\nend\nfunction NF.pileNamed(name)                      -- a deck (or its last card) by name\nfor _, o in ipairs(getObjects()) do\nif (o.type == \"Deck\" or o.type == \"Card\") and o.getName() == name and not isHeld(o) then return o end\nend\nend\nfunction NF.topToDiscard(name, color)            -- that deck's top card onto this seat's discard pile (Good / Bad)\nlocal pile = NF.pileNamed(name)\nif not pile then return false end              -- (the caller says so)\nif pile.type == \"Deck\" then\nlocal m, a = NF.discardSpot()\nlocal at = m and m.positionToWorld({a.x, 3, a.z}) or self.positionToWorld({0, 3, 0})\nlocal c = pile.takeObject({position = {at.x, at.y, at.z}, smooth = false})\nif c and not NF.toDiscard({c}) then NF.tell(color, \"No DISCARD module: the card lies on your tray.\") end\nelseif not NF.toDiscard({pile}) then\nNF.tell(color, \"No DISCARD module on your tray: take the card by hand.\")\nend\nreturn true\nend\nfunction NF.moveCube()\nlocal best, bv, total = nil, -1, nil\nfor _, o in ipairs(getObjectsWithTag(\"Movement_\" .. CFG.seat)) do\nif (o.getName() or \"\"):find(\"Movement Cube\", 1, true) then\nlocal v, t = nil, nil\npcall(function() v = o.call(\"getValue\") t = o.call(\"getTotal\") end)\nif type(v) == \"number\" and v > bv then best, bv = o, v end\nif type(t) == \"number\" then total = t end\nend\nend\nif best and type(total) ~= \"number\" then total = bv end\nreturn best, bv, total\nend\nfunction NF.dirtOnChar(board)\nlocal spot = nil\nfor _, s in ipairs(board.getSnapPoints() or {}) do\nfor _, t in ipairs(s.tags or {}) do if t == \"Character_\" .. CFG.seat then spot = board.positionToWorld(s.position) end end\nend\nlocal card = nil\nif spot then\nfor _, o in ipairs(getObjectsWithTag(\"Set13Card\")) do\nif o.type == \"Card\" and not isHeld(o) and NF.flat2(o.getPosition(), spot) < 2.25 then card = o end\nend\nend\nlocal bowl = NF.nearestNamed(NF.BOWL_NAME.dirt, board.getPosition())\nif not (card and bowl) then return false end\nlocal q = NF.cardPoint(card, 0.8, 0.85, 0.6)\nbowl.takeObject({position = {q.x, q.y, q.z}, rotation = {0, board.getRotation().y, 0}, smooth = false})\nreturn true\nend\nfunction encApply(p)\nif CFG.name ~= \"BOARD\" then return \"not the board\" end\np = type(p) == \"table\" and p or {}\nlocal board = NF.invBoard()\nif not board then return \"no player board\" end\nlocal why = (type(p.why) == \"string\" and p.why ~= \"\") and (p.why .. \": \") or \"\"\nlocal mv = math.floor(tonumber(p.move or 0) or 0)\nlocal need = math.floor(tonumber(p.needMove or 0) or 0)\nlocal cube, v, total = nil, nil, nil\nif mv ~= 0 or need > 0 then\ncube, v, total = NF.moveCube()\nif not cube then NF.say(why .. \"no movement cube found - nothing happens\", false) return \"short\" end\nif total < need then\nNF.say(why .. need .. \" movement needed, \" .. total .. \" left - nothing happens\", false)\nreturn \"short\"\nend\nend\nlocal said = {}\nif mv ~= 0 then\nlocal nv = math.max(0, v + mv)\nlocal ok = pcall(function() cube.call(\"setValue\", {value = nv, announce = false}) end)\nsaid[#said + 1] = ok and (\"Movement \" .. total .. \" → \" .. (total - v + nv)) or (\"Movement \" .. mv .. \" (set it by hand)\")\nend\nlocal dirt = math.floor(tonumber(p.dirtChar or 0) or 0)\nif dirt > 0 then\nlocal put = 0\nfor _ = 1, dirt do if NF.dirtOnChar(board) then put = put + 1 end end\nsaid[#said + 1] = \"Dirt +\" .. dirt .. \" (character card\" .. (put < dirt and \": put it on by hand\" or \"\") .. \")\"\nend\nfor _, e in ipairs({{\"good\", \"Good Cards\", \"Good card\"}, {\"bad\", \"Bad Cards\", \"Bad card\"}}) do\nfor _ = 1, math.floor(tonumber(p[e[1]] or 0) or 0) do\nsaid[#said + 1] = e[3] .. \" → discard pile\" .. (NF.topToDiscard(e[2]) and \"\" or \" (no \" .. e[2] .. \" deck: by hand)\")\nend\nend\nlocal xp = type(p.xp) == \"table\" and p.xp or {}\nfor _, s in ipairs({\"Strength\", \"Perception\", \"Dexterity\", \"Speech\", \"Universal\"}) do\nlocal n = math.floor(tonumber(xp[s] or 0) or 0)\nif n > 0 then\nNF.xpGain(s, n)                            -- (each XP cube says its own \"Perception 2 → 3\")\nsaid[#said + 1] = s .. \" +\" .. n\nend\nend\nif #said > 0 then NF.say(why .. table.concat(said, \", \")) end\nreturn \"ok\"\nend\nfunction encItem(p)\nif CFG.name ~= \"BOARD\" then return \"not the board\" end\np = type(p) == \"table\" and p or {}\nlocal card = getObjectFromGUID(p.guid or \"\")\nif not card then return \"no card\" end\nlocal color, spots = p.color, type(p.spots) == \"table\" and p.spots or {}\nlocal why = (type(p.why) == \"string\" and p.why ~= \"\") and (p.why .. \": \") or \"\"\nlocal n = math.min(#spots, math.floor(tonumber(p.damage or 0) or 0))\nlocal dmg = n > 0 and (n .. \" damage token\" .. (n > 1 and \"s\" or \"\")) or nil\nlocal name = card.getName()\nlocal function damage(c)\nif n <= 0 or c.isDestroyed() then return end\nlocal bowl = NF.nearestNamed(NF.FIX.shield.bowl, c.getPosition())\nif not bowl then NF.say(why .. \"no \" .. NF.FIX.shield.bowl .. \" found: put \" .. dmg .. \" on \" .. name .. \" by hand\", false) return end\nfor i = 1, n do\nlocal s = spots[i]\nWait.time(function()\nif c.isDestroyed() then return end\nlocal q = NF.cardPoint(c, tonumber(s.u) or 0.5, tonumber(s.v) or 0.5, 0.5)\nbowl.takeObject({position = {q.x, q.y, q.z}, rotation = {0, c.getRotation().y, 0}, smooth = false})\nend, 0.2 * (i - 1))\nend\nend\nlocal function landed(c)\nWait.condition(function() Wait.time(function() damage(c) end, 0.5) end,\nfunction() return c.isDestroyed() or (not isHeld(c) and not c.isSmoothMoving()) end, 6)\nend\nif SCRIPT_OPTS and SCRIPT_OPTS.autoSort == false then   -- (scripting option: nothing placed or sorted: into the hand)\nlocal okh = pcall(function()\nlocal h = Player[CFG.seat].getHandTransform(1)\nlocal r, k = h.right, h.scale.x / 2 - 1.2\ncard.setLock(false)\ncard.setPositionSmooth({h.position.x + r.x * k, h.position.y + 0.5, h.position.z + r.z * k}, false, true)\nend)\nNF.say(why .. name .. (okh and \" → hand (automatic sorting off)\" or \": automatic sorting off and no hand - take it by hand\")\n.. (dmg and (\" - put \" .. dmg .. \" on it\") or \"\"))\nreturn \"ok\"\nend\nlocal placed = invPlace({guid = p.guid, color = color})\nif placed then\nNF.say(why .. name .. NF.placedWhere(placed) .. (dmg and (\", \" .. dmg) or \"\"))\nlanded(card)\nreturn \"ok\"\nend\ninvSort()                                      -- (no room: sorted first, then tried again)\nWait.time(function()\nif card.isDestroyed() then return end\nlocal placed = invPlace({guid = p.guid, color = color})\nif placed then\nNF.say(why .. name .. NF.placedWhere(placed) .. \" (sorted first)\" .. (dmg and (\", \" .. dmg) or \"\"))\nlanded(card)\nreturn\nend\nlocal ok = pcall(function()                  -- still none: into the hand, at its right end\nlocal h = Player[CFG.seat].getHandTransform(1)\nlocal r, k = h.right, h.scale.x / 2 - 1.2\ncard.setLock(false)\ncard.setPositionSmooth({h.position.x + r.x * k, h.position.y + 0.5, h.position.z + r.z * k}, false, true)\nend)\nNF.say(why .. name .. (ok and \" → hand (no room in the inventory)\" or \": no room and no hand - take it by hand\")\n.. (dmg and (\" - put \" .. dmg .. \" on it\") or \"\"))\nend, 1.8)\nreturn \"ok\"\nend\nfunction groschenChange(p)\nif CFG.name ~= \"GROSCHEN\" then return \"not the groschen well\" end\np = type(p) == \"table\" and p or {}\nlocal why = (type(p.why) == \"string\" and p.why ~= \"\") and (p.why .. \": \") or \"\"\nlocal n = math.floor(tonumber(p.n or 0) or 0)\nif n == 0 then return \"ok\" end\nif n < 0 and p.need then\nlocal have = 0\nfor _, c in ipairs(NF.coinsNow()) do have = have + c.v end\nif have < -n then NF.say(why .. (-n) .. \" Groschen needed, \" .. have .. \" left - nothing happens\", false) return \"short\" end\nend\nNF.groschen(n, p.color, why)\nreturn \"ok\"\nend\nfunction NF.myPiles(board)                       -- decks and loose cards on this seat's board and tray modules\nlocal mods = getObjectsWithTag(\"TrayGrid_\" .. CFG.seat)\nlocal out = {}\nfor _, o in ipairs(getObjects()) do\nif (o.type == \"Deck\" or o.type == \"Card\") and not isHeld(o) and not o.getLock() then\nlocal p = o.getPosition()\nlocal mine = NF.onBoard(board, o)\nif not mine then\nfor _, m in ipairs(mods) do\nlocal b = m.getBounds()\nif math.abs(p.x - b.center.x) < b.size.x / 2 and math.abs(p.z - b.center.z) < b.size.z / 2 and p.y < b.center.y + 6 then\nmine = true\nbreak\nend\nend\nend\nif mine then out[#out + 1] = o end\nend\nend\nreturn out\nend\nfunction NF.hwSpot(board, i, n)                  -- the row over the board: up to 6 a row\nlocal sc = board.getScale()\nlocal row, col = math.floor((i - 1) / 6), (i - 1) % 6\nlocal cnt = (row < math.floor((n - 1) / 6)) and 6 or (n - row * 6)\nlocal w = board.positionToWorld({(col - (cnt - 1) / 2) * 2.6 / math.max(0.01, sc.x), 0, (row * 3.6 - 1.6) / math.max(0.01, sc.z)})\nreturn {w.x, board.getPosition().y + 3, w.z}\nend\nfunction NF.hwClearButtons()\nlocal drop = {}\nfor _, b in ipairs(self.getButtons() or {}) do if b.click_function:find(\"^nfBad\") then drop[#drop + 1] = b.index end end\ntable.sort(drop, function(a, b) return a > b end)\nfor _, i in ipairs(drop) do self.removeButton(i) end\nend\nfunction NF.hwStart(kit, color, board)\nlocal list = {}\nlocal ok, hand = pcall(function() return (Player[CFG.seat].getHandCount() > 0 and Player[CFG.seat].getHandObjects() or {}) end)\nfor _, o in ipairs(ok and hand or {}) do\nif o.type == \"Card\" and NF.BAD[o.getName()] then list[#list + 1] = {o = o, from = \"hand\"} end\nend\nfor _, p in ipairs(NF.myPiles(board)) do\nif p.type == \"Card\" then\nif NF.BAD[p.getName()] then list[#list + 1] = {o = p, from = \"table\", pos = p.getPosition(), rot = p.getRotation()} end\nelse\nfor _, e in ipairs(p.getObjects() or {}) do\nif NF.BAD[e.name] then list[#list + 1] = {guid = e.guid, deck = p, from = \"deck\", dpos = p.getPosition(), drot = p.getRotation()} end\nend\nend\nend\nif #list == 0 then NF.tell(color, \"You have no Bad cards (hand, decks, tray).\") return end\npcall(function() Player[color].lookAt({position = board.getPosition(), pitch = NF.FIX_PITCH,\nyaw = (board.getRotation().y + 180) % 360, distance = NF.FIX_DIST}) end)\nNF.HW = {kit = kit.getGUID(), cards = list}\nlocal yaw = (board.getRotation().y + 180) % 360\nfor i, e in ipairs(list) do\nlocal at = NF.hwSpot(board, i, #list)\ne.at = at\nlocal taken = false\nif e.from == \"deck\" then\nif e.deck and not e.deck.isDestroyed() and e.deck.type == \"Deck\" then\ne.o = e.deck.takeObject({guid = e.guid, position = at, rotation = {0, yaw, 0}, smooth = true})\ntaken = true\nelse\ne.o = getObjectFromGUID(e.guid)          -- (the deck is down to this one card)\nend\nend\nif e.o and not taken then\ne.o.setRotationSmooth({0, yaw, 0}, false, true)\ne.o.setPositionSmooth(at, false, true)\nend\nend\nWait.time(function()\nif not NF.HW then return end\nfor i, e in ipairs(NF.HW.cards) do\nif e.o and not e.o.isDestroyed() then\ne.o.setLock(true)\nNF.invBtn(\"nfBad\" .. i, \"DISCARD\", {x = e.at[1], y = e.at[2] + 0.1, z = e.at[3]},\n\"Remove \" .. e.o.getName() .. \": under the Bad Cards deck; a Good card onto your discard pile\", 480)\nend\nend\nend, 1.2)\nNF.say(\"drinks Holy Water: choose a Bad card to remove (\" .. #list .. \" laid out)\")\nend\nfunction NF.hwReturn(e)\nlocal o = e.o\nif not o or o.isDestroyed() then return end\no.setLock(false)\nif e.from == \"hand\" then\nlocal ok, h = pcall(function() return Player[CFG.seat].getHandTransform() end)\nif ok and h then o.setPositionSmooth(h.position, false, true) end\nelseif e.from == \"table\" then\no.setRotationSmooth(e.rot, false, true)\no.setPositionSmooth(e.pos, false, true)\nelse\nlocal pile = NF.pileAtWorld(e.dpos.x, e.dpos.z, 1.5)\no.setRotation(e.drot)\nif pile and pile ~= o then\npile.putObject(o)\nWait.frames(function()\nlocal p2 = NF.pileAtWorld(e.dpos.x, e.dpos.z, 1.5)\nif p2 and p2.type == \"Deck\" then p2.shuffle() end\nend, 20)\nelse\no.setPositionSmooth({e.dpos.x, e.dpos.y + 0.5, e.dpos.z}, false, true)\nend\nend\nend\nfunction NF.hwEnd()                              -- DRINK again: every card back, nothing used\nlocal h = NF.HW\nNF.HW = nil\nNF.hwClearButtons()\nfor _, e in ipairs(h and h.cards or {}) do NF.hwReturn(e) end\nend\nfunction NF.hwPick(i, color)\nlocal h = NF.HW\nif not h then return end\nlocal pick = h.cards[i]\nif not (pick and pick.o and not pick.o.isDestroyed()) then return end\nlocal kit, board = getObjectFromGUID(h.kit or \"\"), NF.invBoard()\nlocal cubes = (kit and board) and NF.cubesOn(kit, board) or {}\nif #cubes == 0 then NF.hwEnd() return end\nNF.HW = nil\nNF.hwClearButtons()\nlocal name = pick.o.getName()\npick.o.setLock(false)\nlocal bad = nil\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Deck\" and o.getName() == \"Bad Cards\" and not isHeld(o) then bad = o break end\nend\nif bad then NF.underDeck(pick.o, bad) end\nfor j, e in ipairs(h.cards) do if j ~= i then NF.hwReturn(e) end end\ntable.sort(cubes, function(a, b) return a.getPosition().y > b.getPosition().y end)\ncubes[1].destruct()\nNF.goodToDiscard(color)\nNF.say(\"drank Holy Water: \" .. name .. (bad and \" back under the Bad Cards\" or \" removed (no Bad Cards deck: put it back by hand)\")\n.. \", a Good card onto the discard pile (\" .. (#cubes - 1) .. \" left)\")\nNF.INV.sig = \"\"\nend\nNF.CONFIRM_S = 2\nNF.PEND = nil\nfunction NF.btnIndex(fn)\nfor _, b in ipairs(self.getButtons() or {}) do if b.click_function == fn then return b.index, b end end\nend\nfunction NF.confirm(fn, what, color, act, ask)\nif color ~= CFG.seat and not (Player[color] and Player[color].admin) then\nNF.tell(color, \"Only \" .. CFG.seat .. \" can use \" .. CFG.seat .. \"'s items.\") return\nend\nlocal key, now = fn .. \":\" .. tostring(what or \"\"), os.clock()\nif NF.PEND and NF.PEND.key == key and now <= NF.PEND.till then\nlocal p = NF.PEND\nNF.PEND = nil\nNF.unsure(p)        -- (user, 2026-11-05: SORT kept showing CONFIRM after it was done: the button back first)\nact()\nreturn\nend\nif NF.PEND then NF.u