e(color)\nNF.serial(function()\nlocal seat = CFG.seat\nlocal d = NF.deckPile()\nif d then d.deal(1, seat) return end\nNF.hold = true                                   -- the reshuffle takes a moment: later clicks wait for it\nNF.discardIntoDeck(function(deck, why, n)\nif deck and NF.count(deck) > 0 then\nWait.time(function()\nlocal d2 = NF.deckPile()\nif d2 then d2.deal(1, seat) end\nNF.hold = false\nend, 0.2)\nNF.say(\"Discard pile shuffled into a new deck (\" .. (n or NF.count(deck)) .. \" cards)\")\nelse\nNF.hold = false\nNF.tell(color, \"No cards left: \" .. seat .. \"'s deck and discard pile are empty.\")\nend\nend)\nend, 0.5)\nend\nfunction NF.shuffleBack(color)\nNF.serial(function()\nNF.hold = true\nNF.discardIntoDeck(function(deck, why, n)\nNF.hold = false\nif why == \"empty\" then\nif deck and deck.type == \"Deck\" then deck.shuffle() end\nNF.tell(color, \"The discard pile is empty\" .. (deck and \" (deck shuffled).\" or \".\"))\nelseif deck then\nNF.say(\"Discard pile shuffled into the deck (\" .. NF.count(deck) .. \" cards)\")\nend\nend)\nend, 2.0)\nend\nfunction nfDraw(_, color) NF.drawOne(color) end\nfunction nfShuffle(_, color) NF.shuffleBack(color) end\nfunction NF.questSlots()\nlocal t = {}\nfor i = 1, 3 do t[i] = NF.anchor(\"slot\" .. i) end\nreturn t\nend\nfunction NF.slotCards(s) return NF.pilesIn(self, s.x, s.z, NF.SIZE.slot[1] / 2, NF.SIZE.slot[2] / 2, 4) end\nfunction NF.questSpots()\nlocal c0 = getObjectFromGUID(CFG.setupGuid or NF.SETUP_GUID)   -- (the quest wells may have moved: the middle tray)\nif c0 then pcall(function() c0.call(\"middle_spots\") end) end\nlocal qs = NF.controllerTable(\"QUEST_SPOT\") or {-58.72, 12.85}\nlocal qd = NF.controllerTable(\"QUEST_DISCARD\") or {-58.72, 18.67}\nlocal c = getObjectFromGUID(CFG.setupGuid or NF.SETUP_GUID)\nlocal yaw = 90\nif c then pcall(function() yaw = c.getVar(\"QUEST_YAW\") or 90 end) end\nreturn qs, qd, yaw\nend\nfunction NF.questDeck()\nlocal qs = NF.questSpots()\nlocal p = NF.pileAtWorld(q