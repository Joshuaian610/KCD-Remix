\nNF.HIST.lines, NF.HIST.snaps = own.lines, own.snaps   -- (this seat's own, as before)\nif not (NF.HR and NF.HR.on) and (NF.HIST.off or 0) == 0 then   -- (at the newest: the newest stays in view)\nNF.histView()\nNF.histRender()\nelse\nNF.histFocusKeep(function() end)             -- (looking back: the same line stays in focus)\nend\nend\nfunction NF.histPush(i)                          -- (the keeper) to every seat's HISTORY module: line i, or all\nlocal h = NF.HIST\nlocal p\nif i then\np = {seat = CFG.seat, i = i, line = h.lines[i], snap = (h.snaps or {})[i], seq = (h.seqs or {})[i], base = h.base or 0}\nelse\np = historyLines()\nend\nfor _, m in ipairs(NF.histModules(\"HISTORY\")) do\nif m ~= self then pcall(function() m.call(\"historyShow\", p) end) end\nend\nend\nfunction NF.histPullSeat(seat)                   -- (a HISTORY module) all lines of one seat from its keeper\nfor _, k in ipairs(NF.histModules(NF.HIST_KEEPER)) do\nif k ~= self and k.hasTag(\"TrayGrid_\" .. seat) then\nlocal ok, r = pcall(function() return k.call(\"historyLines\", {}) end)\nif ok and type(r) == \"table\" and type(r.lines) == \"table\" then\nr.seat = r.seat or seat\nhistoryShow(r)\nend\nend\nend\nend\nfunction NF.histPull()                           -- (a HISTORY module) all lines so far, of every seat\nfor _, k in ipairs(NF.histModules(NF.HIST_KEEPER)) do\nif k ~= self then\nlocal ok, r = pcall(function() return k.call(\"historyLines\", {}) end)\nif ok and type(r) == \"table\" and type(r.lines) == \"table\" then historyShow(r) end\nend\nend\nend\nNF.HIST.all, NF.HIST.pin = false, nil\nfunction NF.histView()\nlocal by, view = NF.HIST.by or {}, {}\nlocal function add(seat, B)\nfor i, l in ipairs(B.lines or {}) do\nview[#view + 1] = {seat = seat, line = l, snap = (B.snaps or {})[i], seq = (B.seqs or {})[i] or 0, k = i}\nend\nend\nif NF.HIST.all then\nfor seat, B in pairs(by) do add(seat, B) end\nelse\nadd(CFG.seat, by[CFG.seat] or {lines = NF.HIST.lines, snaps = NF.HIST.snaps})\nlocal pin = NF.HIST.pin\nif pin and pin.seat ~= CFG.seat then\nlocal B = by[pin.seat]\nfor i, l in ipairs(B and B.lines or {}) do\nif (B.seqs or {})[i] == pin.seq then\nview[#view + 1] = {seat = pin.seat, line = l, snap = (B.snaps or {})[i], seq = pin.seq, k = i}\nend\nend\nend\nend\ntable.sort(view, function(a, b)               -- (lines from before the numbers: 0, in their own order)\nif a.seq ~= b.seq then return a.seq < b.seq end\nif a.seat ~= b.seat then return a.seat < b.seat end\nreturn a.k < b.k\nend)\nNF.HIST.view = view\nreturn view\nend\nfunction NF.histFocus()                          -- the line in focus: the replay's, or the list's bottom line\nlocal v = NF.HIST.view or NF.histView()\nlocal i = (NF.HR and NF.HR.on) and NF.HR.i or (#v - (NF.HIST.off or 0))\nreturn v[i]\nend\nfunction NF.histFocusKeep(change)                -- change the view; the same line stays in focus\nlocal f = NF.histFocus()\nchange()\nlocal v = NF.histView()\nlocal k = nil\nfor i, it in ipairs(v) do if f and it.seq == f.seq and it.seat == f.seat then k = i end end\nif NF.HR and NF.HR.on then\nNF.hrDraw(k or math.min(NF.HR.i or 1, #v))\nelse\nif k and f then NF.HIST.off = math.max(0, #v - k) end\nNF.histRender()\nend\nend\nfunction historyAll()                            -- the Show all tick\nif CFG.name ~= \"HISTORY\" then return end\nNF.histFocusKeep(function()\nlocal f = NF.histFocus()\nNF.HIST.all = not NF.HIST.all\nNF.HIST.pin = (not NF.HIST.all and f and f.seat ~= CFG.seat) and {seat = f.seat, seq = f.seq} or nil\nend)\nNF.hrSet(\"hall\", \"text\", NF.HIST.all and \"[x] Show all\" or \"[  ] Show all\")\nend\nNF.HIST.off = 0\nfunction NF.histRows(line, s)                    -- how many rows a line takes at this width and font (an estimate)\nlocal plain = line:gsub(\"<[^>]*>\", \"\")\nlocal per = math.max(10, math.floor((s.w - 100) / (s.font * 0.47)))\nreturn math.max(1, math.ceil(#plain / per))\nend\nfunction NF.histRender()\nif CFG.name == NF.HIST_KEEPER then return end  -- (the keeper has no list of its own: historyAdd tells the windows)\nif NF.HR and NF.HR.on then return end          -- (in the replay: the list comes back with List)\nlocal h = NF.HIST\nlocal s = NF.histSize()\nlocal fit = math.max(1, math.floor((s.h - 88) / s.line))\nlocal view = h.view or NF.histView()\nlocal function text(it)                         -- (another seat's line: its colour tag in front)\nif it.seat == CFG.seat then return it.line end\nreturn string.format(\"<color=%s>[%s]</color> %s\", NF.HR_SEAT_HEX[it.seat] or \"#FFFFFF\", it.seat:upper(), it.line)\nend\nh.off = math.max(0, math.min(h.off or 0, #view - 1))\nlocal shown, rows = {}, 0\nlocal i = #view - h.off\nwhile i >= 1 do\nlocal tl = text(view[i])\nlocal r = NF.histRows(tl, s)\nif rows + r > fit and #shown > 0 then break end\ntable.insert(shown, 1, tl)\nrows = rows + r\ni = i - 1\nend\nlocal older, newer = i >= 1, h.off > 0\npcall(function()\nlocal empty = (Turns and Turns.enable) and \"<i>Nothing yet this game.</i>\"\nor \"<i>The History records while Turns are on (they start at the end of the setup).</i>\"\nself.UI.setAttribute(\"hlines\", \"text\", #view > 0 and table.concat(shown, \"\\n\") or empty)\nself.UI.setAttribute(\"hup\", \"active\", tostring(older))\nself.UI.setAttribute(\"hdown\", \"active\", tostring(newer))\nself.UI.setAttribute(\"hinfo\", \"text\", newer and (h.off .. \" newer\") or \"\")\nend)\nend\nfunction historyUp()                             -- older lines (anyone may look: it changes nothing in the game)\nNF.HIST.off = (NF.HIST.off or 0) + 3\nNF.histRender()\nend\nfunction historyDown()                           -- newer lines (back to the newest at the bottom)\nNF.HIST.off = math.max(0, (NF.HIST.off or 0) - 3)\nNF.histRender()\nend\nfunction historyAdd(p)\nif CFG.name == \"HISTORY\" then                  -- (older callers: the line goes to the keeper)\nlocal k = NF.module(NF.HIST_KEEPER)\nif k and k ~= self then pcall(function() k.call(\"historyAdd\", p) end) end\nreturn\nend\nif CFG.name ~= NF.HIST_KEEPER or not NF.histOn() or type(p) ~= \"table\" or not p.t then return end\nlocal h = NF.HIST\nh.snaps = h.snaps or {}\nlocal t = tostring(p.t)\nt = t:sub(1, 1):upper() .. t:sub(2)\nh.seqs = h.seqs or {}\nif (p.kind or \"say\") == \"say\" and h.lastKind == \"say\" and h.lastText == t and #h.lines > 0 then\nh.lastCount = (h.lastCount or 1) + 1\nh.lines[#h.lines] = t .. \" (\" .. h.lastCount .. \"x)\"\nh.snaps[#h.lines] = NF.histSnap(nil, h.snaps[#h.lines])\nNF.histPush(#h.lines)\nreturn\nend\nh.lastText, h.lastCount = t, 1\nlocal merged = false\nif p.kind == \"move\" and h.lastKind == \"move\" and #h.lines > 0 then\nh.lines[#h.lines] = h.lines[#h.lines] .. \" >> \" .. p.to            -- (the same move goes on)\nmerged = true\nelseif p.kind == \"move\" then\nh.lines[#h.lines + 1] = \"Move: \" .. p.from .. \" >> \" .. p.to\nelseif p.kind == \"turn\" then\nh.lines[#h.lines + 1] = \"<b><color=#D6B060>Turn \" .. h.turn .. \"</color></b>\"\nelse\nh.lines[#h.lines + 1] = t\nend\nh.lastKind = p.kind or \"say\"\nif p.kind == \"move\" and type(p.toN) == \"number\" then h.space = p.toN end   -- (walked by the navigation)\nlocal i = #h.lines\nh.snaps[i] = NF.histSnap(p, merged and h.snaps[i] or nil)\nif not merged then h.seqs[i] = NF.nextSeq() end   -- (a move going on keeps its first number)\nlocal trimmed = false\nwhile #h.lines > h.max do\ntable.remove(h.lines, 1) table.remove(h.snaps, 1) table.remove(h.seqs, 1)\nh.base, trimmed = (h.base or 0) + 1, true\nend\nif trimmed then NF.histPush() else NF.histPush(#h.lines) end\nend\nNF.MAP_GUID = \"fdc270\"\nNF.SNAP_SEATS = {\"Blue\", \"Brown\", \"Green\", \"Orange\"}\nNF.SNAP_VALUES = {\"Strength\", \"Perception\", \"Dexterity\", \"Speech\", \"Universal\", \"Hunger\", \"Movement\"}\nNF.SNAP_ENEMY = {\"BanditTile\", \"CumanTile\", \"RaubritterTile\", \"SpecialEnemyTile\"}\nfunction NF.mapFrac(b, w)                        -- a world point -> {x, y} on the map picture, or nil off the map\nif not (b and w) then return nil end\nlocal l = b.positionToLocal({w.x or w[1], w.y or w[2] or 0, w.z or w[3]})\nlocal fx, fy = (1.815491 - l.x) / 3.630984, (l.z + 1.000974) / 2.001948\nif fx < -0.02 or fx > 1.02 or fy < -0.02 or fy > 1.02 then return nil end\nreturn {math.floor(fx * 10000 + 0.5) / 10000, math.floor(fy * 10000 + 0.5) / 10000}\nend\nfunction NF.histSnap(p, prev)\nlocal b = getObjectFromGUID(NF.MAP_GUID)\nlocal s = {f = {}, b = {}, e = {}, v = {}}\npcall(function()\nfor _, c in ipairs(NF.SNAP_SEATS) do\nlocal fig = getObjectsWithTag(\"PlayerFigure_\" .. c)[1]\nlocal at = fig and NF.mapFrac(b, fig.getPosition())\nif c == CFG.seat and p and p.toW then at = NF.mapFrac(b, p.toW) or at end   -- (walked: where it goes now)\nif at then s.f[c] = at end\nfor _, bed in ipairs(getObjectsWithTag(\"Bed_\" .. c)) do\nlocal q = NF.mapFrac(b, bed.getPosition())\nif q then s.b[#s.b + 1] = {c, q[1], q[2]} end\nend\nend\nfor _, o in ipairs(getObjectsWithAnyTags(NF.SNAP_ENEMY)) do\nlocal q = not o.is_face_down and NF.mapFrac(b, o.getPosition())\nif q then s.e[#s.e + 1] = q end\nend\nfor _, k in ipairs(NF.SNAP_VALUES) do\nlocal cube = getObjectsWithTag(k .. \"_\" .. CFG.seat)[1]\nlocal ok, v = pcall(function() return cube and cube.call(\"getValue\") end)\nif ok and type(v) == \"number\" then s.v[k] = v end\nend\nend)\nif p and p.kind == \"move\" then                 -- the way: where it started, then each space it reached\ns.path = (prev and prev.path) or {}\nif #s.path == 0 then\nlocal q = p.fromW and NF.mapFrac(b, p.fromW)\nif q then s.path[1] = q end\nend\nif s.f[CFG.seat] then s.path[#s.path + 1] = s.f[CFG.seat] end\nend\nreturn s\nend\nfunction NF.spaceAt(pos)                         -- the map space under a point (the setup controller knows them)\nlocal c = getObjectFromGUID(CFG.setupGuid or NF.SETUP_GUID)\nif not c then return nil end\nlocal ok, n = pcall(function() return c.call(\"map_space_at\", {x = pos.x, y = pos.y, z = pos.z}) or 0 end)\nif ok and type(n) == \"number\" and n > 0 then re