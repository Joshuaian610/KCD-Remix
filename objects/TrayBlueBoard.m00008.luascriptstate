1.png\"), q, d, d)\nend\nend                                          -- (not under an item card)\nend\nfor k, a in ipairs(pelts) do\nif k > NF.PELT_MAX then break end\nlocal name, v = a.name, a.value\nNF.INV.btns[\"nfInvAsell\" .. k], NF.INV.btns[\"nfInvAdisc\" .. k] = a.o.getGUID(), a.o.getGUID()\nNF.invBtn(\"nfInvAsell\" .. k, \"SELL\", NF.tileViewPoint(board, a.o, 0.48, 0.61),\n\"Sell this \" .. name .. \" for \" .. v .. \" Groschen (the tile goes into your trash)\", 300)\nNF.invBtn(\"nfInvAdisc\" .. k, \"DISCARD\", NF.tileViewPoint(board, a.o, 0.48, 0.77),\n\"Discard this \" .. name .. \" (into your trash, nothing gained)\", 300)\nnb = nb + 2\nend\nNF.decalsSet(\"invq_\", qdecals)\nNF.decalsSet(\"invi_\", NF.INV.idec or {})       -- (the tokens' round icons, NF.invIconPair)\nNF.INV.idec = {}\nNF.invSortEnsure(board)\nNF.INV.shown, NF.INV.nb = true, nb\nend\nNF.PELT = {stag = {\"Red Deer\", 18}, boar = {\"Wild Boar\", 14}, roe = {\"Roe Deer\", 9}, pheasant = {\"Pheasant\", 8},\nhare = {\"Hare\", 5}}\nNF.PELT_MAX = 8\nfunction NF.invPelts(board)                      -- the animal tiles lying in the inventory: {o, name, value}\nlocal out = {}\nfor _, o in ipairs(getObjectsWithTag(\"AnimalTile\")) do\nif not isHeld(o) and not o.isSmoothMoving() and NF.invInside(board, o.getPosition()) then\nfor kind, e in pairs(NF.PELT) do\nif o.hasTag(\"AnimalTile_\" .. kind) then out[#out + 1] = {o = o, name = e[1], value = e[2]} break end\nend\nend\nend\ntable.sort(out, function(a, b) return a.o.getGUID() < b.o.getGUID() end)\nreturn out\nend\nfunction NF.tileViewPoint(board, o, u, v)\nlocal c, b = o.getPosition(), o.getBoundsNormalized()\nlocal W, H = b.size.x, b.size.z\nif math.abs(((o.getRotation().y - board.getRotation().y) % 180) - 90) < 45 then W, H = b.size.z, b.size.x end\nlocal o0, ox, oz = board.positionToWorld({0, 0, 0}), board.positionToWorld({1, 0, 0}), board.positionToWorld({0, 0, 1})\nlocal rx, rz = {ox.x - o0.x, ox.z - o0.z}, {oz.x - o0.x, oz.z - o0.z}\nlocal lx 