nd's player, back up)\nif d.type == \"Deck\" then\nd.takeObject({position = pos, rotation = rot, smooth = true})\nelse                                            -- the last card\nd.setRotationSmooth(rot, false, true)\nd.setPositionSmooth(pos, false, true)\nend\ngot = got + 1\nWait.time(function() one(k + 1) end, 0.3)\nend\none(1)\nend, 1.0)\nend\nfunction NF.questDiscard(i, color)\nlocal s = NF.questSlots()[i]\nif not s then return end\nlocal cards = NF.slotCards(s)\nif #cards == 0 then NF.questButtons() return end\nlocal _, qd, yaw = NF.questSpots()\nlocal n = 0\nfor _, o in ipairs(cards) do\nn = n + NF.count(o)\no.setPositionSmooth({qd[1], 2.0 + 0.3 * n, qd[2]}, false, true)\no.setRotationSmooth({0, yaw, 180}, false, true)\nend\nNF.say(\"discarded \" .. (n > 1 and (n .. \" quests\") or \"a quest\") .. \" (face down)\")\nWait.time(NF.questButtons, 1.2)\nend\nfunction nfQuestsDraw(_, color) NF.questsDraw(color) end\n-- (user, 2026-11-06) \"quest cards on the quest module should get a Completed in addition to the Discard button; it will\n-- place them on the Completed slot of the Archive module (left most slot)\"\nNF.QUEST_BTN_DX, NF.QUEST_BTN_W = 1.35, 2.5      -- the two buttons side by side under the card\nfunction NF.questComplete(i, color)\nlocal s = NF.questSlots()[i]\nif not s then return end\nlocal cards = NF.slotCards(s)\nif #cards == 0 then NF.questButtons() return end\nlocal arch = NF.module(\"ARCHIVE\")\nlocal w = nil\nif arch then pcall(function() w = arch.call(\"anchorWorld\", {name = \"slot1\"}) end) end\nif not w then\nNF.tell(color, \"No Archive module on \" .. CFG.seat .. \"'s tray: add it in the tray's gear menu (Add module), then click Completed again.\")\nreturn\nend\nlocal ay = arch.getRotation().y\nlocal yaw = (ay + 180) % 360                     -- face up, readable from the seat (as the module's other cards)\nlocal base = 0\nfor _, o in ipairs(getObjects()) do                -- (already completed ones: the new ones go on top)\nif NF.isPile(o