nif p then return p end\nfor _, o in ipairs(getObjects()) do\nif o.type == \"Deck\" and o.getName() == \"Solo Deck (Henry)\" and not isHeld(o) then return o end\nend\nend\nfunction NF.henryDaySpots()\nlocal out = {}\nif CFG.name == \"HENRY\" then\nfor i = 1, 3 do\nlocal w, yaw = anchorWorld({name = \"day\" .. i}), anchorYaw({name = \"day\" .. i})\nif not (w and yaw) then out = {} break end\nout[i] = {w.x, w.z, yaw, y = w.y}\nend\nif #out == 3 then return out end\nend\nfor i, s in ipairs(NF.controllerTable(\"HENRY_DAY\") or NF.HENRY_DAY) do\nlocal x, z, yaw = NF.timeBoardShift(s)\nout[i] = {x, z, yaw}\nend\nreturn out\nend\nfunction NF.henryDeal(color)\nNF.serial(function()\nlocal todo = {}\nfor i, s in ipairs(NF.henryDaySpots()) do\nif not NF.pileAtWorld(s[1], s[2], 1.5) then todo[#todo + 1] = {i = i, x = s[1], z = s[2], yaw = s[3], y = s.y} end\nend\nif #todo == 0 then NF.tell(color, \"Henry's 3 day cards are already out.\") return end\nlocal dealt = 0\nlocal function one(k)\nif k > #todo then\nbroadcastToAll(\"[FFFFFF][HENRY][-] \" .. dealt .. \" day card\" .. (dealt == 1 and \"\" or \"s\") .. \" laid out face down\", {1, 1, 1})\nif dealt < #todo then NF.tell(color, \"Henry's action deck is empty (\" .. dealt .. \" of \" .. #todo .. \" dealt).\") end\nreturn\nend\nlocal d = NF.henryDeck()\nif not d then one(#todo + 1) return end\nlocal s = todo[k]\nlocal pos, rot = {s.x, NF.henryDrop(s.y), s.z}, {0, s.yaw, 180}\nif d.type == \"Deck\" then d.takeObject({position = pos, rotation = rot, smooth = true})\nelse d.setPositionSmooth(pos, false, true) d.setRotationSmooth(rot, false, true) end\ndealt = dealt + 1\nWait.time(function() one(k + 1) end, 0.3)\nend\none(1)\nend, 1.5)\nend\nfunction nfHenryDay(_, color) NF.henryDeal(color) end\nNF.HENRY_LIFT = 0                               -- (user, 2026-11-05: \"way too high\" at 1.0 - on the module like the others)\nNF.HENRY_CARD_Y = 1.9                           -- his cards appear this high over a well (they lie at 1.68), then drop\nfunction NF.henryDrop(y) return math.max(NF.HENRY_CARD_Y, (y or 0) + 0.12) end\nfunction NF.henrySpot(name)                     -- a HENRY well in the world: {x, y, z, yaw}, or nil\nlocal w = anchorWorld({name = name})\nif not w then return nil end\nreturn {x = w.x, y = w.y, z = w.z, yaw = anchorYaw({name = name}) or NF.cardYaw()}\nend\nfunction NF.henryToDiscard(og, pg, dis, top)\nlocal old = getObjectFromGUID(og)\nif not old then return end\nlocal pile = pg and getObjectFromGUID(pg) or nil\nlocal done = false\nif pile then\ndone = pcall(function()\nlocal cd, data = old.getData(), pile.getData()\nif type(cd) ~= \"table\" or type(data) ~= \"table\" or cd.CardID == nil or data.Transform == nil then error(\"no card data\") end\ncd.Locked = false\nif data.Name ~= \"Deck\" and data.Name ~= \"DeckCustom\" then\nif data.CardID == nil then error(\"not a card\") end\ndata = {Name = \"Deck\", Transform = data.Transform, Nickname = \"\", Description = \"\", Locked = false,\nDeckIDs = {data.CardID}, CustomDeck = data.CustomDeck or {}, ContainedObjects = {data}}\nend\ndata.ContainedObjects, data.DeckIDs, data.CustomDeck = data.ContainedObjects or {}, data.DeckIDs or {}, data.CustomDeck or {}\nlocal z = (data.Transform.rotZ or 0) % 360\nlocal at = (z > 90 and z < 270) and 1 or (#data.ContainedObjects + 1)\ntable.insert(data.ContainedObjects, at, cd)\ntable.insert(data.DeckIDs, at, cd.CardID)\nfor k, v in pairs(cd.CustomDeck or {}) do data.CustomDeck[k] = v end\ndestroyObject(old)\ndestroyObject(pile)\nspawnObjectData({data = data})\nend)\nend\nif not done then                               -- (no pile there, or no card data: put down / dropped from above)\nold.setLock(false)\nold.setPositionSmooth({dis.x, NF.henryDrop(pile and top or dis.y) + (pile and 0.3 or 0), dis.z}, false, true)\nend\nend\nfunction NF.henryNext(color)\nNF.serial(function()\nlocal cur, dis = NF.henrySpot(\"current\"), NF.henrySpot(\"discard\")\nif not (cur and dis) then return end\nlocal nxt = nil\n