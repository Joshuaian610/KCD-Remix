function doRefreshTiles(buttonObj, _, _)
  -- wrapper to run refreshTiles via button
  local bag = buttonObj.getName():find("Herbs") and getObjectbyName("Herb Tiles") or getObjectbyName("Animal Tiles")
  refreshTiles(_, _, bag)
end


function refreshTiles(_, _, obj)
  -- handles check of all tile slots on main board of type (herb or animal)
  -- any empty slots will be refilled

  local tileType = obj.getName() == "Herb Tiles" and "Herb" or "Animal"
  local posMapTiles = posMapBoardTiles[tileType]
  local rotFaceup = { 0.00, 180.00, 0.00 }
  local tolerance = 0.50

  for _, pos in ipairs(posMapTiles) do
    local tileFound = false

    for _, boardObj in ipairs(getObjects()) do
      local posObj = boardObj.getPosition()

      if boardObj.type == "Generic" and
        math.abs(posObj.x - pos[1]) <= tolerance and
        math.abs(posObj.z - pos[3]) <= tolerance then
        tileFound = true
        break
      end
    end

    if not tileFound then
      local tile = obj.takeObject()
      placeObject(tile, rotFaceup, pos, true, false)
    end
  end
end


function doRefreshCards(_, _, _)
  -- wrapper to handle button click to refresh shop
  refreshAdvancedCards(getObjectbyName("Card Stand"))
end


function refreshAdvancedCards(_, _, obj)
  -- handles check of face up advanced card slots, refreshes any empty

  local rotFaceup = { 0.00, 180.00, 0.00 }

  for _, pos in pairs(posCardStand) do
    local posTopCard = pos["TopCard"]
    local posBottomCard = pos["BottomCard"]

    local cardTop = getObjectbyXandZ("Card", posTopCard[1], posTopCard[3])
    local cardBottom = getObjectbyXandZ("Card", posBottomCard[1], posBottomCard[3])
    local dealDeck = getObjectbyXandZ("Deck", posTopCard[1], posTopCard[3])

    if not dealDeck then return end

    if not cardTop then
      local card = dealDeck.takeObject()
      placeObject(card, rotFaceup, posTopCard, true, false)
    end

    if not cardBottom then
      local card = dealDeck.takeObject()
      placeObject(card, rotFaceup, posBottomCard, true, false)
    end
  end
end


function doRefreshShop(_, _, _)
  -- wrapper to handle button click to refresh shop
  refreshShop(getObjectbyName("Shop Board"))
end


function refreshShop(_, _, obj)
  -- handles check of all shop slots, refreshes any empty

  local rotFaceup = { 0.00, 180.00, 0.00 }

  for shopType, shop in pairs(posShop) do
    if shopType == "Clothing" or shopType == "Armor" or shopType == "Weapon" or shopType == "Bow" or shopType == "Market" then
      local posDeck = shop["Deck"]
      local posSlots = shop["Slots"]
      local dealDeck = getObjectbyXandZ("Deck", posDeck[1], posDeck[3])

      if not dealDeck then return end

      for _, pos in ipairs(posSlots) do
        local card = getObjectbyXandZ("Card", pos[1], pos[3])

        if card == nil then
          card = dealDeck.takeObject()
          placeObject(card, rotFaceup, pos, true, false)
        end
      end
    end
  end

  -- handles check of empty Horse slots, refreshes any empty
  local posHorseDeck = posShop["Horse"]["Deck"]
  local posHorseSlots = posShop["Horse"]["Slots"]

  for _, pos in ipairs(posHorseSlots) do
    local card = getObjectbyXandZ("Card", pos[1], pos[3])
    local dealDeck = getObjectbyXandZ("Deck", posHorseDeck[1], posHorseDeck[3])

    if not dealDeck then return end

    if not card then
      local card = dealDeck.takeObject()
      placeObject(card, rotFaceup, pos, true, false)
    end
  end
end


function refreshLine(_, _, obj)
  -- handles the refresh of either the shop row, or, advanced card column

  local playerColor = obj.getGMNotes()
  local posToken = obj.getPosition()
  local tolerance = 0.50

  local refreshType
  local refreshName

  for shopType, shop in pairs(posShop) do
    if shop["Refresh"] and
      math.abs(posToken.x - shop["Refresh"][1]) <= tolerance and
      math.abs(posToken.z - shop["Refresh"][3]) <= tolerance then
      refreshType = "Shop"
      refreshName = shopType
      break
    end
  end

  if not refreshType then
    for cardStandType, cardStand in pairs(posCardStand) do
      if math.abs(posToken.x - cardStand["Refresh"][1]) <= tolerance and
        math.abs(posToken.z - cardStand["Refresh"][3]) <= tolerance then
        refreshType = "Advanced"
        refreshName = cardStandType
        break
      end
    end
  end

  if not refreshType then return end

  local foundCards = {}

  if refreshType == "Shop" then
    local shop = posShop[refreshName]

    if refreshName == "Market" then
      for i = 1, 4 do
        local pos = shop["Slots"][i]
        local foundCard = getObjectbyXandZ("Card", pos[1], pos[3])

        if foundCard then
          foundCards[#foundCards + 1] = foundCard
        end
      end
    elseif refreshName == "Bow" then
      for _, pos in ipairs(shop["Slots"]) do
        local foundCard = getObjectbyXandZ("Card", pos[1], pos[3])

        if foundCard then
          foundCards[#foundCards + 1] = foundCard
        end
      end

      for i = 5, 6 do
        local pos = posShop["Market"]["Slots"][i]
        local foundCard = getObjectbyXandZ("Card", pos[1], pos[3])

        if foundCard then
          foundCards[#foundCards + 1] = foundCard
        end
      end
    else
      for _, pos in ipairs(shop["Slots"]) do
        local foundCard = getObjectbyXandZ("Card", pos[1], pos[3])

        if foundCard then
          foundCards[#foundCards + 1] = foundCard
        end
      end
    end
  else
    local cardStand = posCardStand[refreshName]
    local posTopCard = cardStand["TopCard"]
    local posBottomCard = cardStand["BottomCard"]

    local foundCardTop = getObjectbyXandZ("Card", posTopCard[1], posTopCard[3])
    local foundCardBottom = getObjectbyXandZ("Card", posBottomCard[1], posBottomCard[3])

    if foundCardTop then
      foundCards[#foundCards + 1] = foundCardTop
    end

    if foundCardBottom then
      foundCards[#foundCards + 1] = foundCardBottom
    end
  end

  for _, foundCard in ipairs(foundCards) do
    returnToDeck(playerColor, _, foundCard)
  end

  Wait.time(function()

    if refreshType == "Advanced" then
      refreshAdvancedCards(playerColor, _, getObjectbyName("Card Stand"))
    else
      refreshShop(_, _, getObjectbyName("Shop Board"))
    end

  end, 1)

  local rotFaceup = { 0.00, 1800.00, 0.00 }
  placeObject(obj, rotFaceup, posPlayerRefreshReturn[playerColor], true, false)

  local playerStr = getPlayerStr(playerColor)
  local refreshNames = {
    ["Horse"]      = "Horse Row",
    ["Market"]     = "Market Rows",
    ["Armor"]      = "Armor Row",
    ["Weapon"]     = "Weapon Row",
    ["Bow"]        = "Bow Row",
    ["Clothing"]   = "Clothing Row",
    ["Strength"]   = "Strength Column",
    ["Perception"] = "Perception Column",
    ["Dexterity"]  = "Dexterity Column",
    ["Speech"]     = "Speech Column",
  }
  local broadcastStr = string.format("%s has refreshed the %s.", getPlayerStr(playerColor), refreshNames[refreshName])
  broadcastToAll(broadcastStr, "White")
end


function doShuffleSetup(buttonObj, _, _)
  shuffleSetup(_, _, buttonObj)
  getObjectbyName("Map Board").clearContextMenu()
  getObjectbyName("Map Board").addTag("GameShuffled")
end


function shuffleSetup(_, _, obj)
  -- handles shuffle of all relevant game decks

  -- ensure shuffle only ever happens once
  if obj.hasTag("GameShuffled") then return end
  obj.clearContextMenu()
  obj.addTag("GameShuffled")

  local shuffleList = {
    getObjectbyName("Item Clothing Cards"),
    getObjectbyName("Item Weapon Cards"),
    getObjectbyName("Item Armor Cards"),
    getObjectbyName("Item Bow Cards"),
    getObjectbyName("Item Market Cards"),
    getObjectbyName("Horse Tiles"),
    getObjectbyName("Potion Recipes White"),
    getObjectbyName("Potion Recipes Orange"),
    getObjectbyName("Potion Recipes Yellow"),
    getObjectbyName("Potion Recipes Red"),
    getObjectbyName("Potion Recipes Blue"),
    getObjectbyName("Herb Tiles"),
    getObjectbyName("Animal Tiles"),
    getObjectbyName("Bandit Tiles"),
    getObjectbyName("Raubritter Tiles"),
    getObjectbyName("Cuman Tiles"),
    getObjectbyName("Good Cards"),
    getObjectbyName("Bad Cards"),
    getObjectbyName("Road Encounters"),
    getObjectbyName("Town Encounters"),
    getObjectbyName("Wound Tokens"),
    getObjectbyName("Inn Quests"),
    getObjectbyName("Starting Quests"),
    getObjectbyName("Character Cards"),
    getObjectbyName("Advanced Deck Strength"),
    getObjectbyName("Advanced Deck Perception"),
    getObjectbyName("Advanced Deck Dexterity"),
    getObjectbyName("Advanced Deck Speech"),
    getObjectbyName("Spawn Cards S"),
    getObjectbyName("Spawn Cards 1-2"),
    getObjectbyName("Spawn Cards 3-4"),
  }

  for i = 1, #shuffleList do
    if shuffleList[i] ~= nil then
      shuffleList[i].shuffle()
    end
  end

  -- flip potion decks after shuffle
  local rotFaceup = { 0.00, 180.00, 0.00 }
  for i = 7, 11 do
    if shuffleList[i] ~= nil then
      shuffleList[i].setRotationSmooth(rotFaceup, false, true)
    end
  end

  -- refresh shop
  refreshShop(_, _, getObjectbyName("Shop Board"))

  -- deal 1 of each type of adv card to each seated player
  local seatedPlayers = getSeatedPlayers()
  for _, player in pairs(seatedPlayers) do
    for i = 25, 28 do
      if shuffleList[i] ~= nil then
        shuffleList[i].deal(1, player)
      end
    end

    -- deal 2 char cards, 2 start quests
    local charDeck = getObjectbyName("Character Cards")
    local questDeck = getObjectbyName("Starting Quests")
    charDeck.deal(2, player)
    questDeck.deal(2, player)
  end

  -- then, refresh card stand
  Wait.time(function() refreshAdvancedCards(_, _, obj) end, 0.50)

  -- populate animals/herbs
  refreshTiles(_, _, getObjectbyName("Herb Tiles"))
  refreshTiles(_, _, getObjectbyName("Animal Tiles"))

  -- destruct setup button if it exists
  if getObjectbyName("Button Setup Game") ~= nil then
    getObjectbyName("Button Setup Game").destruct()
  end

  -- place trough lids if required
  if #seatedPlayers < 3 then
    for i = 2, 3 do
      for _, object in pairs(getObjects()) do
        if object.getName() == "Trough Lid" and not object.hasTag("troughLidPlaced") then
          object.addTag("troughLidPlaced")
          placeObject(object, rotFaceup, posMapBoardTiles["Trough"][i], false, true)
          break
        end
      end
    end
  end

  if #seatedPlayers < 4 then
    for _, object in pairs(getObjects()) do
      if object.getName() == "Trough Lid" and not object.hasTag("troughLidPlaced") then
        object.addTag("troughLidPlaced")
        placeObject(object, rotFaceup, posMapBoardTiles["Trough"][1], false, true)
        break
      end
    end
  end
end