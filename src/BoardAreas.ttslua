function initButtonSetupGame(buttonObj)
  buttonObj.clearButtons()

  buttonObj.createButton({
    click_function = "doShuffleSetup",
    function_owner = self,
    label          = "",
    position       = { 0.00, 1.01, 0.00 },
    rotation       = { 0.00, 180.00, 0.00 },
    width          = 995,
    height         = 265,
    color          = { 1, 1, 1, 0 },
    hover_color    = { 1, 1, 1, 0.4 },
    scale          = { 4, 4, 4 },
    tooltip        = "Ensure everybody is seated at a color, then, click this button to perform all generic Game Setup.\n\nAfterwards, the Story content can be found in their memory boxes by clicking Place. Memory Boxes and Opportunities deck are located on right side of table.\n\nYou may return undesired Advanced Skills, Quest, and Character Card via right click context menu.",
  })
end


