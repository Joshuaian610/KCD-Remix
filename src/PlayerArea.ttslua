

function initButtonReshuffleDeck(buttonObj)

  buttonObj.clearButtons()

  buttonObj.createButton({
    click_function = "reshuffleDeck",
    function_owner = self,
    label          = "",
    position       = { 0.00, 0.41, 0.00 },
    rotation       = { 0.00, 180.00, 0.00 },
    width          = 995,
    height         = 265,
    color          = { 1, 1, 1, 0 },
    hover_color    = { 1, 1, 1, 0.4 },
    scale          = { 4, 4, 4 },
    tooltip        = "Click this button to reshuffle your Discard into your Deck.",
  })

end


