function reshuffleDeck(buttonObj, _, _)
  -- this function handles the action of finding a playerColor's discard, then, shuffling it into a new or current Player Deck

  local playerColor = buttonObj.getGMNotes()
  local playerStr = getPlayerStr(playerColor)
  local playerStrWhite = getPlayerStr(playerColor, false)

  local posDiscard = posPlayerDiscard[playerColor]
  local posDeck = posPlayerDeck[playerColor]

  local rotFacedown = { 0.00, 180.00, 180.00 }

  -- detect current discard card or deck, return out if none found
  local currentDiscard = getObjectbyXandZ("Deck", posDiscard[1], posDiscard[3])
  if currentDiscard == nil then
    currentDiscard = getObjectbyXandZ("Card", posDiscard[1], posDiscard[3])
  end
  if currentDiscard == nil then
    local errorStr = string.format("%s: No Discard found to Reshuffle!", playerStr)
    broadcastToAll(errorStr, "Red")
    return
  end

  -- rotate facedown, place discard to deck pad
  currentDiscard.setRotation(rotFacedown)
  currentDiscard.setPositionSmooth(posDeck)

  -- wait 1 second, then, check for deck in deck pad location. if deck found, shuffle & rename
  Wait.time(function()

    local currentDeck = getObjectbyXandZ("Deck", posDeck[1], posDeck[3])
    if currentDeck ~= nil then
      currentDeck.shuffle()
      currentDeck.setName(playerStrWhite .. "'s Deck")
    end

  end, 2)
end


function drawTestCard(buttonObj, _, _)
  -- this function handles the action of drawing a test card to the lowest available slot on the test pad
  -- drawn cards currently need to be locked due to snap point spacing

  local playerColor = buttonObj.getGMNotes()
  local playerStr = getPlayerStr(playerColor)
  local posTestCards = posPlayerTestCards[playerColor]

  -- first need to detect next available slot after bottom card
  local nextAvailableSlot = 1
  local tolerance = 0.50

  for i, pos in ipairs(posTestCards) do
    for _, obj in ipairs(getObjects()) do
      local objPos = obj.getPosition()

      if obj.type == "Card" and
         math.abs(objPos.x - pos[1]) <= tolerance and
         math.abs(objPos.z - pos[3]) <= tolerance then
        nextAvailableSlot = i + 1
        break
      end
    end
  end

  -- check if test pad is full, return out if so
  if nextAvailableSlot > #posTestCards then
    local errorStr = string.format("%s: Unable to automatically Draw Test Card, please draw manually.", playerStr)
    broadcastToAll(errorStr, "Orange")
    return
  end

  -- determine next placement position
  local rotFaceup = { 0.00, 180.00, 0.00 }
  local posNextAvailable = posTestCards[nextAvailableSlot]

  -- find deck or card, get card to deal
  local dealCard = nil
  local posDeck = posPlayerDeck[playerColor]
  local deckReformed = false

  local currentDeck = getObjectbyXandZ("Deck", posDeck[1], posDeck[3])

  -- handle deck draw
  if currentDeck ~= nil then
    dealCard = currentDeck.takeObject()

  -- handle single card
  elseif currentDeck == nil then
    dealCard = getObjectbyXandZ("Card", posDeck[1], posDeck[3])
  end

  -- if dealCard not found, reshuffle deck, wait 2.5 seconds (2 to reform & shuffle), find reshuffled deck or card, move on
  if dealCard == nil then
    local reshuffleButtonObj = getObjectbyNameAndNotes("Button Reshuffle Deck", playerColor)
    reshuffleDeck(reshuffleButtonObj)
    deckReformed = true

    Wait.time(function()

      currentDeck = getObjectbyXandZ("Deck", posDeck[1], posDeck[3])

      -- handle reformed deck draw
      if currentDeck ~= nil then
        dealCard = currentDeck.takeObject()

      -- handle reformed single card (lol maybe?)
      elseif currentDeck == nil then
        dealCard = getObjectbyXandZ("Card", posDeck[1], posDeck[3])
      end

      -- if still no deal card, error out
      if dealCard == nil then
        local errorStr = string.format("%s: Unable to automatically Draw Test Card, please draw manually.", playerStr)
        return
      end

      -- do followup stuff, as seen below, if not deckReformed
      placeObject(dealCard, rotFaceup, posNextAvailable, false, true)
      dealCard.setGMNotes(playerColor)
      dealCard.addContextMenuItem("Discard " .. dealCard.getName(), discardTestCard)
      local broadcastStr = string.format("%s has drawn Test Card: %s", playerStr, dealCard.getName())
      broadcastToAll(broadcastStr, "White")

    end, 2.5)
  end

  if not deckReformed then
    -- deal the card to position (not smoothly, locked)
    placeObject(dealCard, rotFaceup, posNextAvailable, false, true)

    -- add discard context menu option, set card GMNotes to playerColor
    dealCard.setGMNotes(playerColor)
    dealCard.addContextMenuItem("Discard " .. dealCard.getName(), discardTestCard)

    -- broadcast
    local broadcastStr = string.format("%s has drawn Test Card: %s", playerStr, dealCard.getName())
    broadcastToAll(broadcastStr, "White")
  end
end


function discardTestCard(_, _, cardObj)
  -- handles the removal of a card from an ongoing test

  local playerColor = cardObj.getGMNotes()
  local playerStr = getPlayerStr(playerColor)

  local rotFaceup = { 0.00, 180.00, 0.00 }
  local posDiscard = posPlayerDiscard[playerColor]
  placeObject(cardObj, rotFaceup, posDiscard, true, false)

  -- broadcast
  local broadcastStr = string.format("%s has discarded Test Card: %s", playerStr, cardObj.getName())
  broadcastToAll(broadcastStr, "White")
end


function cleanupTest(buttonObj, _, _)
  -- handles cleanup of test initiation and test cards to discard

  local playerColor = buttonObj.getGMNotes()
  local playerStr = getPlayerStr(playerColor)
  local tolerance = 0.50
  local rotFaceup = { 0.00, 180.00, 0.00 }
  local posDiscard = posPlayerDiscard[playerColor]
  local posTestCards = posPlayerTestCards[playerColor]
  local posInitiateCard = posPlayerInitiateTest[playerColor]
  posInitiateCard[3] = -42.30

  -- iterate through potential test card slots, discard any found
  for _, pos in ipairs(posTestCards) do
    local foundCard = getObjectbyXandZ("Card", pos[1], pos[3])

    if foundCard then
      placeObject(foundCard, rotFaceup, posDiscard, true, false)
    end
  end

  -- check for found player initiate test card, discard
  local foundCard = getObjectbyXandZ("Card", posInitiateCard[1], posInitiateCard[3])

  if foundCard then
    placeObject(foundCard, rotFaceup, posDiscard, true, false)
  end

  local broadcastStr = string.format("%s has completed their Test.", playerStr)
  broadcastToAll(broadcastStr, "White")
end


function initiateTestAction(cardObj, playerColor)
  -- handles the action of sliding test card under player board, and, broadcast

  local rotInitiateCard = cardObj.getRotation()
  local posInitiateCard = cardObj.getPosition()
  posInitiateCard.z = -42.30
  placeObject(cardObj, rotInitiateCard, posInitiateCard, true, false)

  local playerStr = getPlayerStr(playerColor)
  local broadcastStr = string.format("%s has Initiated a Test with: %s", playerStr, cardObj.getName())
  broadcastToAll(broadcastStr, "White")
end


function counterPlus5(buttonObj, _, _)
  -- handle action of gaining 5 groschen to counter

  local playerColor = buttonObj.getGMNotes()
  local playerStr = getPlayerStr(playerColor)
  local counterObj = getObjectbyNameAndNotes("Groschen Counter", playerColor)

  local oldVal = counterObj.getVar("val")
  local newVal = oldVal + 5

  counterObj.call("setValue", newVal)

  local broadcastStr = string.format("%s has Gained 5 Groschen (%d > %d)", playerStr, oldVal, newVal)
  broadcastToAll(broadcastStr, "White")
end


