function counterMinus5(buttonObj, _, _)
  -- handle action of removing 5 groschen from counter

  local playerColor = buttonObj.getGMNotes()
  local playerStr = getPlayerStr(playerColor)
  local counterObj = getObjectbyNameAndNotes("Groschen Counter", playerColor)

  local oldVal = counterObj.getVar("val")
  local newVal = oldVal - 5
  if newVal < 1 then newVal = 0 end

  counterObj.call("setValue", newVal)

  local broadcastStr = string.format("%s has Spent or Lost 5 Groschen (%d > %d)", playerStr, oldVal, newVal)
  broadcastToAll(broadcastStr, "White")

end


