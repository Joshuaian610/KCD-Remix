function returnToDeck(playerColor, _, obj)
  -- handles return of a cardObj object to bottom of it's deck

  local cardName = obj.getName()
  local playerStr = getPlayerStr(playerColor)

  -- get return deck or position
  local returnDeck, posReturn
  if obj.hasTag("ItemArmor") then
    posReturn = { -66.30, 1.80, 0.86 }

  elseif obj.hasTag("ItemBow") then
    posReturn = { -66.30, 1.67, 7.13 }

  elseif obj.hasTag("ItemMarket") then
    posReturn = { -66.30, 1.90, 13.53 }

  elseif obj.hasTag("ItemClothing") then
    posReturn = { -66.29, 1.80, -11.90 }

  elseif obj.hasTag("ItemWeapon") then
    posReturn = { -66.30, 1.75, -5.41 }

  elseif obj.hasTag("RoadEncounter") then
    posReturn = { -26.00, 0.77, 29.63 }

  elseif obj.hasTag("TownEncounter") then
    posReturn = { -18.00, 0.77, 29.63 }

  elseif obj.hasTag("InnQuest") then
    posReturn = { 53.25, 1.00, -15.77 }

  elseif obj.hasTag("StartQuest") then
    posReturn = { 58.75, 0.84, -15.77 }

  elseif obj.hasTag("GoodCard") then
    posReturn = { 36.75, 0.88, -15.77 }

  elseif obj.hasTag("BadCard") then
    posReturn = { 42.25, 0.84, -15.77 }

  elseif obj.hasTag("AdvancedSkill_Red") then
    posReturn = { 39.05, 1.69, 4.06 }

  elseif obj.hasTag("AdvancedSkill_Green") then
    posReturn = { 44.95, 1.69, 4.06 }

  elseif obj.hasTag("AdvancedSkill_Brown") then
    posReturn = { 50.85, 1.69, 4.05 }

  elseif obj.hasTag("AdvancedSkill_Blue") then
    posReturn = { 56.75, 1.69, 4.05 }
  
  elseif obj.hasTag("SpecialItem") then
    posReturn = { -40.42, 1.66, -12.84 }
  end

  returnDeck = getObjectbyXandZ("Deck", posReturn[1], posReturn[3])
  if returnDeck == nil then
    turnDeck = getObjectbyXandZ("Card", posReturn[1], posReturn[3])
  end

  if returnDeck ~= nil then
    posReturn[2] = -1.00
    local rotReturn = returnDeck.getRotation()
    obj.setRotation(rotReturn)
    obj.setPosition(posReturn)
    returnDeck.putObject(obj)

  elseif returnDeck == nil then
    local rotFacedown = { 0.00, 180.00, 180.00 }
    obj.setRotation(rotFacedown)
    obj.setPositionSmooth(posReturn)
  end

  local broadcastStr = string.format("%s has Returned Card: %s", playerStr, cardName)
  broadcastToAll(broadcastStr, "White")
end


function removeItem(playerColor, _, obj)
  -- very simply destructs a small inventory or -3 shield object

  local objName = obj.getName()
  local playerStr = getPlayerStr(playerColor)

  obj.destruct()

  local broadcastStr = string.format("%s has Removed: %s", playerStr, objName)
  broadcastToAll(broadcastStr, "White")
end


function retireCard(playerColor, _, obj)
  -- handles action of retiring a card

  local playerStr = getPlayerStr(playerColor)
  local cardName = obj.getName()
  local bag = getObjectbyNameAndNotes("Log", playerColor)

  if obj ~= nil and bag ~= nil then
    local pos = bag.getPosition()
    pos.y = 2.78
    obj.setPosition(pos)

    local broadcastStr = string.format("%s has Retired: %s", playerStr, cardName)
    broadcastToAll(broadcastStr, "White")
  end
end


function completeQuest(playerColor, _, obj)
  -- handles action of completing a quest

  local playerStr = getPlayerStr(playerColor)
  local cardName = obj.getName()
  local bag = getObjectbyNameAndNotes("Log", playerColor)

  if obj ~= nil and bag ~= nil then
    local pos = bag.getPosition()
    pos.y = 2.78
    obj.setPosition(pos)

    local broadcastStr = string.format("%s has Completed Quest: %s", playerStr, cardName)
    broadcastToAll(broadcastStr, "White")
  end
end


function returnTile(playerColor, _, obj)
  -- handles action of returning herb or animal tile

  local playerStr = getPlayerStr(playerColor)
  local tileName = obj.getName()
  local bag = nil

  if obj.hasTag("HerbTile") then
    bag = getObjectbyName("Herb Tiles")
  elseif obj.hasTag("AnimalTile") then
    bag = getObjectbyName("Animal Tiles")
  elseif obj.hasTag("WoundToken") then
    bag = getObjectbyName("Wound Tokens")
  elseif obj.getName() == "Bandit" then
    bag = getObjectbyName("Bandit Tiles")
  elseif obj.getName() == "Raubritter" then
    bag = getObjectbyName("Raubritter Tiles")
  elseif obj.getName() == "Cuman" then
    bag = getObjectbyName("Cuman Tiles")
  end

  local pos = bag.getPosition()
  pos.y = 2.78
  obj.setPosition(pos)
  bag.putObject(obj)

  local broadcastStr = string.format("%s has Returned: %s", playerStr, tileName)
  broadcastToAll(broadcastStr, "White")
end